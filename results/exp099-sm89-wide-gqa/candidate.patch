+// On sm89 the measured Apex prefill uses the wide <256, 256, ncols1=8, ncols2=8>
+// dispatch. The alternative existing instantiation <256, 256, ncols1=16, ncols2=4>
+// keeps the same 64-column tile and the same per-query K/V traffic, but maps 16
+// queries per K/V pass instead of 8. This is a bounded dispatch candidate for
+// prefill on Ada only; every other shape, device and mode keeps the old rule.
+// Disable with GGML_CUDA_FA_SM89_WIDE_GQA=0.
+static bool ggml_cuda_fattn_mma_sm89_wide_gqa(const int cc, const ggml_tensor * dst,
+        const int DKQ, const int DV, const bool use_gqa_opt, const int gqa_ratio) {
+    static const bool enabled = []() {
+        const char * flag = std::getenv("GGML_CUDA_FA_SM89_WIDE_GQA");
+        return !(flag != nullptr && std::strcmp(flag, "0") == 0);
+    }();
+
+    if (!enabled || cc != GGML_CUDA_CC_ADA_LOVELACE) {
+        return false;
+    }
+    if (DKQ != 256 || DV != 256) {
+        return false;
+    }
+    if (!use_gqa_opt || gqa_ratio <= 4 || gqa_ratio % 4 != 0) {
+        return false;
+    }
+
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+
+    if (Q == nullptr || K == nullptr || V == nullptr) {
+        return false;
+    }
+    // the measured profile uses quantized K/V (Q4_0); leave the f16 path alone
+    if (!ggml_is_quantized(K->type) || !ggml_is_quantized(V->type)) {
+        return false;
+    }
+    // prefill only: the narrow and single-query dispatches are unchanged
+    if (Q->ne[1] <= 32/8) {
+        return false;
+    }
+
+    return true;
+}
