diff -Naur a/common/checkpoint-buffer.h b/common/checkpoint-buffer.h
--- a/common/checkpoint-buffer.h	1970-01-01 03:00:00.000000000 +0300
+++ b/common/checkpoint-buffer.h	2026-10-30 22:08:22.231278603 +0300
@@ -0,0 +1,259 @@
+#pragma once
+
+// Host memory used to hold a serialized prompt or checkpoint state.
+//
+// The bytes are handed to llama_state_seq_set_data_ext()/get_data_ext(), which
+// copy them between host memory and the model tensors. Allocating this storage
+// from a device host buffer type (when one is available) lets the backend use
+// pinned memory for those copies without adding a second copy of the state and
+// without introducing a CUDA dependency into the common code.
+//
+// The wrapper owns exactly one allocation. If no suitable host buffer type is
+// registered, or if the allocation fails, it falls back to an ordinary
+// std::vector<uint8_t> with the same logical size. size() is always the number
+// of serialized bytes, so every existing boundary, length prefix and budget
+// calculation keeps its meaning. capacity() is the size of the actual
+// allocation and is used only for memory accounting.
+//
+// The type is copyable because prompt checkpoints are copied into the RAM prompt
+// cache today; a copy performs a deep copy of the logical bytes.
+
+#include "ggml-backend.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+#include <vector>
+
+class common_checkpoint_buffer {
+public:
+    common_checkpoint_buffer() = default;
+
+    ~common_checkpoint_buffer() {
+        release();
+    }
+
+    common_checkpoint_buffer(const common_checkpoint_buffer & other) {
+        copy_from(other);
+    }
+
+    common_checkpoint_buffer & operator=(const common_checkpoint_buffer & other) {
+        if (this != &other) {
+            release();
+            copy_from(other);
+        }
+        return *this;
+    }
+
+    common_checkpoint_buffer(common_checkpoint_buffer && other) noexcept {
+        *this = std::move(other);
+    }
+
+    common_checkpoint_buffer & operator=(common_checkpoint_buffer && other) noexcept {
+        if (this == &other) {
+            return *this;
+        }
+
+        release();
+
+        buffer        = other.buffer;
+        data_vector   = std::move(other.data_vector);
+        data_ptr      = other.data_ptr;
+        size_bytes    = other.size_bytes;
+        data_capacity = other.data_capacity;
+        pinned        = other.pinned;
+
+        other.buffer        = nullptr;
+        other.data_ptr      = nullptr;
+        other.size_bytes    = 0;
+        other.data_capacity = 0;
+        other.pinned        = false;
+
+        return *this;
+    }
+
+    // Allocate storage for exactly `size` serialized bytes. Throws std::bad_alloc
+    // only on the ordinary-vector fallback, matching the previous behavior.
+    void resize(size_t size) {
+        if (size == 0) {
+            release();
+            return;
+        }
+
+        // allocate before releasing the previous contents so that a failed
+        // allocation leaves the buffer unchanged, like std::vector::resize()
+        ggml_backend_buffer_t new_buffer   = nullptr;
+        uint8_t *             new_ptr      = nullptr;
+        size_t                new_capacity = 0;
+
+        if (ggml_backend_buffer_type_t buft = pinned_host_buffer_type()) {
+            const size_t alignment = alignment_of(buft);
+            const size_t capacity  = align_up(size, alignment);
+
+            if (capacity >= size && capacity <= ggml_backend_buft_get_max_size(buft)) {
+                ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, capacity);
+                if (buf != nullptr) {
+                    void * base = ggml_backend_buffer_get_base(buf);
+                    // never hold more than capacity_for() predicted: the budget
+                    // was checked against that value before this allocation
+                    const size_t buffer_size = ggml_backend_buffer_get_size(buf);
+                    if (base != nullptr && buffer_size <= capacity) {
+                        new_buffer   = buf;
+                        new_ptr      = static_cast<uint8_t *>(base);
+                        new_capacity = buffer_size;
+                    } else {
+                        ggml_backend_buffer_free(buf);
+                    }
+                }
+            }
+        }
+
+        if (new_buffer == nullptr) {
+            std::vector<uint8_t> new_vector(size); // may throw, old contents kept
+            release();
+            data_vector   = std::move(new_vector);
+            data_ptr      = data_vector.data();
+            size_bytes    = size;
+            data_capacity = size;
+            pinned        = false;
+            return;
+        }
+
+        release();
+        buffer        = new_buffer;
+        data_ptr      = new_ptr;
+        size_bytes    = size;
+        data_capacity = new_capacity;
+        pinned        = true;
+    }
+
+    // Allocation size that resize() is expected to use for `size` bytes. Used
+    // before allocating so that memory budgets are checked against the real
+    // allocation size. If the pinned allocation later fails and resize() falls
+    // back to a vector, the actual capacity is smaller, never larger.
+    static size_t capacity_for(size_t size) {
+        if (size == 0) {
+            return 0;
+        }
+
+        if (ggml_backend_buffer_type_t buft = pinned_host_buffer_type()) {
+            const size_t alignment = alignment_of(buft);
+            const size_t capacity  = align_up(size, alignment);
+            if (capacity >= size && capacity <= ggml_backend_buft_get_max_size(buft)) {
+                return capacity;
+            }
+        }
+
+        return size;
+    }
+
+    void release() {
+        if (buffer != nullptr) {
+            ggml_backend_buffer_free(buffer);
+            buffer = nullptr;
+        } else if (!data_vector.empty()) {
+            std::vector<uint8_t>().swap(data_vector);
+        }
+
+        data_ptr      = nullptr;
+        size_bytes    = 0;
+        data_capacity = 0;
+        pinned        = false;
+    }
+
+    uint8_t *       data()       { return data_ptr; }
+    const uint8_t * data() const { return data_ptr; }
+
+    // number of serialized bytes
+    size_t size() const { return size_bytes; }
+
+    // number of bytes actually allocated
+    size_t capacity() const { return data_capacity; }
+
+    bool empty() const { return size_bytes == 0; }
+
+    // True when the storage was allocated from a device host buffer type. The
+    // backend may still have served the request with pageable memory when
+    // pinning was unavailable; this flag describes the allocation class only.
+    bool is_pinned() const { return pinned; }
+
+private:
+    void copy_from(const common_checkpoint_buffer & other) {
+        if (other.size_bytes == 0) {
+            return;
+        }
+
+        resize(other.size_bytes);
+        std::memcpy(data_ptr, other.data_ptr, other.size_bytes);
+    }
+
+    static size_t align_up(size_t value, size_t alignment) {
+        if (alignment <= 1) {
+            return value;
+        }
+        const size_t remainder = value % alignment;
+        if (remainder == 0) {
+            return value;
+        }
+        const size_t padding = alignment - remainder;
+        if (value > SIZE_MAX - padding) {
+            return 0;
+        }
+        return value + padding;
+    }
+
+    static size_t alignment_of(ggml_backend_buffer_type_t buft) {
+        const size_t alignment = ggml_backend_buft_get_alignment(buft);
+        return alignment > 0 ? alignment : 1;
+    }
+
+    // Pick the first registered device host buffer type that is not the
+    // ordinary pageable CPU buffer type. On the current single-GPU build this
+    // is the CUDA pinned host buffer type; on a CPU-only build there is none.
+    static ggml_backend_buffer_type_t pinned_host_buffer_type() {
+        static const bool enabled = []() {
+            const char * flag = std::getenv("GGML_PROMPT_CHECKPOINT_PINNED");
+            return !(flag != nullptr && std::strcmp(flag, "0") == 0);
+        }();
+
+        if (!enabled) {
+            return nullptr;
+        }
+
+        static ggml_backend_buffer_type_t cached = []() -> ggml_backend_buffer_type_t {
+            const size_t n_devices = ggml_backend_dev_count();
+            for (size_t i = 0; i < n_devices; ++i) {
+                ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+                if (dev == nullptr) {
+                    continue;
+                }
+
+                ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(dev);
+                if (buft == nullptr) {
+                    continue;
+                }
+                if (buft == ggml_backend_cpu_buffer_type()) {
+                    continue;
+                }
+                if (!ggml_backend_buft_is_host(buft)) {
+                    continue;
+                }
+
+                return buft;
+            }
+
+            return nullptr;
+        }();
+
+        return cached;
+    }
+
+    ggml_backend_buffer_t buffer        = nullptr;
+    std::vector<uint8_t>  data_vector;
+    uint8_t *             data_ptr      = nullptr;
+    size_t                size_bytes    = 0;
+    size_t                data_capacity = 0;
+    bool                  pinned        = false;
+};
