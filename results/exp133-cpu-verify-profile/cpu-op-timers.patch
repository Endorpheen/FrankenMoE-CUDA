+
+struct exp133_stat { uint64_t calls; uint64_t us; };
+static struct exp133_stat exp133_stats[GGML_OP_COUNT][GGML_TYPE_COUNT][5];
+static bool exp133_enabled(void) {
+    const char * e = getenv("GGML_CPU_OP_DIAG");
+    return e && atoi(e) != 0;
+}
+static int exp133_bucket(const struct ggml_tensor * node) {
+    int64_t n = node->op == GGML_OP_MUL_MAT_ID ? node->src[1]->ne[2] : node->ne[1];
+    return n <= 1 ? 0 : n == 2 ? 1 : n <= 8 ? 2 : n <= 32 ? 3 : 4;
+}
+__attribute__((destructor)) static void exp133_flush(void) {
+    if (!exp133_enabled()) return;
+    for (int b = 0; b < 5; ++b) fprintf(stderr, "EXP133_ROUTES bucket=%d calls=%" PRIu64 " used=%" PRIu64 " rows=%" PRIu64 " pairs=%" PRIu64 "\n", b, exp133_routes[b][0], exp133_routes[b][1], exp133_routes[b][2], exp133_routes[b][3]);
+    for (int op = 0; op < GGML_OP_COUNT; ++op)
+    for (int type = 0; type < GGML_TYPE_COUNT; ++type)
+    for (int b = 0; b < 5; ++b) {
+        struct exp133_stat * s = &exp133_stats[op][type][b];
+        if (s->calls) fprintf(stderr, "EXP133_STAT op=%s type=%s bucket=%d calls=%" PRIu64 " us=%" PRIu64 "\n", ggml_op_name(op), ggml_type_name(type), b, s->calls, s->us);
+    }
+}
