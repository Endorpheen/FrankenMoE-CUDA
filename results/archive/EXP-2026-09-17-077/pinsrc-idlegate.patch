+// EXP-077 worker tuning. Bounded batches with a short sleep keep the worker from fighting the
+// decode thread for NVMe and CPU; the queue bound caps memory if the worker falls behind. The
+// batch cap and the sleep are env-overridable so a live A/B can sweep them without a rebuild.
+// Defaults: 4 MiB per batch and 100 ms between batches.
+static constexpr size_t GGML_CUDA_EXPERT_PIN_QUEUE_MAX = 65536;
+
+static size_t ggml_cuda_expert_pin_batch_bytes(void) {
+    static const size_t v = []() {
+        const char * e = getenv("GGML_EXPERT_PIN_BATCH_MB");
+        const long long mb = e != nullptr ? atoll(e) : 0;
+        return (size_t) (mb > 0 ? mb : 4) << 20;
+    }();
+    return v;
+}
+
+static unsigned ggml_cuda_expert_pin_batch_sleep_ms(void) {
+    static const unsigned v = []() {
+        const char * e = getenv("GGML_EXPERT_PIN_BATCH_SLEEP_MS");
+        const long long ms = e != nullptr ? atoll(e) : 100;
+        return (unsigned) (ms >= 0 ? ms : 100);
+    }();
+    return v;
+}
+
+// EXP-077 idle gate: the worker holds a batch back until the request thread has not enqueued
+// anything for this long. 0 disables the gate; the first-dispatch guard still applies.
+static unsigned ggml_cuda_expert_pin_idle_ms(void) {
+    static const unsigned v = []() {
+        const char * e = getenv("GGML_EXPERT_PIN_IDLE_MS");
+        const long long ms = e != nullptr ? atoll(e) : 750;
+        return (unsigned) (ms >= 0 ? ms : 750);
+    }();
+    return v;
+}
 
