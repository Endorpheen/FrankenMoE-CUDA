+// EXP050 diagnostics ------------------------------------------------------------
+//
+// Diagnostic copies of the reuse checks. They never run on the production path;
+// exp050_reuse_blocker() is called a second time from the logging site when
+// GGML_GRAPH_DIAG is set and can_reuse() has already returned false.
+
+static std::string exp050_demangle(const char * name) {
+#if defined(__GLIBCXX__)
+    int status = 0;
+    char * demangled = abi::__cxa_demangle(name, nullptr, nullptr, &status);
+    if (status == 0 && demangled != nullptr) {
+        std::string res = demangled;
+        free(demangled);
+        return res;
+    }
+#endif
+    return std::string(name);
+}
+
+bool llm_graph_params::allow_reuse_diag(const llm_graph_params & other, std::string * reason) const {
+    auto fail = [reason](const std::string & msg) {
+        if (reason != nullptr && reason->empty()) {
+            *reason = msg;
+        }
+        return false;
+    };
+
+    // first check the ubatch
+    bool can_reuse_ubatch =
+        ubatch.equal_seqs() == other.ubatch.equal_seqs() &&
+        ubatch.n_tokens     == other.ubatch.n_tokens     &&
+        ubatch.n_seq_tokens == other.ubatch.n_seq_tokens &&
+        ubatch.n_seqs       == other.ubatch.n_seqs       &&
+        ubatch.n_seqs_unq   == other.ubatch.n_seqs_unq   &&
+        (
+            (!ubatch.token && !other.ubatch.token) ||
+            (!ubatch.embd  && !other.ubatch.embd)  ||
+            (ubatch.token && other.ubatch.token && ubatch.embd && other.ubatch.embd)
+        );
+
+    if (!can_reuse_ubatch) {
+        if (ubatch.equal_seqs() != other.ubatch.equal_seqs()) {
+            return fail("ubatch.equal_seqs " + std::to_string(ubatch.equal_seqs()) + "->" + std::to_string(other.ubatch.equal_seqs()));
+        }
+        if (ubatch.n_tokens != other.ubatch.n_tokens) {
+            return fail("ubatch.n_tokens " + std::to_string(ubatch.n_tokens) + "->" + std::to_string(other.ubatch.n_tokens));
+        }
+        if (ubatch.n_seq_tokens != other.ubatch.n_seq_tokens) {
+            return fail("ubatch.n_seq_tokens " + std::to_string(ubatch.n_seq_tokens) + "->" + std::to_string(other.ubatch.n_seq_tokens));
+        }
+        if (ubatch.n_seqs != other.ubatch.n_seqs) {
+            return fail("ubatch.n_seqs " + std::to_string(ubatch.n_seqs) + "->" + std::to_string(other.ubatch.n_seqs));
+        }
+        if (ubatch.n_seqs_unq != other.ubatch.n_seqs_unq) {
+            return fail("ubatch.n_seqs_unq " + std::to_string(ubatch.n_seqs_unq) + "->" + std::to_string(other.ubatch.n_seqs_unq));
+        }
+        return fail("ubatch token/embd presence pattern changed");
+    }
+
+    // when we split the batch using "equal_seqs" we have to verify that the participating sequences are the same
+    if (can_reuse_ubatch && ubatch.equal_seqs()) {
+        if (!ubatch.data) {
+            return fail("ubatch.data absent (cannot verify unique seq ids)");
+        }
+        for (uint32_t s = 0; s < ubatch.n_seqs_unq; ++s) {
+            if (ubatch.seq_id_unq[s] != other.ubatch.seq_id_unq[s]) {
+                return fail("ubatch.seq_id_unq[" + std::to_string(s) + "]");
+            }
+        }
+    }
+
+    if (n_outputs != other.n_outputs) {
+        return fail("n_outputs " + std::to_string(n_outputs) + "->" + std::to_string(other.n_outputs));
+    }
+
+    if (!samplers_equal(samplers, other.samplers)) {
+        return fail("samplers set changed");
+    }
+
+    if (samplers.size() > 0) {
+        if (!ubatch.data || !other.ubatch.data) {
+            return fail("samplers present but ubatch.data absent");
+        }
+
+        for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+            if (ubatch.output[i]    != other.ubatch.output[i] ||
+                ubatch.seq_id[i][0] != other.ubatch.seq_id[i][0]) {
+                return fail("ubatch.output/seq_id[" + std::to_string(i) + "]");
+            }
+        }
+    }
+
+    if (cparams.nextn_layer_offset != other.cparams.nextn_layer_offset) {
+        return fail("nextn_layer_offset " + std::to_string(cparams.nextn_layer_offset) + "->" + std::to_string(other.cparams.nextn_layer_offset));
+    }
+
+    if (cparams.embeddings != other.cparams.embeddings) {
+        return fail("cparams.embeddings " + std::to_string(cparams.embeddings) + "->" + std::to_string(other.cparams.embeddings));
+    }
+    if (cparams.embeddings_nextn != other.cparams.embeddings_nextn) {
+        return fail("cparams.embeddings_nextn");
+    }
+    if (cparams.embeddings_nextn_masked != other.cparams.embeddings_nextn_masked) {
+        return fail("cparams.embeddings_nextn_masked");
+    }
+    if (cparams.causal_attn != other.cparams.causal_attn) {
+        return fail("cparams.causal_attn");
+    }
+    if (arch != other.arch) {
+        return fail("arch");
+    }
+    if (gtype != other.gtype) {
+        return fail("gtype");
+    }
+    if (cvec != other.cvec) {
+        return fail("cvec");
+    }
+    if (loras != other.loras) {
+        return fail("loras");
+    }
+    if (cross != other.cross) {
+        return fail("cross");
+    }
+
+    return true;
+}
+
+std::string llm_graph_result::exp050_reuse_blocker(const llm_graph_params & params) const {
+    std::string reason;
+
+    if (!this->params.allow_reuse_diag(params, &reason)) {
+        return "params:" + (reason.empty() ? std::string("unspecified") : reason);
+    }
+
+    // inputs: report the first failing input class plus the full per-input verdict list
+    std::string verdicts;
+    for (const auto & input : inputs) {
+        if (!verdicts.empty()) {
+            verdicts += " ";
+        }
+        verdicts += exp050_demangle(typeid(*input).name()) + "=" + (input->can_reuse(params) ? "1" : "0");
+    }
+
+    for (const auto & input : inputs) {
+        if (!input->can_reuse(params)) {
+            return "input:" + exp050_demangle(typeid(*input).name()) + " [" + verdicts + "]";
+        }
+    }
+
+    return "unknown";
+}
