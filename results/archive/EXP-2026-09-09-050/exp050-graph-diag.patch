+// EXP050 diagnostics ------------------------------------------------------------
+//
+// Decision logging for the CUDA-graph state machine (env GGML_GRAPH_DIAG).
+// Purely observational: no stream operation, sync, or allocation is added.
+
+static bool exp050_diag_enabled() {
+    static const bool enabled = getenv("GGML_GRAPH_DIAG") != nullptr;
+    return enabled;
+}
+
+static void exp050_log(const char * fmt, ...) {
+    va_list args;
+    va_start(args, fmt);
+    fputs("[EXP050-L2] ", stderr);
+    vfprintf(stderr, fmt, args);
+    fputc('\n', stderr);
+    fflush(stderr);
+    va_end(args);
+}
+
+static std::string exp050_hex(uintptr_t v) {
+    char buf[32];
+    snprintf(buf, sizeof(buf), "0x%zx", v);
+    return std::string(buf);
+}
+
+// first differing field between two saved node-property snapshots ("old->new");
+// if none of the named fields differs while the raw memcmp did, reports the raw
+// byte offset (catches unstable padding/flags bytes inside ggml_tensor)
+static std::string exp050_props_diff(int node_idx, const ggml_cuda_graph::node_properties & a, const ggml_cuda_graph::node_properties & b) {
+    const std::string pre = "node[" + std::to_string(node_idx) + "]";
+
+    if (a.node.op != b.node.op) {
+        return pre + ".op " + std::to_string((int) a.node.op) + "->" + std::to_string((int) b.node.op);
+    }
+    if (a.node.type != b.node.type) {
+        return pre + ".type " + std::to_string((int) a.node.type) + "->" + std::to_string((int) b.node.type);
+    }
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (a.node.ne[d] != b.node.ne[d]) {
+            return pre + ".ne[" + std::to_string(d) + "] " + std::to_string(a.node.ne[d]) + "->" + std::to_string(b.node.ne[d]);
+        }
+    }
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (a.node.nb[d] != b.node.nb[d]) {
+            return pre + ".nb[" + std::to_string(d) + "] " + std::to_string(a.node.nb[d]) + "->" + std::to_string(b.node.nb[d]);
+        }
+    }
+    if (memcmp(a.node.op_params, b.node.op_params, GGML_MAX_OP_PARAMS) != 0) {
+        return pre + ".op_params";
+    }
+    if (a.node.flags != b.node.flags) {
+        return pre + ".flags " + std::to_string(a.node.flags) + "->" + std::to_string(b.node.flags);
+    }
+    for (int j = 0; j < GGML_MAX_SRC; ++j) {
+        if (a.node.src[j] != b.node.src[j]) {
+            return pre + ".src[" + std::to_string(j) + "] " + exp050_hex((uintptr_t) a.node.src[j]) + "->" + exp050_hex((uintptr_t) b.node.src[j]);
+        }
+        if (a.node.src[j] != nullptr) {
+            if (a.node_src_data_ptrs[j] != b.node_src_data_ptrs[j]) {
+                return pre + ".src[" + std::to_string(j) + "].data " + exp050_hex((uintptr_t) a.node_src_data_ptrs[j]) + "->" + exp050_hex((uintptr_t) b.node_src_data_ptrs[j]);
+            }
+            for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+                if (a.node_src_ne[j][d] != b.node_src_ne[j][d]) {
+                    return pre + ".src[" + std::to_string(j) + "].ne[" + std::to_string(d) + "] " + std::to_string(a.node_src_ne[j][d]) + "->" + std::to_string(b.node_src_ne[j][d]);
+                }
+            }
+            for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+                if (a.node_src_nb[j][d] != b.node_src_nb[j][d]) {
+                    return pre + ".src[" + std::to_string(j) + "].nb[" + std::to_string(d) + "] " + std::to_string(a.node_src_nb[j][d]) + "->" + std::to_string(b.node_src_nb[j][d]);
+                }
+            }
+        }
+    }
+    if (a.node.view_src != b.node.view_src) {
+        return pre + ".view_src " + exp050_hex((uintptr_t) a.node.view_src) + "->" + exp050_hex((uintptr_t) b.node.view_src);
+    }
+    if (a.node.view_offs != b.node.view_offs) {
+        return pre + ".view_offs " + std::to_string(a.node.view_offs) + "->" + std::to_string(b.node.view_offs);
+    }
+    if (a.node.data != b.node.data) {
+        return pre + ".data " + exp050_hex((uintptr_t) a.node.data) + "->" + exp050_hex((uintptr_t) b.node.data);
+    }
+    if (strncmp(a.node.name, b.node.name, GGML_MAX_NAME) != 0) {
+        return pre + ".name '" + std::string(a.node.name) + "'->'" + std::string(b.node.name) + "'";
+    }
+    if (a.node.buffer != b.node.buffer) {
+        return pre + ".buffer " + exp050_hex((uintptr_t) a.node.buffer) + "->" + exp050_hex((uintptr_t) b.node.buffer);
+    }
+    if (a.node.extra != b.node.extra) {
+        return pre + ".extra";
+    }
+
+    // no named field differs, but memcmp did: report the raw offset
+    const char * pa = (const char *) &a;
+    const char * pb = (const char *) &b;
+    for (size_t off = 0; off < sizeof(a); ++off) {
+        if (pa[off] != pb[off]) {
+            return pre + " raw_byte_offset=" + std::to_string(off);
+        }
+    }
+    return pre + " (memcmp mismatch not reproduced)";
+}
