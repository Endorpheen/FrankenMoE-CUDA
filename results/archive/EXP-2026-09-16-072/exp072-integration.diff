+// One IQ4_NL expert chunk shared across 2-3 activation rows. Each weight block pair is
+// unpacked once and applied to all rows. Per-row arithmetic is the same order as
+// ggml_vec_dot_iq4_nl_q8_0 (AVX2): two accumulators per row, one fmadd per block pair,
+// final add then the same hsum reduction.
+static void ggml_compute_forward_mul_mat_id_iq4nl_one_chunk_e72(
+        struct ggml_tensor * dst,
+        const struct ggml_tensor * src0,
+        const struct ggml_tensor * src1,
+        const struct ggml_tensor * ids,
+        const int cur_a,
+        const int64_t ir0_start,
+        const int64_t ir0_end,
+        const char * src0_cur,
+        const struct mmid_row_mapping * matrix_rows,
+        const int64_t cne1,
+        const size_t row_size,
+        const void * wdata) {
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    GGML_ASSERT(cne1 >= 2 && cne1 <= 3);
+
+    const __m128i values128 = _mm_loadu_si128((const __m128i *) kvalues_iq4nl_e72);
+    const __m128i m4b  = _mm_set1_epi8(0x0f);
+    const __m256i mone = _mm256_set1_epi16(1);
+
+    const int64_t nb = ne00 / QK4_NL;
+
+    // row chunk: the guard caps cne1 at 3, the 8-slot form keeps the kernel generic
+    for (int64_t t0 = 0; t0 < cne1; t0 += 8) {
+        const int64_t tr = MIN(t0 + 8, cne1) - t0;
+
+        struct mmid_row_mapping rmap[8];
+        const block_q8_0 * ycol[8];
+        float * dst_col_r[8];
+        for (int64_t r = 0; r < tr; ++r) {
+            rmap[r] = MMID_MATRIX_ROW(cur_a, t0 + r);
+            const int64_t i11 = rmap[r].i1 % ne11;
+            const int64_t i12 = rmap[r].i2;
+            ycol[r] = (const block_q8_0 *)((const int8_t *) wdata + (i11 + i12*ne11)*row_size);
+            dst_col_r[r] = (float *) ((char *) dst->data + (rmap[r].i1*nb1 + rmap[r].i2*nb2));
+        }
+
+        for (int64_t ir0 = ir0_start; ir0 < ir0_end; ++ir0) {
+            __m256 acc1[8];
+            __m256 acc2[8];
+            for (int64_t r = 0; r < tr; ++r) {
+                acc1[r] = _mm256_setzero_ps();
+                acc2[r] = _mm256_setzero_ps();
+            }
+
+            const block_iq4_nl * xb = (const block_iq4_nl *)(src0_cur + ir0*nb01);
+            for (int64_t i = 0; i + 1 < nb; i += 2) {
+                // unpack the weight block pair once, shared by all rows
+                const __m128i q4bits_1 = _mm_loadu_si128((const __m128i *) xb[i + 0].qs);
+                const __m128i q4bits_2 = _mm_loadu_si128((const __m128i *) xb[i + 1].qs);
+                const __m256i q4b_1 = _mm256_insertf128_si256(_mm256_castsi128_si256(
+                        _mm_shuffle_epi8(values128, _mm_and_si128(q4bits_1, m4b))),
+                        _mm_shuffle_epi8(values128, _mm_and_si128(_mm_srli_epi16(q4bits_1, 4), m4b)), 1);
+                const __m256i q4b_2 = _mm256_insertf128_si256(_mm256_castsi128_si256(
+                        _mm_shuffle_epi8(values128, _mm_and_si128(q4bits_2, m4b))),
+                        _mm_shuffle_epi8(values128, _mm_and_si128(_mm_srli_epi16(q4bits_2, 4), m4b)), 1);
+                const float xd_1 = GGML_CPU_FP16_TO_FP32(xb[i + 0].d);
+                const float xd_2 = GGML_CPU_FP16_TO_FP32(xb[i + 1].d);
+
+                for (int64_t r = 0; r < tr; ++r) {
+                    const __m256i q8b_1 = _mm256_loadu_si256((const __m256i *) ycol[r][i + 0].qs);
+                    const __m256i q8b_2 = _mm256_loadu_si256((const __m256i *) ycol[r][i + 1].qs);
+                    const __m256i p16_1 = mul_add_epi8_e72(q4b_1, q8b_1);
+                    const __m256i p16_2 = mul_add_epi8_e72(q4b_2, q8b_2);
+                    acc1[r] = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(ycol[r][i + 0].d)*xd_1),
+                            _mm256_cvtepi32_ps(_mm256_madd_epi16(p16_1, mone)), acc1[r]);
+                    acc2[r] = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(ycol[r][i + 1].d)*xd_2),
+                            _mm256_cvtepi32_ps(_mm256_madd_epi16(p16_2, mone)), acc2[r]);
+                }
+            }
+            for (int64_t r = 0; r < tr; ++r) {
+                dst_col_r[r][ir0] = hsum_float_8_e46(_mm256_add_ps(acc1[r], acc2[r]));
+            }
+        }
+    }
+}
