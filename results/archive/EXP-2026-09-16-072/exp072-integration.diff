+            atomic_load(&g_iq4nl_st[4]), atomic_load(&g_iq4nl_st[5]), atomic_load(&g_iq4nl_st[6]), atomic_load(&g_iq4nl_st[7]),
+            atomic_load(&g_iq4nl_st[8]), atomic_load(&g_iq4nl_st[9]), atomic_load(&g_iq4nl_st[10]), atomic_load(&g_iq4nl_st[11]),
+            atomic_load(&g_iq4nl_st[12]), atomic_load(&g_iq4nl_st[13]), atomic_load(&g_iq4nl_st[14]));
+}
