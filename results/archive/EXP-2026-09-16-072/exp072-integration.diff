+// EXP-2026-09-16-072: wall-clock microbench for the fused IQ4_NL mul_mat_id path.
+// One CPU MUL_MAT_ID call with the real Qwen3.8 down shape:
+//   src0 = IQ4_NL 640 x 2560 x 512, src1 = f32 640 x rows, ids = i32 10 x rows.
+// Cases:
+//   "2s" -> rows=2, both tokens select the same 10 experts (groups of 2)
+//   "3s" -> rows=3, all three tokens select the same 10 experts (groups of 3)
+//   "3m" -> rows=3, mixed routing close to the EXP-046 group histogram (c1 73.5%, c2 18.1%, c3 8.25%)
+//   "3r" -> rows=3, one group of 3 and one group of 2 (minimal sharing)
+// Arms alternate OFF/ON, 3 pairs per invocation; every arm does 10 warmup calls
+// then n_measured timed calls (timer strictly around ggml_backend_graph_compute,
+// i.e. one graph compute call). Data and seed=42 are shared by both arms.
+// The OFF and ON outputs are compared once over the full dst bytes (exactness of
+// the real call); the fused_dispatches counter delta proves which arm ran.
+// Usage: test-iq4nl-fused-mmid-bench <case: 2s|3s|3m|3r> <threads> [n_measured=100]
+// Disabled control: GGML_CPU_IQ4NL_FUSED=0 ... (both arms then report delta 0)
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static const int64_t D    = 640;   // down contraction (ne00)
+static const int64_t NE   = 512;   // experts (ne02)
+static const int64_t NEU  = 10;    // experts per token (ids ne0)
+static const int64_t NROW = 2560;  // down output rows (ne01)
+
+static const std::vector<int32_t> IDS_2S = {
+    7, 1, 2, 3, 4, 5, 6, 8, 9, 511,
+    7, 1, 2, 3, 4, 5, 6, 8, 9, 511,
+};
+static const std::vector<int32_t> IDS_3S = {
+    7, 1, 2, 3, 4, 5, 6, 8, 9, 511,
+    7, 1, 2, 3, 4, 5, 6, 8, 9, 511,
+    7, 1, 2, 3, 4, 5, 6, 8, 9, 511,
+};
+static const std::vector<int32_t> IDS_3M = {
+    0, 511, 3, 7, 11, 20, 21, 22, 23, 24,
+    0, 511, 3, 7, 11, 30, 31, 32, 33, 34,
+    0, 511, 40, 41, 42, 43, 44, 45, 46, 47,
+};
+static const std::vector<int32_t> IDS_3R = {
+    7, 1, 2, 3, 4, 5, 6, 8, 9, 511,
+    7, 12, 13, 14, 15, 16, 17, 18, 511, 300,
