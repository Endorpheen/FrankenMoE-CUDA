+// same body as mul_add_epi8 in arch/x86/quants.c
+static inline __m256i mul_add_epi8_e72(const __m256i x, const __m256i y) {
+    const __m256i ax = _mm256_sign_epi8(x, x);
+    const __m256i sy = _mm256_sign_epi8(y, x);
+    return _mm256_maddubs_epi16(ax, sy);
+}
