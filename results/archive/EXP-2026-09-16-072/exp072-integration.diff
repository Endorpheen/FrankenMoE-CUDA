+//
+// EXP-2026-09-16-072: fused IQ4_NL mul_mat_id path for 2-3-row expert groups
+// inside the same decode-only verification window. On by default.
+//
+
+// on by default; set GGML_CPU_IQ4NL_FUSED=0 to restore the stock per-row path
+static int iq4nl_fused_mode(void) {
+    static atomic_int mode = -1;
+    int m = atomic_load_explicit(&mode, memory_order_relaxed);
+    if (m < 0) {
+        const char * e = getenv("GGML_CPU_IQ4NL_FUSED");
+        m = (e == NULL || (*e != '\0' && strcmp(e, "0") != 0)) ? 1 : 0;
+        atomic_store_explicit(&mode, m, memory_order_relaxed);
+    }
+    return m;
+}
+
+// GGML_CPU_IQ4NL_FUSED_STATS: unset or "0" -> stats off; any other value -> on.
+// Counters are read-only diagnostics; both the increments and the atexit dump
+// are gated, so timed runs can keep the entire block disabled.
+static int iq4nl_fused_stats_mode(void) {
+    static atomic_int mode = -1;
+    int m = atomic_load_explicit(&mode, memory_order_relaxed);
+    if (m < 0) {
+        const char * e = getenv("GGML_CPU_IQ4NL_FUSED_STATS");
+        m = (e != NULL && *e != '\0' && strcmp(e, "0") != 0) ? 1 : 0;
+        atomic_store_explicit(&mode, m, memory_order_relaxed);
+    }
+    return m;
+}
+
+static atomic_bool g_iq4nl_fused_window = false; // closed until a caller opens it
+
+static atomic_ullong g_iq4nl_st[16]; // hist_group[4], hist_group_fused[4], hist_tokens[4], n_calls, n_window_open, n_fused_dispatch
+
+static void iq4nl_fused_stats_count(int idx, unsigned long long v) {
+    if (iq4nl_fused_stats_mode() == 1) {
+        atomic_fetch_add_explicit(&g_iq4nl_st[idx], v, memory_order_relaxed);
+    }
+}
+
+void ggml_cpu_iq4nl_fused_stats_dump(void) {
+    if (iq4nl_fused_stats_mode() != 1) {
+        return;
+    }
+    fprintf(stderr, "IQ4NL_FUSED_STATS groups[c1,c2,c3,c4+]=%llu,%llu,%llu,%llu fused_groups=%llu,%llu,%llu,%llu tokens[c1,c2,c3,c4+]=%llu,%llu,%llu,%llu iq4nl_groups_seen=%llu window_opens=%llu fused_dispatches=%llu\n",
