+// EXP-076 request path: copy directly only when the whole request is already covered by physical
+// registrations (split at the physical ends, like EXP-075); otherwise copy nothing, queue the
+// page-aligned uncovered remainder and let the accepted ring serve the whole request.
+static bool ggml_cuda_expert_pin_try_async(ggml_backend_cuda_context * cuda_ctx, void * dst,
+                                           const uint8_t * src, size_t size) {
+    struct PinSeg {
+        const uint8_t * host;
+        size_t bytes;
+    };
+    std::vector<PinSeg> segs;
+    segs.reserve(8);
+
+    const size_t page = ggml_cuda_expert_pin_page_size();
+    const uintptr_t req_begin = (uintptr_t) src;
+    const uintptr_t req_end   = req_begin + size;
+
+    bool fully_covered = true;
+    {
+        std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+        uintptr_t cur = req_begin;
+        while (cur < req_end) {
+            const uintptr_t cover = ggml_cuda_expert_pin_cover_end(cuda_ctx->expert_pin_regions, cur);
+            if (cover == 0) {
+                fully_covered = false;
+                break;
+            }
+            const uintptr_t end = std::min<uintptr_t>(cover, req_end);
+            segs.push_back({ (const uint8_t *) cur, (size_t) (end - cur) });
+            cur = end;
+        }
+
+        if (fully_covered) {
+            cuda_ctx->expert_pin_n_direct++;
+            cuda_ctx->expert_pin_n_sub_direct += segs.size();
+        } else {
+            // no direct copy at all for this request: the ring copies it whole, so no byte is
+            // copied twice. Queue each page-aligned uncovered remainder for the worker.
+            cuda_ctx->expert_pin_n_fallback++;
+            uintptr_t q = req_begin;
+            while (q < req_end) {
+                const uintptr_t cover = ggml_cuda_expert_pin_cover_end(cuda_ctx->expert_pin_regions, q);
+                if (cover > 0) {
+                    q = std::min<uintptr_t>(cover, req_end);
+                    continue;
+                }
+                const uintptr_t next = ggml_cuda_expert_pin_next_start(cuda_ctx->expert_pin_regions, q);
+                const uintptr_t end = (next != UINTPTR_MAX && next < req_end) ? next : req_end;
+                const uintptr_t reg_begin = q & ~(uintptr_t) (page - 1);
+                const uintptr_t reg_end   = (end + page - 1) & ~(uintptr_t) (page - 1);
+                ggml_cuda_expert_pin_enqueue_locked(cuda_ctx, reg_begin, reg_end);
+                q = end;
+            }
+            if (cuda_ctx->expert_pin_worker_state == 0) {
+                ggml_cuda_expert_pin_worker_start_locked(cuda_ctx);
+            }
+            cuda_ctx->expert_pin_cv.notify_one();
+        }
+    }
+
+    if (cuda_ctx->expert_pin_trace) {
+        GGML_LOG_WARN("%s: expert pin trace: %s\n", __func__, fully_covered ? "direct" : "ring");
+    }
+    if (!fully_covered) {
+        return false;
+    }
+
+    // The plan was built under the mutex; the copies are issued after it is released. The host
+    // pointers lie in stable registrations that are only added, never removed, before teardown.
+    char * dst_bytes = (char *) dst;
+    size_t off = 0;
+    for (const PinSeg & seg : segs) {
+        CUDA_CHECK(cudaMemcpyAsync(dst_bytes + off, seg.host, seg.bytes, cudaMemcpyHostToDevice, cuda_ctx->stream()));
+        off += seg.bytes;
+    }
+    return true;
+}
