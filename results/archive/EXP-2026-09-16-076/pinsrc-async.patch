+// idempotent; joins the worker before any registration is released
+static void ggml_cuda_expert_pin_worker_stop(ggml_backend_cuda_context * cuda_ctx) {
+    std::thread worker;
+    {
+        std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+        cuda_ctx->expert_pin_quit = true;
