+// Register one queued range. The blocking cudaHostRegister call runs without the mutex so a
+// request never waits for it; the budget is reserved before the call and rolled back on failure.
+static void ggml_cuda_expert_pin_worker_pin(ggml_backend_cuda_context * cuda_ctx, uintptr_t begin, uintptr_t end) {
+    const size_t add = (size_t) (end - begin);
+    {
+        std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+        if (cuda_ctx->expert_pin_saturated) {
+            cuda_ctx->expert_pin_n_dropped++;
+            return;
+        }
+        if (ggml_cuda_expert_pin_overlaps(cuda_ctx->expert_pin_regions, begin, end) ||
+            ggml_cuda_expert_pin_overlaps(cuda_ctx->expert_pin_blacklist, begin, end)) {
+            cuda_ctx->expert_pin_n_dedup++; // covered or blacklisted since it was queued
+            return;
+        }
+        if (g_expert_pin_bytes.load(std::memory_order_relaxed) + add > ggml_cuda_expert_pin_budget_bytes()) {
+            // the budget is a hard process-wide cap: stop trying instead of spinning
+            cuda_ctx->expert_pin_saturated = true;
+            cuda_ctx->expert_pin_n_dropped++;
+            return;
+        }
+        if (!ggml_cuda_expert_pin_headroom_ok(add)) {
+            // memory pressure is transient: drop without blacklisting, the ring still serves it
+            cuda_ctx->expert_pin_n_dropped++;
+            return;
+        }
+        g_expert_pin_bytes.fetch_add(add, std::memory_order_relaxed);
+        cuda_ctx->expert_pin_bytes += add;
+    }
+
+    const bool ok = ggml_cuda_expert_pin_register((void *) begin, add);
+
+    std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+    if (ok) {
+        ggml_cuda_expert_pin_insert_region(cuda_ctx->expert_pin_regions, begin, end);
+        ggml_cuda_expert_pin_insert(cuda_ctx->expert_pin_intervals, begin, end);
+        cuda_ctx->expert_pin_n_worker_registered++;
+    } else {
+        g_expert_pin_bytes.fetch_sub(add, std::memory_order_relaxed);
+        cuda_ctx->expert_pin_bytes -= add;
+        ggml_cuda_expert_pin_insert(cuda_ctx->expert_pin_blacklist, begin, end);
+        cuda_ctx->expert_pin_n_fail++;
+    }
