+        cuda_ctx->expert_pin_worker = std::thread(ggml_cuda_expert_pin_worker_run, cuda_ctx);
+        cuda_ctx->expert_pin_worker_state = 1;
+    } catch (...) {
+        // never register on the request thread: if the worker cannot start, the ring serves
+        cuda_ctx->expert_pin_worker_state = -1;
+        GGML_LOG_WARN("%s: expert pin worker failed to start, staying on the pinned slot ring\n", __func__);
+    }
