+                      __func__, processed, queued, depth, (processed >= queued && depth == 0) ? ", drained" : "");
+        std::this_thread::sleep_for(std::chrono::milliseconds(GGML_CUDA_EXPERT_PIN_BATCH_SLEEP_MS));
+    }
+    std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+    cuda_ctx->expert_pin_worker_joined = true;
