+        size_t queued = 0;
+        size_t depth = 0;
+        {
+            std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+            cuda_ctx->expert_pin_n_worker_batches++;
+            processed = cuda_ctx->expert_pin_n_worker_processed;
+            queued = cuda_ctx->expert_pin_n_queued;
+            depth = cuda_ctx->expert_pin_queue.size();
+        }
