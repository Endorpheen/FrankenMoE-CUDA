+// The worker waits for queued work and for the first request to return, pins one bounded batch,
+// then sleeps briefly so the decode thread keeps the NVMe and CPU.
+static void ggml_cuda_expert_pin_worker_run(ggml_backend_cuda_context * cuda_ctx) {
+    ggml_cuda_set_device(cuda_ctx->device);
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lock(g_expert_pin_mutex);
+            cuda_ctx->expert_pin_cv.wait(lock, [cuda_ctx] {
+                return cuda_ctx->expert_pin_quit ||
+                    (g_expert_pin_dispatch_done.load(std::memory_order_acquire) &&
+                     !cuda_ctx->expert_pin_saturated && !cuda_ctx->expert_pin_queue.empty());
+            });
+            if (cuda_ctx->expert_pin_quit) {
+                break;
+            }
+        }
+
+        size_t batch_bytes = 0;
+        bool quit = false;
+        while (batch_bytes < GGML_CUDA_EXPERT_PIN_BATCH_BYTES) {
+            uintptr_t begin = 0;
+            uintptr_t end = 0;
+            {
+                std::lock_guard<std::mutex> lock(g_expert_pin_mutex);
+                if (cuda_ctx->expert_pin_quit) {
+                    quit = true;
+                    break;
+                }
+                if (cuda_ctx->expert_pin_saturated || cuda_ctx->expert_pin_queue.empty()) {
+                    break;
+                }
+                begin = cuda_ctx->expert_pin_queue.front().first;
+                end   = cuda_ctx->expert_pin_queue.front().second;
+                cuda_ctx->expert_pin_queue.pop_front();
