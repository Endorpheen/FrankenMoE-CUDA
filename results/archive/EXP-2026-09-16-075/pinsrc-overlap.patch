+// EXP-075: when set (default), a request that only partly overlaps an existing registration is
+// split at the registration boundaries and served from the registered pages. 0 restores the
+// EXP-074 rule: any overlap refuses the whole request and falls back to the ring.
+static bool ggml_cuda_expert_pin_split_enabled(void) {
+    const char * v = getenv("GGML_EXPERT_PIN_OVERLAP_SPLIT");
+    return v == nullptr || (v[0] != '\0' && strcmp(v, "0") != 0);
+}
 
+// start of the first registered interval that begins after p, or UINTPTR_MAX
+static uintptr_t ggml_cuda_expert_pin_next_start(const std::vector<std::pair<uintptr_t, uintptr_t>> & ivs, uintptr_t p) {
+    const auto it = std::upper_bound(ivs.begin(), ivs.end(), p,
+        [](uintptr_t b, const std::pair<uintptr_t, uintptr_t> & iv) { return b < iv.first; });
+    return it == ivs.end() ? UINTPTR_MAX : it->first;
+}
