+        }
+    }
+
+    if (!ggml_cuda_expert_pin_split_enabled()) {
+        return ggml_cuda_expert_pin_try_whole(cuda_ctx, dst, src, size);
+    }
+    return ggml_cuda_expert_pin_try_split(cuda_ctx, dst, src, size);
+}
