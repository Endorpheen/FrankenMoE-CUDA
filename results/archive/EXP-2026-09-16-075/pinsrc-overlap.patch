+// split path: walk the request and cut it at registration boundaries. A sub-range that is already
+// covered is copied with no registration; an uncovered sub-range is page-aligned, registered, then
+// copied. The plan registers every remainder before the first copy starts, so a refusal falls back
+// without copying. Sub-copy sizes follow the original unaligned request boundaries, so the copies
+// cover [src, src+size) exactly, with no gap and no byte copied twice.
+static bool ggml_cuda_expert_pin_try_split(ggml_backend_cuda_context * cuda_ctx, void * dst,
+                                           const uint8_t * src, size_t size) {
+    struct PinSeg {
+        const uint8_t * host;
+        size_t bytes;
+        bool registered;
+    };
+    std::vector<PinSeg> segs;
+    segs.reserve(8);
+
+    const size_t page = ggml_cuda_expert_pin_page_size();
+    const uintptr_t req_begin = (uintptr_t) src;
+    const uintptr_t req_end   = req_begin + size;
+
+    uintptr_t cur = req_begin;
+    bool any_covered = false;
+    bool any_registered = false;
+
+    while (cur < req_end) {
+        const uintptr_t cover = ggml_cuda_expert_pin_cover_end(cuda_ctx->expert_pin_intervals, cur);
+        if (cover > 0) {
+            const uintptr_t end = std::min<uintptr_t>(cover, req_end);
+            segs.push_back({ (const uint8_t *) cur, (size_t) (end - cur), false });
+            any_covered = true;
+            cur = end;
+            continue;
+        }
+
+        // the run up to the next registered interval is not covered; register it page-aligned
+        const uintptr_t next = ggml_cuda_expert_pin_next_start(cuda_ctx->expert_pin_intervals, cur);
+        const uintptr_t end = (next != UINTPTR_MAX && next < req_end) ? next : req_end;
+        const uintptr_t reg_begin = cur & ~(uintptr_t) (page - 1);
+        const uintptr_t reg_end   = (end + page - 1) & ~(uintptr_t) (page - 1);
+
+        const int rc = ggml_cuda_expert_pin_register_range(cuda_ctx, reg_begin, reg_end);
+        if (rc != GGML_CUDA_EXPERT_PIN_OK) {
+            if (rc == GGML_CUDA_EXPERT_PIN_REGFAIL) {
+                // never retry this interval
+                ggml_cuda_expert_pin_insert(cuda_ctx->expert_pin_blacklist, reg_begin, reg_end);
+                cuda_ctx->expert_pin_n_fail++;
+                ggml_cuda_expert_pin_log_fallback(cuda_ctx, "registration failed");
+            } else if (rc == GGML_CUDA_EXPERT_PIN_BUDGET) {
+                ggml_cuda_expert_pin_log_fallback(cuda_ctx, "budget reached");
+            } else if (rc == GGML_CUDA_EXPERT_PIN_BLACKLIST) {
+                ggml_cuda_expert_pin_log_fallback(cuda_ctx, "range is blacklisted");
+            } else if (rc == GGML_CUDA_EXPERT_PIN_HEADROOM) {
+                ggml_cuda_expert_pin_log_fallback(cuda_ctx, "low memory headroom");
+            } else {
+                ggml_cuda_expert_pin_log_fallback(cuda_ctx, "range overlaps a registered range");
+            }
+            cuda_ctx->expert_pin_n_fallback++;
+            return false;
+        }
+
+        segs.push_back({ (const uint8_t *) cur, (size_t) (end - cur), true });
+        any_registered = true;
+        cur = end;
+    }
+
+    char * dst_bytes = (char *) dst;
+    size_t off = 0;
+    for (const PinSeg & seg : segs) {
+        CUDA_CHECK(cudaMemcpyAsync(dst_bytes + off, seg.host, seg.bytes, cudaMemcpyHostToDevice, cuda_ctx->stream()));
+        off += seg.bytes;
+        if (seg.registered) {
+            cuda_ctx->expert_pin_n_sub_reg++;
+        } else {
+            cuda_ctx->expert_pin_n_sub_direct++;
+        }
+    }
+
+    if (any_registered && any_covered) {
+        cuda_ctx->expert_pin_n_split++;
+    } else {
+        cuda_ctx->expert_pin_n_direct++;
+    }
+    return true;
+}
