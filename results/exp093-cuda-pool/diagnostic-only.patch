+static void ggml_backend_cuda_exp093_report(ggml_backend_t backend, const char * phase) {
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    size_t graphs = 0;
+#ifdef USE_CUDA_GRAPH
+    graphs = ctx->cuda_graphs.size();
+#endif
+    for (int dev = 0; dev < ggml_cuda_info().device_count; ++dev) {
+        for (int stream = 0; stream < GGML_CUDA_MAX_STREAMS; ++stream) {
+            auto & pool = ctx->pools[dev][stream];
+            if (pool) {
+#if defined(GGML_USE_VMM)
+                if (ggml_cuda_info().devices[dev].vmm) {
+                    auto * value = static_cast<ggml_cuda_pool_vmm *>(pool.get());
+                    GGML_LOG_INFO("EXP093_POOL phase=%s device=%d stream=%d kind=vmm mapped=%zu live=%zu host_peak=%zu granularity=%zu graphs=%zu\n",
+                                  phase, dev, stream, value->pool_size, value->pool_used,
+                                  value->exp093_peak_used, value->granularity, graphs);
+                    value->exp093_peak_used = value->pool_used;
+                } else
+#endif
+                {
+                    auto * value = static_cast<ggml_cuda_pool_leg *>(pool.get());
+                    size_t cached = 0;
+                    for (const auto & buffer : value->buffer_pool) {
+                        cached += buffer.size;
+                    }
+                    GGML_LOG_INFO("EXP093_POOL phase=%s device=%d stream=%d kind=legacy mapped=%zu cached=%zu graphs=%zu\n",
+                                  phase, dev, stream, value->pool_size, cached, graphs);
+                }
+            }
+            if (ctx->cublas_workspaces[dev][stream]) {
+                GGML_LOG_INFO("EXP093_CUBLAS phase=%s device=%d stream=%d bytes=%zu\n",
+                              phase, dev, stream, ctx->cublas_workspace_sizes[dev]);
+            }
+        }
+    }
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_exp093_pool_report") == 0) {
+        return (void *) ggml_backend_cuda_exp093_report;
+    }
     if (strcmp(name, "ggml_backend_comm_init") == 0) {
         return (void *)ggml_backend_cuda_comm_init;
     }
