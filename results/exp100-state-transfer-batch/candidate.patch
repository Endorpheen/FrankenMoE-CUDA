 // state save/load
 //
 
+// batch the host-side state transfers: issue every copy for one backend and
+// synchronize that backend once, instead of synchronizing after each tensor.
+// The public state calls stay synchronous: the io object synchronizes every
+// backend before it is destroyed.
+static bool llama_state_transfer_batch_enabled() {
+    static const bool enabled = []() {
+        const char * flag = std::getenv("GGML_STATE_TRANSFER_BATCH");
+        return !(flag != nullptr && std::strcmp(flag, "0") == 0);
+    }();
+    return enabled;
+}
+
+typedef ggml_backend_t (*llama_io_backend_lookup_t)(void * user_data, const ggml_tensor * tensor);
+
+ggml_backend_t llama_context::backend_for_tensor(const ggml_tensor * tensor) const {
+    GGML_ASSERT(tensor != nullptr);
+
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (buf != nullptr) {
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(buf);
+        for (const auto & backend_ptr : backends) {
+            ggml_backend_t backend = backend_ptr.get();
+            if (backend != nullptr && ggml_backend_get_default_buffer_type(backend) == buft) {
+                return backend;
+            }
+        }
+    }
+
+    // host buffers, split buffers and any other buffer type without an exact
+    // backend match are served by the CPU backend, whose async path falls back
+    // to a synchronous buffer copy
+    if (backend_cpu != nullptr) {
+        return backend_cpu;
+    }
+
+    for (auto it = backends.rbegin(); it != backends.rend(); ++it) {
+        if (it->get() != nullptr) {
+            return it->get();
+        }
+    }
+
+    return nullptr;
+}
+
+ggml_backend_t llama_context::backend_for_tensor_cb(void * user_data, const ggml_tensor * tensor) {
+    const auto * ctx = static_cast<const llama_context *>(user_data);
+    return ctx->backend_for_tensor(tensor);
+}
