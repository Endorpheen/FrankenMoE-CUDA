 // ggml_compute_forward_mul_mat_id
 
+// Bounded CPU prefetch for the expert rows read by MUL_MAT_ID.
+//
+// The row being multiplied is streamed by vec_dot; this helper only asks the
+// CPU to bring the first cache lines of a few following rows of the same
+// expert matrix closer. It never touches a line outside the src0 tensor, it
+// does not change the arithmetic, the block formats or the accumulation order,
+// and it is restricted to Q4_K/Q6_K weights. Disable with
+// GGML_CPU_MOE_PREFETCH=0.
+
+#define GGML_CPU_MOE_PREFETCH_ROWS  2
+#define GGML_CPU_MOE_PREFETCH_LINES 4
+
+static int ggml_cpu_moe_prefetch_enabled(enum ggml_type type) {
+    if (type != GGML_TYPE_Q4_K && type != GGML_TYPE_Q6_K) {
+        return 0;
+    }
+
+    const char * flag = getenv("GGML_CPU_MOE_PREFETCH");
+    return !(flag != NULL && strcmp(flag, "0") == 0);
+}
+
+static inline void ggml_cpu_moe_prefetch_row(const char * row, const char * tensor_end, size_t row_bytes) {
+#if defined(__GNUC__) || defined(__clang__)
+    const size_t line  = 64;
+    size_t       lines = row_bytes / line;
+    if (lines > GGML_CPU_MOE_PREFETCH_LINES) {
+        lines = GGML_CPU_MOE_PREFETCH_LINES;
+    }
+
+    for (size_t i = 0; i < lines; ++i) {
+        const char * p = row + i*line;
+        if (p < tensor_end) {
+            __builtin_prefetch(p, 0, 3);
+        }
+    }
+#else
+    GGML_UNUSED(row);
+    GGML_UNUSED(tensor_end);
+    GGML_UNUSED(row_bytes);
+#endif
+}
