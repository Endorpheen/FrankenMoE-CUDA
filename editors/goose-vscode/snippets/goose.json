{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:value}: ${3:i64}) -> ${4:i64} {",
      "\t${0:return value}",
      "}"
    ],
    "description": "Goose function"
  },
  "Exported function": {
    "prefix": "export fn",
    "body": [
      "export fn ${1:name}(${2:value}: ${3:i64}) -> ${4:i64} {",
      "\t${0:return value}",
      "}"
    ],
    "description": "Goose exported function"
  },
  "Extern declaration": {
    "prefix": "extern fn",
    "body": [
      "extern \"${1:symbol}\" fn ${2:name}(${3:value}: ${4:i64}) -> ${5:i64};"
    ],
    "description": "Goose extern function declaration"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i64}",
      "}"
    ],
    "description": "Goose struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:First}",
      "}"
    ],
    "description": "Goose enum"
  },
  "Import": {
    "prefix": "import",
    "body": ["import ${1:std};"],
    "description": "Goose import"
  },
  "Namespace": {
    "prefix": "namespace",
    "body": ["namespace ${1:name};"],
    "description": "Goose namespace"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t${0}", "}"],
    "description": "Goose if"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t${0}", "}"],
    "description": "Goose while loop"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:index} in ${2:0..count} {", "\t${0}", "}"],
    "description": "Goose for loop"
  },
  "Match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "\t${2:case} => ${3:result},", "}"]
  }
}
