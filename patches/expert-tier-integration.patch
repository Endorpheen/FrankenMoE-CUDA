+
+// Thresholds copied from scripts/run_qwen38_server.sh. Samples are one second apart.
+// Cold startup legitimately page-faults the 82 GB model from the file cache, that is
+// file-backed read, not swap, so the same thresholds apply from the very first sample.
+// Env overrides are a test hook for small cgroup tests, the launcher never sets them.
+static long proc_swap_burst_kib() {
+    const char * env = getenv("SWAP_WATCHDOG_PROC_BURST_KIB");
+    return env ? atol(env) : 256 * 1024;
+}
+
+static long sys_rate_hard_mib_s() {
+    const char * env = getenv("SWAP_WATCHDOG_SYS_RATE_HARD_MIB_S");
+    return env ? atol(env) : 2048;
+}
+
+static long sys_rate_burst_mib_s() {
+    const char * env = getenv("SWAP_WATCHDOG_SYS_RATE_MIB_S");
+    return env ? atol(env) : 512;
+}
+
+static int sys_rate_burst_samples() {
+    const char * env = getenv("SWAP_WATCHDOG_BURST_SAMPLES");
+    return env ? atoi(env) : 5;
+}
+
+static std::atomic<bool> g_running{false};
+
+static bool read_status(long * rss_kib, long * swap_kib) {
+    std::ifstream f("/proc/self/status");
+    if (!f) {
+        return false;
+    }
+    std::string line;
+    *rss_kib  = -1;
+    *swap_kib = -1;
+    while (std::getline(f, line)) {
+        // /proc fields are separated by tabs, match the key only
+        if (line.compare(0, 6, "VmRSS:") == 0) {
+            sscanf(line.c_str() + 6, "%ld", rss_kib);
+        } else if (line.compare(0, 7, "VmSwap:") == 0) {
+            sscanf(line.c_str() + 7, "%ld", swap_kib);
+        }
+    }
+    return *rss_kib >= 0 && *swap_kib >= 0;
+}
+
+static bool read_vmstat(unsigned long long * in, unsigned long long * out) {
+    std::ifstream f("/proc/vmstat");
+    if (!f) {
+        return false;
+    }
+    std::string key;
+    unsigned long long value;
+    *in  = 0;
+    *out = 0;
+    while (f >> key >> value) {
+        if (key == "pswpin") {
+            *in = value;
+        } else if (key == "pswpout") {
+            *out = value;
+        }
+    }
+    return true;
+}
+
+static void stop_server(const char * reason, long value) {
+    LOG_ERR("swap watchdog: %s (%ld MiB); stopping server\n", reason, value);
+    g_running.store(false);
+
+    // Escalate to SIGKILL if the graceful stop hangs, the launcher script does the same.
+    std::thread([]() {
+        std::this_thread::sleep_for(std::chrono::seconds(30));
+        kill(getpid(), SIGKILL);
+    }).detach();
+
+    kill(getpid(), SIGINT);
+}
+
+static void watchdog_loop() {
+    long    last_swap_kib = -1;
+    unsigned long long last_in = 0;
+    unsigned long long last_out = 0;
+    int burst_samples = 0;
+
+    if (!read_vmstat(&last_in, &last_out)) {
+        LOG_WRN("swap watchdog: cannot read /proc/vmstat, only VmSwap is monitored\n");
+    }
+
+    while (g_running.load(std::memory_order_relaxed)) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+
+        long rss_kib;
+        long swap_kib;
+        if (!read_status(&rss_kib, &swap_kib)) {
+            continue;
+        }
+
+        if (last_swap_kib >= 0) {
+            long burst = swap_kib - last_swap_kib;
+            if (burst > proc_swap_burst_kib()) {
+                stop_server("process swap grew past the per-sample burst limit", burst / 1024);
+                return;
+            }
+        }
+        last_swap_kib = swap_kib;
+
+        unsigned long long in;
+        unsigned long long out;
+        if (read_vmstat(&in, &out)) {
+            long rate_mib = (long) ((in - last_in) + (out - last_out)) * 4 / 1024;
+            last_in  = in;
+            last_out = out;
+            if (rate_mib > sys_rate_hard_mib_s()) {
+                stop_server("system swap I/O burst", rate_mib);
+                return;
+            }
+            if (rate_mib > sys_rate_burst_mib_s()) {
+                if (++burst_samples >= sys_rate_burst_samples()) {
+                    stop_server("sustained system swap I/O", rate_mib);
+                    return;
+                }
+            } else {
+                burst_samples = 0;
+            }
+        }
+    }
+}
+
+bool server_swap_watchdog_start() {
+    if (g_running.exchange(true)) {
+        return true;
+    }
+    std::thread(watchdog_loop).detach();
+    LOG_INF("swap watchdog: monitoring VmSwap and system swap I/O\n");
+    return true;
+}
+#else
+
+bool server_swap_watchdog_start() {
+    return false;
+}
+
+#endif
