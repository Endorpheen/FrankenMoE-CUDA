@@ -0,0 +1,158 @@
+#include "server-swapwatchdog.h"
+
+#include "log.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <thread>
+
+#ifdef __linux__
+#include <csignal>
