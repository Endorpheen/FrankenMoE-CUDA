+// Optional lazy VMM buffer for the KV cache (CUDA backend).
+// The buffer type and the range commit are exposed by the backend registry, so
+// the core code does not depend on CUDA headers or on a specific backend.
+typedef ggml_backend_buffer_type_t (*llama_kv_lazy_buft_fn)(ggml_backend_dev_t);
+typedef void (*llama_kv_lazy_prepare_fn)(ggml_backend_buffer_t, size_t, size_t);
+
+static ggml_backend_buffer_type_t llama_kv_lazy_buft(ggml_backend_dev_t dev) {
+    if (dev == nullptr) {
+        return nullptr;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    auto fn = (llama_kv_lazy_buft_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_lazy_buffer_type");
+    if (fn == nullptr) {
+        return nullptr;
+    }
+    return fn(dev);
+}
+
+static void llama_kv_prepare(ggml_backend_buffer_t buf, size_t offset, size_t size) {
+    if (buf == nullptr || size == 0) {
+        return;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buf)));
+    if (reg == nullptr) {
+        return;
+    }
+    auto fn = (llama_kv_lazy_prepare_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_lazy_prepare");
+    if (fn != nullptr) {
+        fn(buf, offset, size);
+    }
