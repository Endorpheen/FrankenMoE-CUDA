--- a/ggml/src/ggml-cuda/ggml-cuda.cu	2026-10-30 22:49:50.637477497 +0300
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu	2026-10-30 23:16:07.641213365 +0300
@@ -1394,6 +1394,411 @@
     return &ggml_backend_cuda_buffer_type_host;
 }
 
+
+// Lazy VMM buffer used by the KV cache.
+//
+// The full virtual range is reserved up front so that tensor addresses, shapes
+// and strides never change, but physical pages are committed only for the byte
+// range that is actually used. The range is grown from llama-kv-cache before a
+// graph runs and before a state is read or written; pages are zeroed when they
+// are committed, which keeps the previous "zeroed padding" behavior.
+//
+// This buffer is opt-in per allocation: only the KV cache asks for this buffer
+// type. It is disabled with GGML_KV_LAZY_VMM=0 and is never used when the
+// driver has no VMM support or when the V cache is transposed (V transposition
+// spreads a cell across the whole tensor, so a prefix range is not enough).
+#if defined(GGML_USE_VMM) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+
+static const char * ggml_backend_cuda_lazy_buffer_type_get_name(ggml_backend_buffer_type_t buft);
+
+struct ggml_backend_cuda_lazy_buffer_context {
+    int    device;
+    CUdeviceptr ptr;
+    size_t size;        // logical size requested by the allocator
+    size_t reserved;    // granularity-aligned virtual reservation
+    size_t granularity;
+    std::vector<std::pair<size_t, size_t>> mapped; // sorted, non-overlapping [begin, end)
+};
+
+static void ggml_backend_cuda_lazy_map(ggml_backend_cuda_lazy_buffer_context * ctx, size_t begin, size_t end) {
+    if (end <= begin) {
+        return;
+    }
+    GGML_ASSERT(begin % ctx->granularity == 0 && end % ctx->granularity == 0);
+
+    ggml_cuda_set_device(ctx->device);
+
+    CUmemAllocationProp prop = {};
+    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id = ggml_cuda_get_physical_device(ctx->device);
+
+    CUmemGenericAllocationHandle handle;
+    CU_CHECK(cuMemCreate(&handle, end - begin, &prop, 0));
+    CU_CHECK(cuMemMap(ctx->ptr + begin, end - begin, 0, handle, 0));
+    CU_CHECK(cuMemRelease(handle));
+
+    CUmemAccessDesc access = {};
+    access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    access.location.id = ggml_cuda_get_physical_device(ctx->device);
+    access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    CU_CHECK(cuMemSetAccess(ctx->ptr + begin, end - begin, &access, 1));
+
+    // the KV cache previously cleared the whole buffer on allocation; preserve
+    // the zero-filled contract for the pages that are committed now
+    CU_CHECK(cuMemsetD8(ctx->ptr + begin, 0, end - begin));
+}
+
+static void ggml_backend_cuda_lazy_prepare(ggml_backend_buffer_t buffer, size_t offset, size_t size) {
+    if (buffer == nullptr || size == 0) {
+        return;
+    }
+    if (buffer->buft->iface.get_name != ggml_backend_cuda_lazy_buffer_type_get_name) {
+        return; // not a lazy buffer, nothing to do
+    }
+
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    const size_t granularity = ctx->granularity;
+    const size_t end_req     = offset + size;
+
+    if (end_req > ctx->size) {
+        GGML_ABORT("%s: range [%zu, %zu) exceeds the lazy buffer size %zu\n", __func__, offset, end_req, ctx->size);
+    }
+
+    const size_t map_begin = (offset / granularity) * granularity;
+    const size_t map_end   = ((end_req + granularity - 1) / granularity) * granularity;
+
+    for (const auto & iv : ctx->mapped) {
+        if (iv.first <= offset && end_req <= iv.second) {
+            return;
+        }
+    }
+
+    // map only the gaps inside [map_begin, map_end) that are not mapped yet
+    size_t cur = map_begin;
+    for (const auto & iv : ctx->mapped) {
+        if (iv.second <= cur) {
+            continue;
+        }
+        if (iv.first >= map_end) {
+            break;
+        }
+        if (iv.first > cur) {
+            ggml_backend_cuda_lazy_map(ctx, cur, iv.first);
+        }
+        cur = std::max(cur, iv.second);
+    }
+    if (cur < map_end) {
+        ggml_backend_cuda_lazy_map(ctx, cur, map_end);
+    }
+
+    ctx->mapped.push_back({map_begin, map_end});
+    std::sort(ctx->mapped.begin(), ctx->mapped.end());
+    std::vector<std::pair<size_t, size_t>> merged;
+    merged.reserve(ctx->mapped.size());
+    for (const auto & iv : ctx->mapped) {
+        if (merged.empty() || iv.first > merged.back().second) {
+            merged.push_back(iv);
+        } else {
+            merged.back().second = std::max(merged.back().second, iv.second);
+        }
+    }
+    ctx->mapped.swap(merged);
+}
+
+static bool ggml_backend_cuda_lazy_is_own_buffer(ggml_backend_buffer_t buffer) {
+    return buffer != nullptr && buffer->buft->iface.get_name == ggml_backend_cuda_lazy_buffer_type_get_name;
+}
+
+static size_t ggml_backend_cuda_lazy_offset(ggml_backend_buffer_t buffer, const void * data) {
+    return (size_t) ((const char *) data - (const char *) ggml_backend_buffer_get_base(buffer));
+}
+
+static void ggml_backend_cuda_lazy_buffer_free_buffer(ggml_backend_buffer_t buffer) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    if (ctx->ptr != 0) {
+        for (const auto & iv : ctx->mapped) {
+            if (iv.second > iv.first) {
+                (void) cuMemUnmap(ctx->ptr + iv.first, iv.second - iv.first);
+            }
+        }
+        (void) cuMemAddressFree(ctx->ptr, ctx->reserved);
+    }
+
+    delete ctx;
+    // ggml_backend_buffer_free() deletes the buffer object itself
+}
+
+static void * ggml_backend_cuda_lazy_buffer_get_base(ggml_backend_buffer_t buffer) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+    return (void *) ctx->ptr;
+}
+
+static enum ggml_status ggml_backend_cuda_lazy_buffer_init_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    if (tensor->view_src != NULL) {
+        GGML_ASSERT(tensor->view_src->buffer->buft == buffer->buft);
+        return GGML_STATUS_SUCCESS;
+    }
+
+    if (ggml_is_quantized(tensor->type) && tensor->view_src == NULL &&
+            ggml_backend_buffer_get_usage(buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        // initialize padding to 0 to avoid possible NaN values, as the normal
+        // CUDA buffer does
+        const size_t original_size = ggml_nbytes(tensor);
+        const size_t padded_size   = ggml_backend_buft_get_alloc_size(buffer->buft, tensor);
+
+        if (padded_size > original_size) {
+            ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, tensor->data) + original_size,
+                    padded_size - original_size);
+            ggml_cuda_set_device(ctx->device);
+            CUDA_CHECK(cudaMemsetAsync((char *) tensor->data + original_size, 0, padded_size - original_size, cudaStreamPerThread));
+            CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+        }
+    }
+
+    return GGML_STATUS_SUCCESS;
+}
+
+static void ggml_backend_cuda_lazy_buffer_memset_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor,
+        uint8_t value, size_t offset, size_t size) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, tensor->data) + offset, size);
+
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemsetAsync((char *) tensor->data + offset, value, size, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+static void ggml_backend_cuda_lazy_buffer_set_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor,
+        const void * data, size_t offset, size_t size) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, tensor->data) + offset, size);
+
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+static void ggml_backend_cuda_lazy_buffer_get_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * tensor,
+        void * data, size_t offset, size_t size) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, tensor->data) + offset, size);
+
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemcpyAsync(data, (const char *) tensor->data + offset, size, cudaMemcpyDeviceToHost, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+static void ggml_backend_cuda_lazy_buffer_set_tensor_2d(ggml_backend_buffer_t buffer, ggml_tensor * tensor,
+        const void * data, size_t offset, size_t size, size_t n_copies, size_t stride_tensor, size_t stride_data) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    const size_t span = size + (n_copies > 0 ? (n_copies - 1)*stride_tensor : 0);
+    ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, tensor->data) + offset, span);
+
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemcpy2DAsync((char *) tensor->data + offset, stride_tensor, data, stride_data, size, n_copies,
+            cudaMemcpyHostToDevice, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+static void ggml_backend_cuda_lazy_buffer_get_tensor_2d(ggml_backend_buffer_t buffer, const ggml_tensor * tensor,
+        void * data, size_t offset, size_t size, size_t n_copies, size_t stride_tensor, size_t stride_data) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    const size_t span = size + (n_copies > 0 ? (n_copies - 1)*stride_tensor : 0);
+    ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, tensor->data) + offset, span);
+
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemcpy2DAsync(data, stride_data, (const char *) tensor->data + offset, stride_tensor, size, n_copies,
+            cudaMemcpyDeviceToHost, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+static bool ggml_backend_cuda_lazy_buffer_cpy_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * src, ggml_tensor * dst) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    ggml_backend_buffer_t src_buf = src->view_src ? src->view_src->buffer : src->buffer;
+    if (src_buf == nullptr) {
+        return false;
+    }
+
+    const bool src_is_cuda = src_buf->buft == buffer->buft || ggml_backend_buft_is_cuda(src_buf->buft);
+    if (!src_is_cuda) {
+        return false;
+    }
+
+    ggml_backend_cuda_lazy_prepare(buffer, ggml_backend_cuda_lazy_offset(buffer, dst->data), ggml_nbytes(dst));
+    if (src_buf->buft == buffer->buft) {
+        ggml_backend_cuda_lazy_prepare(src_buf, ggml_backend_cuda_lazy_offset(src_buf, src->data), ggml_nbytes(src));
+    }
+
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemcpyAsync(dst->data, src->data, ggml_nbytes(src), cudaMemcpyDeviceToDevice, cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    return true;
+}
+
+static void ggml_backend_cuda_lazy_buffer_clear(ggml_backend_buffer_t buffer, uint8_t value) {
+    auto * ctx = (ggml_backend_cuda_lazy_buffer_context *) buffer->context;
+
+    if (ctx->mapped.empty()) {
+        return;
+    }
+
+    ggml_cuda_set_device(ctx->device);
+    for (const auto & iv : ctx->mapped) {
+        if (iv.second > iv.first) {
+            CUDA_CHECK(cudaMemsetAsync((void *) (ctx->ptr + iv.first), value, iv.second - iv.first, cudaStreamPerThread));
+        }
+    }
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
+
+static const ggml_backend_buffer_i ggml_backend_cuda_lazy_buffer_interface = {
+    /* .free_buffer     = */ ggml_backend_cuda_lazy_buffer_free_buffer,
+    /* .get_base        = */ ggml_backend_cuda_lazy_buffer_get_base,
+    /* .init_tensor     = */ ggml_backend_cuda_lazy_buffer_init_tensor,
+    /* .memset_tensor   = */ ggml_backend_cuda_lazy_buffer_memset_tensor,
+    /* .set_tensor      = */ ggml_backend_cuda_lazy_buffer_set_tensor,
+    /* .get_tensor      = */ ggml_backend_cuda_lazy_buffer_get_tensor,
+    /* .set_tensor_2d   = */ ggml_backend_cuda_lazy_buffer_set_tensor_2d,
+    /* .get_tensor_2d   = */ ggml_backend_cuda_lazy_buffer_get_tensor_2d,
+    /* .cpy_tensor      = */ ggml_backend_cuda_lazy_buffer_cpy_tensor,
+    /* .clear           = */ ggml_backend_cuda_lazy_buffer_clear,
+    /* .reset           = */ NULL,
+};
+
+static const char * ggml_backend_cuda_lazy_buffer_type_get_name(ggml_backend_buffer_type_t buft) {
+    ggml_backend_cuda_buffer_type_context * ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    return ctx->name.c_str();
+}
+
+static ggml_backend_buffer_t ggml_backend_cuda_lazy_buffer_type_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_cuda_buffer_type_context * buft_ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+
+    if (size == 0 || !ggml_cuda_info().devices[buft_ctx->device].vmm) {
+        return nullptr;
+    }
+
+    const size_t granularity = ggml_cuda_info().devices[buft_ctx->device].vmm_granularity;
+    if (granularity == 0) {
+        return nullptr;
+    }
+
+    const size_t reserved = ((size + granularity - 1) / granularity) * granularity;
+    if (reserved < size) {
+        return nullptr;
+    }
+
+    ggml_cuda_set_device(buft_ctx->device);
+
+    CUdeviceptr ptr = 0;
+    CUresult res = cuMemAddressReserve(&ptr, reserved, granularity, 0, 0);
+    if (res != CUDA_SUCCESS) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+
+    auto * ctx = new ggml_backend_cuda_lazy_buffer_context{buft_ctx->device, ptr, size, reserved, granularity, {}};
+
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_lazy_buffer_interface, ctx, size);
+}
+
+static size_t ggml_backend_cuda_lazy_buffer_type_get_alignment(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return 128;
+}
+
+static size_t ggml_backend_cuda_lazy_buffer_type_get_alloc_size(ggml_backend_buffer_type_t buft, const ggml_tensor * tensor) {
+    return ggml_backend_cuda_buffer_type_get_alloc_size(buft, tensor);
+}
+
+static const ggml_backend_buffer_type_i ggml_backend_cuda_lazy_buffer_type_interface = {
+    /* .get_name            = */ ggml_backend_cuda_lazy_buffer_type_get_name,
+    /* .alloc_buffer        = */ ggml_backend_cuda_lazy_buffer_type_alloc_buffer,
+    /* .alloc_buffer_n      = */ NULL,
+    /* .get_alignment       = */ ggml_backend_cuda_lazy_buffer_type_get_alignment,
+    /* .get_max_size        = */ NULL,
+    /* .get_alloc_size      = */ ggml_backend_cuda_lazy_buffer_type_get_alloc_size,
+    /* .get_alloc_size_n    = */ NULL,
+    /* .is_host             = */ NULL,
+};
+
+static ggml_backend_buffer_type_t ggml_backend_cuda_lazy_buffer_type(int device) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+
+    if (device < 0 || device >= ggml_backend_cuda_get_device_count()) {
+        return nullptr;
+    }
+
+    static ggml_backend_buffer_type bufts[GGML_CUDA_MAX_DEVICES];
+    static bool initialized = false;
+
+    if (!initialized) {
+        for (int i = 0; i < ggml_backend_cuda_get_device_count(); i++) {
+            bufts[i] = {
+                /* .iface   = */ ggml_backend_cuda_lazy_buffer_type_interface,
+                /* .device  = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), i),
+                /* .context = */ new ggml_backend_cuda_buffer_type_context{i, GGML_CUDA_NAME + std::to_string(i) + "_lazy"},
+            };
+        }
+        initialized = true;
+    }
+
+    return &bufts[device];
+}
+
+static ggml_backend_buffer_type_t ggml_backend_cuda_lazy_buffer_type_for_dev(ggml_backend_dev_t dev) {
+    const char * flag = getenv("GGML_KV_LAZY_VMM");
+    if (flag != nullptr && strcmp(flag, "0") == 0) {
+        return nullptr;
+    }
+
+    for (int i = 0; i < ggml_backend_cuda_get_device_count(); i++) {
+        if (ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), i) == dev) {
+            if (!ggml_cuda_info().devices[i].vmm) {
+                return nullptr;
+            }
+            return ggml_backend_cuda_lazy_buffer_type(i);
+        }
+    }
+
+    return nullptr;
+}
+
+static bool ggml_backend_buft_is_cuda_lazy(ggml_backend_buffer_type_t buft) {
+    return buft != nullptr && buft->iface.get_name == ggml_backend_cuda_lazy_buffer_type_get_name;
+}
+
+#else // VMM not available
+
+static ggml_backend_buffer_type_t ggml_backend_cuda_lazy_buffer_type_for_dev(ggml_backend_dev_t dev) {
+    GGML_UNUSED(dev);
+    return nullptr;
+}
+
+static void ggml_backend_cuda_lazy_prepare(ggml_backend_buffer_t buffer, size_t offset, size_t size) {
+    GGML_UNUSED(buffer);
+    GGML_UNUSED(offset);
+    GGML_UNUSED(size);
+}
+
+static bool ggml_backend_buft_is_cuda_lazy(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return false;
+}
