+static void ggml_cuda_expert_ring_disable(ggml_backend_cuda_context * cuda_ctx, const char * reason) {
+    for (size_t i = 0; i < GGML_CUDA_EXPERT_RING_SLOTS; ++i) {
+        if (cuda_ctx->expert_ring_events[i] != nullptr) {
+            (void)cudaEventDestroy(cuda_ctx->expert_ring_events[i]);
+            cuda_ctx->expert_ring_events[i] = nullptr;
+        }
+        if (cuda_ctx->expert_ring_slots[i] != nullptr) {
+            (void)cudaFreeHost(cuda_ctx->expert_ring_slots[i]);
+            cuda_ctx->expert_ring_slots[i] = nullptr;
+        }
+    }
+    cuda_ctx->expert_ring_state = -1;
+    (void)cudaGetLastError();
+    GGML_LOG_ERROR("%s: expert ring disabled (%s), staying on the pageable path\n", __func__, reason);
+}
+
+static bool ggml_cuda_expert_ring_env_enabled(void) {
+    const char * v = getenv("GGML_EXPERT_PINNED_RING");
+    return v != nullptr && v[0] != '\0' && strcmp(v, "0") != 0;
+}
+
+// allocates both slots and both events before any staged submission; on failure the ring stays disabled
+static bool ggml_cuda_expert_ring_init(ggml_backend_cuda_context * cuda_ctx) {
+    if (cuda_ctx->expert_ring_state != 0) {
+        return cuda_ctx->expert_ring_state == 1;
+    }
+    if (!ggml_cuda_expert_ring_env_enabled()) {
+        cuda_ctx->expert_ring_state = -1;
+        return false;
+    }
+
+    ggml_cuda_set_device(cuda_ctx->device);
+    if (getenv("GGML_EXPERT_RING_ALLOC_FAIL") != nullptr) {
+        ggml_cuda_expert_ring_disable(cuda_ctx, "fault injection");
+        return false;
+    }
+    for (size_t i = 0; i < GGML_CUDA_EXPERT_RING_SLOTS; ++i) {
+        if (cudaHostAlloc(&cuda_ctx->expert_ring_slots[i], GGML_CUDA_EXPERT_RING_SLOT_SIZE, cudaHostAllocDefault) != cudaSuccess) {
+            ggml_cuda_expert_ring_disable(cuda_ctx, "slot alloc failed");
+            return false;
+        }
+    }
+    for (size_t i = 0; i < GGML_CUDA_EXPERT_RING_SLOTS; ++i) {
+        if (cudaEventCreateWithFlags(&cuda_ctx->expert_ring_events[i], cudaEventDisableTiming) != cudaSuccess) {
+            ggml_cuda_expert_ring_disable(cuda_ctx, "event alloc failed");
+            return false;
+        }
+    }
+    cuda_ctx->expert_ring_state = 1;
+    GGML_LOG_WARN("%s: expert ring enabled: %zu pinned host slots x %.0f MiB\n", __func__,
+                 GGML_CUDA_EXPERT_RING_SLOTS, GGML_CUDA_EXPERT_RING_SLOT_SIZE / 1024.0 / 1024.0);
+    return true;
+}
+
+// stages one host->device copy through the bounded pinned ring: fill a free slot on the CPU
+// while the H2D of the other slot is still in flight; ranges larger than one slot are chunked
+static bool ggml_backend_cuda_set_tensor_async_pinned_ring(ggml_backend_t backend, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+
+    GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+
+    // host-side slot waits are illegal during capture, and replay must not keep staged pointers
+    cudaStreamCaptureStatus capture_status;
+    if (cudaStreamIsCapturing(cuda_ctx->stream(), &capture_status) != cudaSuccess || capture_status != cudaStreamCaptureStatusNone) {
+        (void)cudaGetLastError();
+        return false;
+    }
+
+    if (!ggml_cuda_expert_ring_init(cuda_ctx)) {
+        return false;
+    }
+
+    const uint8_t * src = (const uint8_t *) data;
+    size_t remaining = size;
+    size_t done = 0;
+    while (remaining > 0) {
+        const size_t chunk = std::min(remaining, GGML_CUDA_EXPERT_RING_SLOT_SIZE);
+        const size_t slot_idx = cuda_ctx->expert_ring_next;
+        cuda_ctx->expert_ring_next = (cuda_ctx->expert_ring_next + 1) % GGML_CUDA_EXPERT_RING_SLOTS;
+
+        // the slot must not be refilled before its in-flight H2D has completed
+        if (cuda_ctx->expert_ring_pending[slot_idx]) {
+            CUDA_CHECK(cudaEventSynchronize(cuda_ctx->expert_ring_events[slot_idx]));
+            cuda_ctx->expert_ring_pending[slot_idx] = false;
+        }
+        memcpy(cuda_ctx->expert_ring_slots[slot_idx], src + done, chunk);
+        CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset + done, cuda_ctx->expert_ring_slots[slot_idx],
+                                   chunk, cudaMemcpyHostToDevice, cuda_ctx->stream()));
+        CUDA_CHECK(cudaEventRecord(cuda_ctx->expert_ring_events[slot_idx], cuda_ctx->stream()));
+        cuda_ctx->expert_ring_pending[slot_idx] = true;
+
+        done      += chunk;
+        remaining -= chunk;
+    }
+
+    cuda_ctx->expert_ring_n_calls++;
+    cuda_ctx->expert_ring_n_chunks += (size + GGML_CUDA_EXPERT_RING_SLOT_SIZE - 1) / GGML_CUDA_EXPERT_RING_SLOT_SIZE;
+    return true;
+}
