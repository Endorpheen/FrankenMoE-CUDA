+static constexpr size_t GGML_CUDA_EXPERT_RING_SLOTS      = 2;
+static constexpr size_t GGML_CUDA_EXPERT_RING_SLOT_SIZE  = 16 * 1024 * 1024;
+
 struct ggml_backend_cuda_context {
     int device;
     std::string name;
     cudaEvent_t copy_event = nullptr;
 
+    // pinned host ring for staging MoE expert weights, owned by this context
+    void * expert_ring_slots[GGML_CUDA_EXPERT_RING_SLOTS] = { nullptr };
+    cudaEvent_t expert_ring_events[GGML_CUDA_EXPERT_RING_SLOTS] = { nullptr };
+    bool expert_ring_pending[GGML_CUDA_EXPERT_RING_SLOTS] = { false };
+    size_t expert_ring_next = 0;
+    // 0 = not initialized, 1 = active, -1 = disabled (alloc failed, stay on the pageable path)
+    int expert_ring_state = 0;
+    size_t expert_ring_n_calls = 0;
+    size_t expert_ring_n_chunks = 0;
+
     cudaStream_t streams[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = { { nullptr } };
     cublasHandle_t cublas_handles[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {nullptr};
     void * cublas_workspaces[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {nullptr};
