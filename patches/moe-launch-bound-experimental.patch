+static bool ggml_backend_cuda_moe_launch_bound_supported(ggml_backend_t backend) {
+    if (!ggml_backend_is_cuda(backend)) {
+        return false;
+    }
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    return ggml_cuda_info().devices[ctx->device].cc == GGML_CUDA_CC_ADA_LOVELACE;
+}
+
+static int ggml_backend_cuda_moe_launch_bound_granularity(ggml_backend_t backend, const ggml_tensor * node) {
+    if (!ggml_backend_cuda_moe_launch_bound_supported(backend) || !node ||
+        node->op != GGML_OP_MUL_MAT_ID || !node->src[0] || !node->src[2]) {
+        return 0;
+    }
+    const auto * weights = node->src[0];
+    const int64_t tokens = node->src[2]->ne[1];
+    if ((weights->type != GGML_TYPE_Q4_K && weights->type != GGML_TYPE_Q6_K) || tokens <= 128) {
+        return 0;
+    }
+    // A strict improvement over J=120 proves that the existing selector picks J=128.
+    if ((tokens + 127)/128 >= (tokens + 119)/120) {
+        return 0;
+    }
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    const auto & device = ggml_cuda_info().devices[ctx->device];
+    const auto config = ggml_cuda_mmq_get_config(weights->type, 128,
+        ggml_cuda_mmq_needs_fallback(weights->ne[1]), device.cc, GGML_PREC_Q8);
+    if (config.type == GGML_TYPE_COUNT || mmq_get_nbytes_shared(config, device.cc) > device.smpbo) {
+        return 0;
+    }
+    return 128;
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_moe_launch_bound_granularity_v1") == 0) {
+        return (void *) ggml_backend_cuda_moe_launch_bound_granularity;
+    }
+    if (strcmp(name, "ggml_backend_moe_launch_bound_supported_v1") == 0) {
+        return (void *) ggml_backend_cuda_moe_launch_bound_supported;
+    }
     if (strcmp(name, "ggml_backend_expert_pipeline_v1") == 0) {
         return (void *) ggml_backend_cuda_expert_pipeline;
     }
