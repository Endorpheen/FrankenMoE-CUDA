+#pragma once
+#include "../ggml/src/ggml-impl.h"
+
+static inline int32_t ggml_moe_launch_bound_value(const struct ggml_tensor * node, int32_t bound, int granularity) {
+    GGML_ASSERT(node->op == GGML_OP_MUL_MAT_ID);
+    if (bound <= 0 || granularity <= 0 || !node->src[2]) {
+        return 0;
+    }
+    const int64_t tokens = node->src[2]->ne[1];
+    const int64_t rounded = ((int64_t) bound + granularity - 1) / granularity * granularity;
+    if (bound > tokens || rounded > INT32_MAX) {
+        return 0;
+    }
+    return (int32_t) (rounded < tokens ? rounded : tokens);
+}
+
+static inline void ggml_moe_set_launch_bound(struct ggml_cgraph * graph, struct ggml_tensor * node,
+        int32_t bound, int granularity) {
+    const int32_t next = ggml_moe_launch_bound_value(node, bound, granularity);
+    if (node->op_params[4] != next) {
+        node->op_params[4] = next;
+        // Cache identity follows the effective tile grid, not irrelevant raw-count changes.
+        graph->uid = 0;
+    }
+}
