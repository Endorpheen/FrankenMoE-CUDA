+// --- EXP-045: two-thread CPU gather into the ring slots ----------------------
+// The calling thread and one persistent helper copy two disjoint halves of a large chunk
+// into the pinned slot (the split is rounded down to a cache line); both halves are always
+// complete before the H2D is submitted. Between chunks the helper blocks on a futex, so an
+// idle server pays no CPU for it. Chunks below the threshold keep the single memcpy.
+
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static constexpr size_t GGML_CUDA_EXPERT_RING_GATHER2T_MIN_CHUNK = 512 * 1024;
+
+static long ggml_cuda_futex_wait(std::atomic<uint32_t> * addr, uint32_t expected) {
+    return syscall(SYS_futex, (int *) addr, FUTEX_WAIT_PRIVATE, (int) expected, nullptr, nullptr, 0);
+}
+
+static long ggml_cuda_futex_wake(std::atomic<uint32_t> * addr) {
+    return syscall(SYS_futex, (int *) addr, FUTEX_WAKE_PRIVATE, 1, nullptr, nullptr, 0);
+}
+
+static void ggml_cuda_gather_helper_run(ggml_backend_cuda_context * cuda_ctx) {
+    uint64_t served = 0;
+    for (;;) {
+        const uint64_t seq = cuda_ctx->gather_seq.load(std::memory_order_acquire);
+        if (seq != served) {
+            const size_t head = cuda_ctx->gather_head;
+            const size_t tail = cuda_ctx->gather_tail;
+            if (tail > 0) {
+                memcpy(cuda_ctx->gather_dst + head, cuda_ctx->gather_src + head, tail);
+            }
+            served = seq;
+            cuda_ctx->gather_done.store(served, std::memory_order_release);
+            cuda_ctx->gather_done_w.store((uint32_t) served, std::memory_order_release);
+            ggml_cuda_futex_wake(&cuda_ctx->gather_done_w);
+            continue;
+        }
+        if (cuda_ctx->gather_quit.load(std::memory_order_acquire) != 0) {
+            return;
+        }
+        (void) ggml_cuda_futex_wait(&cuda_ctx->gather_seq_w, (uint32_t) served);
+    }
+}
+
+// on by default; set GGML_EXPERT_RING_GATHER2T=0 to keep the single-thread memcpy
+static bool ggml_cuda_gather2t_env_enabled(void) {
+    const char * v = getenv("GGML_EXPERT_RING_GATHER2T");
+    return v == nullptr || (v[0] != '\0' && strcmp(v, "0") != 0);
+}
+
+// started lazily on the first chunk large enough to be worth splitting
+static bool ggml_cuda_gather_helper_start(ggml_backend_cuda_context * cuda_ctx) {
+    if (cuda_ctx->gather_helper_state != 0) {
+        return cuda_ctx->gather_helper_state == 1;
+    }
+    if (!ggml_cuda_gather2t_env_enabled()) {
+        cuda_ctx->gather_helper_state = -1;
+        return false;
+    }
+    try {
+        cuda_ctx->gather_helper = std::thread(ggml_cuda_gather_helper_run, cuda_ctx);
+    } catch (...) {
+        cuda_ctx->gather_helper_state = -1;
+        GGML_LOG_WARN("%s: gather helper failed to start, staying on the single-thread memcpy\n", __func__);
+        return false;
+    }
+    cuda_ctx->gather_helper_state = 1;
+    return true;
+}
+
+// idempotent; must run before any ring slot is released
+static void ggml_cuda_gather_helper_stop(ggml_backend_cuda_context * cuda_ctx) {
+    if (cuda_ctx->gather_helper.joinable()) {
+        cuda_ctx->gather_quit.store(1, std::memory_order_release);
+        ggml_cuda_futex_wake(&cuda_ctx->gather_seq_w);
+        cuda_ctx->gather_helper.join();
+        cuda_ctx->gather_helper_state = -1;
+    }
+}
