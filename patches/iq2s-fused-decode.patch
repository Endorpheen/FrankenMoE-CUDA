+// must match hsum_float_8 in arch/x86/quants.c instruction-for-instruction:
+// the reduction tree differs from a double-hadd form by 1 ULP
+static inline float hsum_float_8_e46(const __m256 x) {
+    __m128 res = _mm256_extractf128_ps(x, 1);
+    res = _mm_add_ps(res, _mm256_castps256_ps128(x));
+    res = _mm_add_ps(res, _mm_movehl_ps(res, res));
+    res = _mm_add_ss(res, _mm_movehdup_ps(res));
+    return _mm_cvtss_f32(res);
+}
