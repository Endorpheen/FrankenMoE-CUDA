+                const float d = GGML_CPU_FP16_TO_FP32(xb->d);
+                const uint8_t * qs = xb->qs;
+                const uint8_t * qh = xb->qh;
+                const uint16_t * signs = (const uint16_t *)(xb->qs + QK_K/8);
