+static atomic_ullong g_iq2s_st[16]; // hist_group[4], hist_group_fused[4], hist_tokens[4], n_calls, n_window_open, n_fused_dispatch
+
+static void iq2s_fused_stats_count(int idx, unsigned long long v) {
+    if (iq2s_fused_stats_mode() == 1) {
+        atomic_fetch_add_explicit(&g_iq2s_st[idx], v, memory_order_relaxed);
+    }
+}
