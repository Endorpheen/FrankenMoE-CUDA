+
+// GGML_CPU_IQ2S_FUSED: unset or "0" -> off; any other value -> on.
+static int iq2s_fused_mode(void) {
+    static atomic_int mode = -1;
+    int m = atomic_load_explicit(&mode, memory_order_relaxed);
+    if (m < 0) {
+        const char * e = getenv("GGML_CPU_IQ2S_FUSED");
+        m = (e != NULL && *e != '\0' && strcmp(e, "0") != 0) ? 1 : 0;
+        atomic_store_explicit(&mode, m, memory_order_relaxed);
+    }
+    return m;
+}
+
+// GGML_CPU_IQ2S_FUSED_STATS: unset or "0" -> stats off; any other value -> on.
+// Counters are read-only diagnostics; both the increments and the atexit dump
+// are gated, so timed runs can keep the entire block disabled.
+static int iq2s_fused_stats_mode(void) {
+    static atomic_int mode = -1;
+    int m = atomic_load_explicit(&mode, memory_order_relaxed);
+    if (m < 0) {
+        const char * e = getenv("GGML_CPU_IQ2S_FUSED_STATS");
+        m = (e != NULL && *e != '\0' && strcmp(e, "0") != 0) ? 1 : 0;
+        atomic_store_explicit(&mode, m, memory_order_relaxed);
+    }
+    return m;
+}
