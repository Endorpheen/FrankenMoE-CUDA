+struct ggml_cuda_expert_pipeline {
+    struct slot {
+        ggml_backend_buffer_t buffer = nullptr;
+        cudaEvent_t ready = nullptr;
+        cudaEvent_t read_done = nullptr;
+        bool read_recorded = false;
+    } slots[2];
+    cudaStream_t upload = nullptr;
+    size_t capacity = 0;
+    std::unordered_map<const ggml_tensor *, unsigned> bindings;
+    const ggml_tensor * uploading = nullptr;
+    unsigned pending_reads = 0;
+    unsigned long long uploads = 0;
+
+    void release() {
+        if (upload) {
+            CUDA_CHECK(cudaStreamSynchronize(upload));
+        }
+        for (auto & s : slots) {
+            if (s.read_recorded) {
+                CUDA_CHECK(cudaEventSynchronize(s.read_done));
+            }
+            ggml_backend_buffer_free(s.buffer);
+            s.buffer = nullptr;
+            if (s.ready) {
+                CUDA_CHECK(cudaEventDestroy(s.ready));
+                CUDA_CHECK(cudaEventDestroy(s.read_done));
+            }
+            s.ready = nullptr;
+            s.read_done = nullptr;
+            s.read_recorded = false;
+        }
+        capacity = 0;
+        bindings.clear();
+        uploading = nullptr;
+        pending_reads = 0;
+    }
+
+    ~ggml_cuda_expert_pipeline() {
+        release();
+        if (upload) {
+            CUDA_CHECK(cudaStreamDestroy(upload));
+        }
+    }
+};
+
+static std::mutex ggml_cuda_expert_pipeline_mutex;
+static std::unordered_map<ggml_backend_cuda_context *, std::unique_ptr<ggml_cuda_expert_pipeline>> ggml_cuda_expert_pipelines;
+
+static ggml_cuda_expert_pipeline * ggml_cuda_expert_pipeline_get(ggml_backend_cuda_context * ctx, bool create = false) {
+    std::lock_guard<std::mutex> lock(ggml_cuda_expert_pipeline_mutex);
+    auto it = ggml_cuda_expert_pipelines.find(ctx);
+    if (it != ggml_cuda_expert_pipelines.end()) {
+        return it->second.get();
+    }
+    if (!create) {
+        return nullptr;
+    }
+    auto state = std::make_unique<ggml_cuda_expert_pipeline>();
+    auto * result = state.get();
+    ggml_cuda_expert_pipelines.emplace(ctx, std::move(state));
+    return result;
+}
+
+static bool ggml_backend_cuda_expert_pipeline(ggml_backend_t backend,
+        enum ggml_expert_pipeline_phase phase, const ggml_tensor * src,
+        ggml_tensor * dst, size_t * value) {
+    const char * env = getenv("GGML_EXPERT_OVERLAP");
+    if (env && atoi(env) == 0) {
+        return false;
+    }
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    if (phase == GGML_EXPERT_QUERY) {
+        if (!src || !dst || dst->data || dst->view_src || !src->data || !ggml_is_contiguous(src) ||
+            (src->type != GGML_TYPE_Q4_K && src->type != GGML_TYPE_Q6_K)) {
+            return false;
+        }
+        cudaPointerAttributes attributes = {};
+        cudaError_t err = cudaPointerGetAttributes(&attributes, src->data);
+        if (err != cudaSuccess) {
+            if (err == cudaErrorInvalidValue) {
+                cudaGetLastError();
+                return false;
+            }
+            CUDA_CHECK(err);
+        }
+        if (attributes.type != cudaMemoryTypeHost) {
+            return false;
+        }
+        *value = ggml_backend_buft_get_alloc_size(ggml_backend_cuda_buffer_type(ctx->device), dst);
+        return *value <= 256ULL*1024*1024;
+    }
+    auto * state = ggml_cuda_expert_pipeline_get(ctx, phase == GGML_EXPERT_RESERVE && *value > 0);
+    if (!state) {
+        return false;
+    }
+    if (phase == GGML_EXPERT_RESERVE) {
+        GGML_ASSERT(!state->uploading && !state->pending_reads);
+        CUDA_CHECK(cudaStreamSynchronize(ctx->stream()));
+        if (state->upload) {
+            CUDA_CHECK(cudaStreamSynchronize(state->upload));
+        }
+        state->bindings.clear();
+        if (*value == 0 || *value > 256ULL*1024*1024) {
+            state->release();
+            return false;
+        }
+        if (state->capacity < *value) {
+            state->release();
+            if (!state->upload) {
+                CUDA_CHECK(cudaStreamCreateWithFlags(&state->upload, cudaStreamNonBlocking));
+            }
+            for (auto & slot : state->slots) {
+                slot.buffer = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(ctx->device), *value);
+                if (!slot.buffer) {
+                    state->release();
+                    GGML_LOG_WARN("expert overlap: staging allocation failed, using original path\n");
+                    return false;
+                }
+                ggml_backend_buffer_set_usage(slot.buffer, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+                CUDA_CHECK(cudaEventCreateWithFlags(&slot.ready, cudaEventDisableTiming));
+                CUDA_CHECK(cudaEventCreateWithFlags(&slot.read_done, cudaEventDisableTiming));
+            }
+            state->capacity = *value;
+            GGML_LOG_INFO("expert overlap: two staging slots, total %.2f MiB\n", 2.0*state->capacity/(1024*1024));
+        }
+        return true;
+    }
+    if (phase == GGML_EXPERT_BIND) {
+        if (!state->capacity || !dst || dst->data || dst->view_src ||
+            ggml_backend_buffer_get_alloc_size(state->slots[0].buffer, dst) > state->capacity) {
+            return false;
+        }
+        unsigned slot_id = (*value)++ % 2;
+        auto & slot = state->slots[slot_id];
+        if (ggml_backend_tensor_alloc(slot.buffer, dst, ggml_backend_buffer_get_base(slot.buffer)) != GGML_STATUS_SUCCESS) {
+            return false;
+        }
+        state->bindings.emplace(dst, slot_id);
+        return true;
+    }
+    auto it = state->bindings.find(dst);
+    if (it == state->bindings.end()) {
+        return false;
+    }
+    auto & slot = state->slots[it->second];
+    if (phase == GGML_EXPERT_BEGIN) {
+        GGML_ASSERT(!state->uploading && !state->pending_reads);
+        if (slot.read_recorded) {
+            CUDA_CHECK(cudaStreamWaitEvent(state->upload, slot.read_done, 0));
+        }
+        size_t bytes = ggml_nbytes(dst);
+        size_t padded = ggml_backend_buffer_get_alloc_size(slot.buffer, dst);
+        if (padded > bytes) {
+            CUDA_CHECK(cudaMemsetAsync((char *) dst->data + bytes, 0, padded - bytes, state->upload));
+        }
+        state->uploading = dst;
+        state->pending_reads = 1U << it->second;
+        return true;
+    }
+    if (phase == GGML_EXPERT_END) {
+        GGML_ASSERT(state->uploading == dst);
+        CUDA_CHECK(cudaEventRecord(slot.ready, state->upload));
+        CUDA_CHECK(cudaStreamWaitEvent(ctx->stream(), slot.ready, 0));
+        state->uploading = nullptr;
+        ++state->uploads;
+        return true;
+    }
+    if (phase == GGML_EXPERT_CANCEL) {
+        CUDA_CHECK(cudaStreamSynchronize(state->upload));
+        state->uploading = nullptr;
+        return true;
+    }
+    return false;
+}
