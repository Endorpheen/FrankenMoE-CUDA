+#pragma once
+
+// In-process swap watchdog: stops the server when its own swap usage grows fast
+// or system swap I/O stays high. Linux only; start() is a no-op elsewhere.
+// Mirrors the external monitor in scripts/run_qwen38_server.sh.
+
+bool server_swap_watchdog_start();
