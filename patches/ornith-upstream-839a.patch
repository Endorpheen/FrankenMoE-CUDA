+                SRV_ERR("insufficient RAM headroom: %ld MiB available, %d GiB required (lower it with --ram-headroom-gib, or disable with --ram-headroom-gib 0)\n",
+                        available_kb / 1024, params.ram_headroom_gib);
+                return 1;
+            }
+            LOG_INF("RAM headroom: %ld MiB available, %d GiB required\n", available_kb / 1024, params.ram_headroom_gib);
+        }
+    }
+#endif
 
     llama_backend_init();
     llama_numa_init(params.numa);
