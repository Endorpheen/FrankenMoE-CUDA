+#include "common.h"
+#include "arg.h"
+#include "llama.h"
+#include "ggml-backend.h"
+#include "nlohmann/json.hpp"
+#include <openssl/evp.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool ok, const char * message) {
+    if (!ok) { throw std::runtime_error(message); }
+}
+
+static std::vector<uint8_t> state(llama_context * ctx, llama_state_seq_flags flags) {
+    std::vector<uint8_t> result(llama_state_seq_get_size_ext(ctx, 0, flags));
+    require(llama_state_seq_get_data_ext(ctx, result.data(), result.size(), 0, flags) == result.size(), "state read failed");
+    return result;
+}
+
+static std::string digest(const std::vector<uint8_t> & bytes) {
+    unsigned char hash[EVP_MAX_MD_SIZE];
+    unsigned int n = 0;
+    require(EVP_Digest(bytes.data(), bytes.size(), hash, &n, EVP_sha256(), nullptr) == 1, "SHA-256 failed");
+    const char hex[] = "0123456789abcdef";
+    std::string result;
+    for (unsigned int i = 0; i < n; ++i) { result += hex[hash[i] >> 4]; result += hex[hash[i] & 15]; }
+    return result;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        common_init();
+        common_params params;
+        require(common_params_parse(argc, argv, params, LLAMA_EXAMPLE_SERVER), "invalid parameters");
+        params.n_outputs_max = 1;
+        params.n_outputs_max_per_seq = 1;
+        llama_backend_init();
+        auto init = common_init_from_params(params);
+        auto * ctx = init->context();
+        require(ctx != nullptr, "context initialization failed");
+        const char * request_path = std::getenv("GGML_PREFIX_TEST_REQUEST");
+        std::ifstream file(request_path ? request_path : "results/exp082-ram-kv/request-32-cold.json");
+        require(file.good(), "request file could not be opened");
+        auto input = nlohmann::ordered_json::parse(file)["prompt"].get<std::vector<llama_token>>();
+        std::vector<int8_t> outputs(params.n_batch, 0);
+        auto prefill = [&](size_t first, size_t end) {
+            for (size_t i = first; i < end; i += params.n_batch) {
+                const auto count = std::min<size_t>(params.n_batch, end - i);
+                auto batch = llama_batch_get_one(input.data() + i, count);
+                batch.logits = outputs.data();
+                require(llama_decode(ctx, batch) == 0, "prefill failed");
+                std::cout << "prefilled through " << i + count << std::endl;
+            }
+        };
+        constexpr size_t prefix = 24576;
+        prefill(0, prefix);
+        auto partial = state(ctx, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+        const auto partial_before = digest(partial);
+        std::string full_before;
+        size_t full_bytes = 0;
+        {
+            auto full = state(ctx, LLAMA_STATE_SEQ_FLAGS_NONE);
+            full_bytes = full.size();
+            full_before = digest(full);
+        }
+        prefill(prefix, input.size());
+        require(llama_state_seq_set_data_ext(ctx, partial.data(), partial.size(), 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == partial.size(), "partial restore failed");
+        require(llama_memory_seq_rm(llama_get_memory(ctx), 0, prefix, -1), "sequence rewind failed");
+        const auto partial_after = digest(state(ctx, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
+        const auto full_after = digest(state(ctx, LLAMA_STATE_SEQ_FLAGS_NONE));
+        nlohmann::ordered_json result = {{"prefix_tokens", prefix}, {"full_state_bytes", full_bytes},
+                {"partial_state_bytes", partial.size()}, {"full_before", full_before}, {"full_after", full_after},
+                {"partial_before", partial_before}, {"partial_after", partial_after},
+                {"full_match", full_before == full_after}, {"partial_match", partial_before == partial_after}};
+        std::cout << result.dump() << std::endl;
+        require(full_before == full_after && partial_before == partial_after, "KV roundtrip mismatch");
+        init.reset();
+        llama_backend_free();
+        return 0;
+    } catch (const std::exception & e) {
+        std::cerr << "FAIL: " << e.what() << std::endl;
+        return 1;
+    }
+}
