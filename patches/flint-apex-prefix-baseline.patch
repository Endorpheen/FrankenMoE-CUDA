+        while (seed < points.size() && points[seed].n_tokens < batch) { ++seed; }
+        size_t result = points.size();
+        int64_t span = std::numeric_limits<int64_t>::max();
+        for (size_t i = 1; i + 1 < points.size(); ++i) {
+            if (i == seed) { continue; }
+            const auto width = points[i + 1].n_tokens - points[i - 1].n_tokens;
