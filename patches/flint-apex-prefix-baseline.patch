+struct server_prefix_checkpoint_policy {
+    struct point {
+        int64_t n_tokens;
+        int64_t pos_min;
+        int64_t pos_max;
+    };
+
+    bool enabled = true;
+    size_t limit_bytes = 256ull << 20;
+
+    static server_prefix_checkpoint_policy from_environment(bool recurrent = false) {
+        server_prefix_checkpoint_policy result;
+        if (recurrent) { result.limit_bytes = 2048ull << 20; }
+        const char * flag = std::getenv(recurrent ? "GGML_RECURRENT_PREFIX_CHECKPOINTS" : "GGML_SWA_PREFIX_CHECKPOINTS");
+        if (flag && std::strcmp(flag, "0") == 0) { result.enabled = false; }
+        const char * value = std::getenv(recurrent ? "GGML_RECURRENT_PREFIX_CHECKPOINT_MIB" : "GGML_SWA_PREFIX_CHECKPOINT_MIB");
+        if (value) {
+            char * end = nullptr;
+            errno = 0;
+            const auto mib = std::strtoull(value, &end, 10);
+            if (errno || value == end || *end || *value == '-' || mib > (recurrent ? 2048ull : 512ull)) {
+                result.enabled = false;
+            } else {
+                result.limit_bytes = static_cast<size_t>(mib) << 20;
+                result.enabled = result.enabled && mib > 0;
+            }
+        }
+        return result;
+    }
+
+    static bool supports(const std::string & architecture, bool has_swa, int slots,
+                         bool speculative, bool multimodal, bool adapters, bool hybrid = false) {
+        const bool supported = (architecture == "flint" && has_swa) || (architecture == "qwen35moe" && hybrid && !has_swa);
+        return supported && slots == 1 &&
+                !speculative && !multimodal && !adapters;
+    }
