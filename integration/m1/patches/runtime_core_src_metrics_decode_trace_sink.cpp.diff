 // A node name can carry anything ggml put there; commas and quotes would break the column count.
-void write_csv_field(std::FILE * f, const std::string & v) {
+// In the ON build the row encoders do this work themselves, so this function is only the
+// switch-off path — kept compiled so turning the flag off is a rebuild, not a revert.
+[[maybe_unused]] void write_csv_field(std::FILE * f, const std::string & v) {
+#ifdef FG_GOOSE_METRICS
+    // S1.4: the field text comes from the Goose encoder. Same predicate, same quote
+    // doubling, same newline-to-space substitution, same bytes; one std::string carrying
+    // the encoder's own length instead of a per-character fputc loop.
+    const std::string enc = fgmt::field_encode(v);
+    std::fwrite(enc.data(), 1, enc.size(), f);
+#else
     if (v.find_first_of(",\"\n") == std::string::npos) {
         std::fputs(v.c_str(), f);
         return;
@@ -27,6 +40,7 @@
         std::fputc(c == '\n' ? ' ' : c, f);
     }
     std::fputc('"', f);
+#endif
 }
 
