         for (size_t i = 0; i < n; ++i) {
             const ComputeTraceRow & r = rows[i];
+#ifdef FG_GOOSE_METRICS
+            // S1.4: the whole row (five integers, both escaped strings, the two counters and
+            // every separator) comes from the Goose encoder in the native print order.
+            const std::string line = fgmt::compute_row(r.turn, r.phase, r.step, r.seq, r.layer, r.op, r.name,
+                                                       r.wall_ns, r.majflt);
+            std::fwrite(line.data(), 1, line.size(), f_);
+#else
             std::fprintf(f_, "%d,%d,%d,%d,%d,", r.turn, r.phase, r.step, r.seq, r.layer);
             write_csv_field(f_, r.op);
             std::fputc(',', f_);
             write_csv_field(f_, r.name);
             std::fprintf(f_, ",%llu,%llu\n", (unsigned long long) r.wall_ns, (unsigned long long) r.majflt);
+#endif
         }
         std::fflush(f_); // once per decode, not per row
