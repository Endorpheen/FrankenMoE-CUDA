+#ifdef FG_GOOSE_RUNTIME
+// ============================ Goose quant stack: IQ table view ================================
+//
+// The composed Goose unit owns the arithmetic but not the IQ data: the grid
+// literals live in ggml-common.h and the neighbour tables are built at run
+// time by iq2xs_init_impl/iq3xs_init_impl. These accessors are the read-only
+// view the module is given, so the module and the native dequantizers read
+// the same bytes instead of carrying a second copy.
+//
+// Grid groups follow the native index convention:
+//   iq2: 0 = IQ2_XXS (256), 1 = IQ2_XS (512), 2 = IQ1_S/IQ1_M (2048),
+//        3 = IQ2_S (1024)
+//   iq3: 0 = IQ3_XXS (256), 1 = IQ3_S (512)
+//
+// The map/neighbour tables only exist after ggml_quantize_init() has built
+// them; the module needs them for its IQ quantize arms, which this stage does
+// not gate. Reaching them without init is a programming error and stops
+// loudly instead of returning a plausible wrong index.
+
+static void fg_goose_iq_table_missing(const char * what, int64_t g) {
+    fprintf(stderr, "fg-goose-quant: %s for group %lld is not initialised; "
+                    "call ggml_quantize_init() first\n", what, (long long) g);
+    abort();
+}
+
+int64_t fg_goose_iq2_grid(int64_t g, int64_t i) {
+    switch (g) {
+        case 0: return (int64_t) iq2xxs_grid[i];
+        case 1: return (int64_t) iq2xs_grid[i];
+        case 2: return (int64_t) iq1s_grid[i];
+        case 3: return (int64_t) iq2s_grid[i];
+        default: return 0;
+    }
+}
+
+int64_t fg_goose_iq3_grid(int64_t g, int64_t i) {
+    switch (g) {
+        case 0: return (int64_t) iq3xxs_grid[i];
+        case 1: return (int64_t) iq3s_grid[i];
+        default: return 0;
+    }
+}
+
+int64_t fg_goose_iq2_map(int64_t g, int64_t u) {
+    if (g < 0 || g > 3 || iq2_data[g].map == NULL) {
+        fg_goose_iq_table_missing("iq2 map", g);
+    }
+    return (int64_t) iq2_data[g].map[u];
+}
+
+int64_t fg_goose_iq2_nb(int64_t g, int64_t off) {
+    if (g < 0 || g > 3 || iq2_data[g].neighbours == NULL) {
+        fg_goose_iq_table_missing("iq2 neighbours", g);
+    }
+    return (int64_t) iq2_data[g].neighbours[off];
+}
+
+int64_t fg_goose_iq3_map(int64_t g, int64_t u) {
+    if (g < 0 || g > 1 || iq3_data[g].map == NULL) {
+        fg_goose_iq_table_missing("iq3 map", g);
+    }
+    return (int64_t) iq3_data[g].map[u];
+}
+
+int64_t fg_goose_iq3_nb(int64_t g, int64_t off) {
+    if (g < 0 || g > 1 || iq3_data[g].neighbours == NULL) {
+        fg_goose_iq_table_missing("iq3 neighbours", g);
+    }
+    return (int64_t) iq3_data[g].neighbours[off];
+}
+// The IQ table views of the merged unit (M1, P11-01).
+
+// ---- the IQ table provider handed to the merged unit at init ----------------
+//
+// The unit's 14 IQ entry points (qd_iq2_grid, qz_iq2_map, ...) are no longer
+// defined here. They live in host/goose_host.c and dispatch through the
+// descriptor below, which the runtime installs at start-up. The tables stay
+// file-static in this file, and the unit keeps no reference to ggml.
+//
+// ctx is unused for the CPU tables because they are process globals; it exists
+// so a second owner (a device-side table set, a gate's test double) can bind
+// its own provider without touching the unit or this file.
+
+#include "goose-iq-tables.h" // fg_goose_iq_tables, FG_GOOSE_IQ_TABLES_ABI
+
+static int64_t fg_goose_iq2_grid_ctx(void * ctx, int64_t g, int64_t i) {
+    (void) ctx;
+    return fg_goose_iq2_grid(g, i);
+}
+
+static int64_t fg_goose_iq3_grid_ctx(void * ctx, int64_t g, int64_t i) {
+    (void) ctx;
+    return fg_goose_iq3_grid(g, i);
+}
+
+static int64_t fg_goose_iq2_map_ctx(void * ctx, int64_t g, int64_t u) {
+    (void) ctx;
+    return fg_goose_iq2_map(g, u);
+}
+
+static int64_t fg_goose_iq2_nb_ctx(void * ctx, int64_t g, int64_t off) {
+    (void) ctx;
+    return fg_goose_iq2_nb(g, off);
+}
+
+static int64_t fg_goose_iq3_map_ctx(void * ctx, int64_t g, int64_t u) {
+    (void) ctx;
+    return fg_goose_iq3_map(g, u);
+}
+
+static int64_t fg_goose_iq3_nb_ctx(void * ctx, int64_t g, int64_t off) {
+    (void) ctx;
+    return fg_goose_iq3_nb(g, off);
+}
+
+static const fg_goose_iq_tables fg_goose_iq_tables_native_view = {
+    FG_GOOSE_IQ_TABLES_ABI,
+    (uint32_t) sizeof(fg_goose_iq_tables),
+    NULL,
+    fg_goose_iq2_grid_ctx,
+    fg_goose_iq3_grid_ctx,
+    fg_goose_iq2_map_ctx,
+    fg_goose_iq2_nb_ctx,
+    fg_goose_iq3_map_ctx,
+    fg_goose_iq3_nb_ctx,
+};
+
+const fg_goose_iq_tables * fg_goose_iq_tables_native(void) {
+    return &fg_goose_iq_tables_native_view;
+}
+
+#endif // FG_GOOSE_RUNTIME
