extern "route_raw" fn load(base: u64, index: i32) -> f32;
extern "route_soft_store" fn store(base: u64, index: i32, value: f32);
extern "route_max" fn maximum(a: f32, b: f32) -> f32;
extern "route_f32_xor" fn shuffle_f32(a: f32, delta: i32) -> f32;
extern "route_f64_xor" fn shuffle_f64(a: f64, delta: i32) -> f64;
extern "route_exponent" fn exponent(a: f32) -> f32;
extern "route_fail" fn fail();

export fn goose_router_softmax_256(input: u64, output: u64, scale: f32, lane: i32) {
    let score0 = load(input, lane + 0) * scale;
    let score1 = load(input, lane + 32) * scale;
    let score2 = load(input, lane + 64) * scale;
    let score3 = load(input, lane + 96) * scale;
    let score4 = load(input, lane + 128) * scale;
    let score5 = load(input, lane + 160) * scale;
    let score6 = load(input, lane + 192) * scale;
    let score7 = load(input, lane + 224) * scale;
    var peak = score0;
    peak = maximum(peak, score1);
    peak = maximum(peak, score2);
    peak = maximum(peak, score3);
    peak = maximum(peak, score4);
    peak = maximum(peak, score5);
    peak = maximum(peak, score6);
    peak = maximum(peak, score7);
    peak = maximum(peak, shuffle_f32(peak, 16));
    peak = maximum(peak, shuffle_f32(peak, 8));
    peak = maximum(peak, shuffle_f32(peak, 4));
    peak = maximum(peak, shuffle_f32(peak, 2));
    peak = maximum(peak, shuffle_f32(peak, 1));
    var sum: f64 = 0.0;
    let e0 = exponent(score0 - peak);
    sum += e0 as f64;
    let e1 = exponent(score1 - peak);
    sum += e1 as f64;
    let e2 = exponent(score2 - peak);
    sum += e2 as f64;
    let e3 = exponent(score3 - peak);
    sum += e3 as f64;
    let e4 = exponent(score4 - peak);
    sum += e4 as f64;
    let e5 = exponent(score5 - peak);
    sum += e5 as f64;
    let e6 = exponent(score6 - peak);
    sum += e6 as f64;
    let e7 = exponent(score7 - peak);
    sum += e7 as f64;
    sum += shuffle_f64(sum, 16);
    sum += shuffle_f64(sum, 8);
    sum += shuffle_f64(sum, 4);
    sum += shuffle_f64(sum, 2);
    sum += shuffle_f64(sum, 1);
    if !(sum > 0.0) { fail(); return; }
    let inv = (1.0 / sum) as f32;
    store(output, lane + 0, e0 * inv);
    store(output, lane + 32, e1 * inv);
    store(output, lane + 64, e2 * inv);
    store(output, lane + 96, e3 * inv);
    store(output, lane + 128, e4 * inv);
    store(output, lane + 160, e5 * inv);
    store(output, lane + 192, e6 * inv);
    store(output, lane + 224, e7 * inv);
}
