const NM_FTYPE_DEFAULT: const u8[:] = "unknown, may not work";
const NM_FTYPE_PREFIX: const u8[:] = "(guessed) ";

const NM_LOAD_N: i64 = 6;
const NM_LOAD_VAL: i64[6] = [
    -1,
    0,
    1,
