       rotated <= 0 || rotated > hd || rotated % 2 != 0 ||
       ff <= 0 || ff > 65536 || shared <= 0 || shared > 65536 || epsilon < 0 || base_freq < 0 || !(float_bits(base_freq) > 0.0) ||
       !(float_bits(base_freq) <= 3.4028234663852886e38) || scale < 0 || !(float_bits(scale) >= 0.0) || !(float_bits(scale) <= 3.4028234663852886e38) ||
       !mr_no_clamp(data, parsed, kv, kv_slots, "qwen35moe.swiglu_clamp_exp") ||
       !mr_no_clamp(data, parsed, kv, kv_slots, "qwen35moe.swiglu_clamp_shexp") { return -2; }
    if gr_lookup(data, parsed, kv, kv_slots, "qwen35moe.rope.scaling.type", 8, 2) >= 0 &&
       !mr_text(data, parsed, kv, kv_slots, "qwen35moe.rope.scaling.type", "none") { return -2; }
    if q35_gdn_config(head, nk, nv, kernel, epsilon, gdn) != 7 || inner != head * nv { return -2; }
    attn[0] = heads; attn[1] = hk; attn[2] = rotated; attn[3] = 40; attn[4] = original; attn[5] = epsilon; attn[6] = base_freq;
    attn[7] = 1065353216; attn[8] = 0; attn[9] = 1065353216; attn[10] = 1107296256; attn[11] = 1065353216;
    attn[12] = qg_positive_bits(1.0 / qg_sqrt(hd as f32)); attn[13] = 10;
    moe[0] = experts; moe[1] = used; moe[2] = scale;
    let rs: i64 = gr_lookup(data, parsed, kv, kv_slots, "qwen35moe.rope.dimension_sections", 8, 2);
    if rs < 0 || kv[rs * 8 + 2] != 9 || kv[rs * 8 + 5] != 4 { return -2; }
    var i: i64 = 0; var section_sum: i64 = 0;
    while i < 4 { if gr_array_int_impl(data, parsed, kv, rs, i, scratch) != 0 || scratch[0] < 0 || scratch[0] > rotated { return -2; } sections[i] = scratch[0]; section_sum += scratch[0]; i += 1; }
    if section_sum * 2 != rotated { return -2; }
    let flags: i64 = gr_lookup(data, parsed, kv, kv_slots, "qwen35moe.attention.recurrent_layers", 8, 2);
    let interval: i64 = mr_integer(data, parsed, kv, kv_slots, "qwen35moe.full_attention_interval", 4, scratch);
    if interval <= 0 || (flags >= 0 && (kv[flags * 8 + 2] != 9 || kv[flags * 8 + 3] != 7 || kv[flags * 8 + 5] < count)) { return -2; }
    let conv_elements: i64 = (kernel - 1) * head * (2 * nk + nv);
    let matrix_elements: i64 = head * head * nv;
    let cache_bytes: i64 = (hd * hk / 32) * 18 * capacity;
    if conv_elements > 9223372036854775807 / 4 || matrix_elements > 9223372036854775807 / 4 || cache_bytes > 9223372036854775807 / 2 { return -2; }
    let recurrent_bytes: i64 = (conv_elements + matrix_elements) * 4;
    var needed: i64 = 1048576; i = 0;
    while i < count {
        var kind: i64 = if (i + 1) % interval != 0 { 1 } else { 0 };
        if flags >= 0 { if gr_array_int_impl(data, parsed, kv, flags, i, scratch) != 0 { return -2; } kind = scratch[0]; }
        if kind != 0 && kind != 1 { return -2; }
        let bytes: i64 = if kind == 1 { recurrent_bytes } else { cache_bytes * 2 };
        if bytes > state_budget - needed { return -3; }
        needed += bytes; layers[i * 32] = kind; i += 1;
    }
    i = 0; while i < parsed[3] { scratch[4 + i] = 0; i += 1; }
    owner[3] = qo_context_new(8388608, 1);
    if owner[3] == 0 { return -3; }
    owner[4] = qo_context_new(needed, 0);
    if owner[4] == 0 { mr_close_contexts(owner); return -3; }
    handles[0] = mr_bind(data, parsed, tensors, tensor_slots, "token_embd.weight", owner[3], mapping, file_bytes, scratch[4 .. 4 + parsed[3]]);
    if gr_lookup(data, parsed, tensors, tensor_slots, "output.weight", 12, 3) < 0 { handles[1] = handles[0]; }
    else { handles[1] = mr_bind(data, parsed, tensors, tensor_slots, "output.weight", owner[3], mapping, file_bytes, scratch[4 .. 4 + parsed[3]]); }
    handles[2] = mr_bind(data, parsed, tensors, tensor_slots, "output_norm.weight", owner[3], mapping, file_bytes, scratch[4 .. 4 + parsed[3]]);
    if handles[0] == 0 || handles[1] == 0 || handles[2] == 0 { mr_close_contexts(owner); return -4; }
    let vocab: i64 = ne(handles[0], 1);
    if !qm_shape(handles[0], hidden, vocab, 1) || !qm_shape(handles[1], hidden, vocab, 1) ||
       !qm_shape(handles[2], hidden, 1, 1) || prop(handles[2], 0) != 0 || !mr_matrix_type(handles[0]) || !mr_matrix_type(handles[1]) { mr_close_contexts(owner); return -4; }
    var bound: i64 = if handles[0] == handles[1] { 2 } else { 3 };
    i = 0;
    while i < count {
        let row: i64 = i * 32; let kind: i64 = layers[row];
        var j: i64 = 1; while j < 32 { layers[row + j] = 0; j += 1; }
        let n: i64 = if kind == 1 { 11 } else { 8 }; j = 0;
        while j < n {
            let len: i64 = mr_name(i, mr_branch_name(kind, j), name_work);
            let weight: i64 = mr_bind(data, parsed, tensors, tensor_slots, name_work[0 .. len], owner[3], mapping, file_bytes, scratch[4 .. 4 + parsed[3]]);
            if weight == 0 { mr_close_contexts(owner); return -4; }
            layers[row + 1 + j] = weight; bound += 1; j += 1;
        }
        j = 0;
        while j < 8 {
            let len: i64 = mr_name(i, mr_moe_name(j), name_work);
            let weight: i64 = mr_bind(data, parsed, tensors, tensor_slots, name_work[0 .. len], owner[3], mapping, file_bytes, scratch[4 .. 4 + parsed[3]]);
            if weight == 0 { mr_close_contexts(owner); return -4; }
            layers[row + 12 + j] = weight; bound += 1; j += 1;
        }
        if !mr_layer_ok(layers[row .. row + 32], hidden, hd, attn, gdn, moe, ff, shared) { mr_close_contexts(owner); return -4; }
        if kind == 1 {
            layers[row + 20] = fresh(owner[4], 0, kernel - 1, head * (2 * nk + nv), 1, 1);
            layers[row + 21] = fresh(owner[4], 0, head, head, nv, 1);
            qo_tensor_zero(layers[row + 20]); qo_tensor_zero(layers[row + 21]);
        } else {
            layers[row + 22] = fresh(owner[4], 2, hd * hk, capacity, 1, 1);
            layers[row + 23] = fresh(owner[4], 2, hd * hk, capacity, 1, 1);
            if !qr_zero_host_kv(layers[row + 22]) || !qr_zero_host_kv(layers[row + 23]) { mr_close_contexts(owner); return -4; }
        }
        i += 1;
    }
    // Every file tensor must belong to this trunk or an explicitly skipped
    // MTP layer. Never turn an invalid/renamed output into a silent tied head.
    let skip_len: i64 = mr_name(count, "", name_work);
    i = 0;
    while i < parsed[3] {
        if scratch[4 + i] == 0 {
            let at: i64 = tensors[i * 12]; let n: i64 = tensors[i * 12 + 1];
            if mtp == 0 || n < skip_len || !gr_fits(data, at, n) || data[at .. at + skip_len] != name_work[0 .. skip_len] {
                mr_close_contexts(owner); return -4;
            }
        }
        i += 1;
    }
    // Native RoPE parameters read four I32 words. Keep them in model-owned
    // storage rather than requiring a caller's temporary native array.
    let rope_storage: i64 = fresh(owner[4], 26, 4, 1, 1, 1);
    let rope_bytes: u64 = qa_get(rope_storage, 4, 0);
    i = 0;
    while i < 4 {
        var j: i64 = 0;
        while j < 4 { qo_store_u8(rope_bytes + ((i * 4 + j) as u64), (sections[i] >> (8 * j)) & 255); j += 1; }
        i += 1;
    }
    handles[3] = rope_bytes as! i64;
    if q35_kv_init(capacity, 32, session) != 0 { mr_close_contexts(owner); return -4; }
    owner[1] = mapping as! i64; owner[2] = file_bytes; owner[5] = count; owner[6] = 0;
    owner[7] = hidden; owner[8] = ne(handles[0], 1); owner[9] += 1; owner[10] = capacity; owner[11] = bound;
    if owner.len > 12 { owner[12] = needed; }
    owner[0] = 9191;
    return count;
}

extern "fg_cuda_free_bytes" fn mr_cuda_free() -> i64;
extern "fg_cuda_load_dense" fn mr_cuda_load_dense(ranges: const i64[:], bytes: i64) -> i64;
extern "fg_cuda_model_state_startup_bytes" fn mr_cuda_state_startup_bytes() -> i64;
extern "fg_cuda_decode_graph_enabled" fn mr_cuda_decode_graph() -> bool;

fn mr_cuda_head_bytes(head: i64) -> i64 {
    let kind = prop(head, 0);
    return if kind == 0 || kind == 12 || kind == 14 {
        (qa_get(head, 1, 1) as i64) * ne(head, 1)
    } else { 0 };
}

fn mr_cuda_reserve(owner: const i64[:], head: i64) -> i64 {
    // Free device memory already excludes eager state, but includes the capacity
    // that lazy KV will consume as its physical pages are mapped.
    return owner[12] - mr_cuda_state_startup_bytes() + mr_cuda_head_bytes(head);
}

fn mr_cuda_dense_range(t: i64, owner: const i64[:], budget: i64, plan: i64[:],
                       position: i64, used: i64) -> i64 {
    if t == 0 || ne(t, 2) != 1 || ne(t, 3) != 1 { return 0; }
    let dtype = prop(t, 0);
    if dtype != 0 && dtype != 12 && dtype != 14 { return 0; }
    let address = qa_get(t, 4, 0);
    let base = owner[1] as! u64;
    let bytes = (qa_get(t, 1, 1) as i64) * ne(t, 1);
    if bytes <= 0 || address < base || address - base > (owner[2] as u64) ||
       (bytes as u64) > (owner[2] as u64) - (address - base) ||
       bytes > budget - used || position > plan.len - 3 {
        return 0;
    }
    plan[position] = address as! i64;
    plan[position + 1] = bytes;
    plan[position + 2] = used;
    return bytes;
}

// Persist the supported dense matrices in one device allocation. The expert
// planes remain in the same immutable RAM mapping until the cache admits them.
export fn qr_cuda_dense(owner: const i64[:], layers: const i64[:], head: i64, head_norm: i64) -> i64 {
    if owner.len < 13 || owner[0] != 9191 || layers.len / 32 < owner[5] || head == 0 {
        return -1;
    }
    let free = mr_cuda_free();
    if free <= 0 { return free; }
    // Leave room for model state and the largest streamed weight matrix even
    // if the GPU can only keep a subset of the dense tensors resident.
    let reserve = mr_cuda_reserve(owner, head);
    if free <= reserve { return 0; }
    let budget = free - reserve;
    let resident_inputs = mr_cuda_decode_graph();
    var plan: i64[>..] = [];
    plan.resize(3 * (if resident_inputs { 2 + 16 * owner[5] } else { 1 + 13 * owner[5] }), 0);
    var used: i64 = 0;
    var words: i64 = 0;
    let head_bytes = mr_cuda_dense_range(head, owner, budget, plan[..], words, used);
    if head_bytes > 0 { used += head_bytes; words += 3; }
    for layer in owner[5] {
        let base = layer * 32;
        let last = if layers[base] == 1 { 11 } else { 6 };
        for slot in 2 .. last {
            if layers[base] == 1 && slot > 5 && slot < 10 { continue; }
            let bytes = mr_cuda_dense_range(layers[base + slot], owner, budget, plan[..], words, used);
            if bytes > 0 { used += bytes; words += 3; }
        }
        let router = mr_cuda_dense_range(layers[base + 12], owner, budget, plan[..], words, used);
        if router > 0 { used += router; words += 3; }
        for slot in 16 .. 20 {
            let bytes = mr_cuda_dense_range(layers[base + slot], owner, budget, plan[..], words, used);
            if bytes > 0 { used += bytes; words += 3; }
        }
    }
    if resident_inputs {
        // Preserve the dense matrix placement order under tight device budgets.
        for layer in owner[5] {
            let base = layer * 32;
            let last = if layers[base] == 1 { 12 } else { 9 };
            for slot in 1 .. last {
                if (slot >= 2 && slot <= 5) || (layers[base] == 1 && slot == 10) { continue; }
                let at = used + (16 - used % 16) % 16;
                let bytes = mr_cuda_dense_range(layers[base + slot], owner, budget, plan[..], words, at);
                if bytes > 0 { used = at + bytes; words += 3; }
            }
        }
        let at = used + (16 - used % 16) % 16;
        let bytes = mr_cuda_dense_range(head_norm, owner, budget, plan[..], words, at);
        if bytes > 0 { used = at + bytes; words += 3; }
    }
    if used == 0 { return 0; }
    return mr_cuda_load_dense(plan[0 .. words], used);
}

export fn qr_model_close(owner: i64[:]) -> i64 {
    if owner.len < 12 || owner[0] != 9191 || owner[6] != 0 { return -1; }
    mr_close_contexts(owner); return 0;
}

// Frame4: magic9192,context,generation,model mapping identity. Never copy an
// active frame record. Close refuses stale/wrong-owner and double releases.
export fn qr_frame_open(owner: i64[:], arena_bytes: i64, frame: i64[:]) -> i64 {
    return qr_frame_open_mode(owner, arena_bytes, frame, 0);
}

fn qr_frame_open_mode(owner: i64[:], arena_bytes: i64, frame: i64[:], no_alloc: i64) -> i64 {
    if owner.len < 12 || owner[0] != 9191 || owner[6] < 0 || owner[6] == 9223372036854775807 ||
       frame.len < 4 || frame[0] != 0 || arena_bytes <= 0 || arena_bytes > 2147483647 { return 0; }
    let c: i64 = qo_context_new(arena_bytes, no_alloc); if c == 0 { return 0; }
    owner[6] += 1; frame[1] = c; frame[2] = owner[9]; frame[3] = owner[1]; frame[0] = 9192; return c;
}

export fn qr_frame_close(owner: i64[:], frame: i64[:]) -> i64 {
    if owner.len < 12 || owner[0] != 9191 || owner[6] <= 0 || frame.len < 4 || frame[0] != 9192 ||
       frame[2] != owner[9] || frame[3] != owner[1] { return -1; }
    let c: i64 = frame[1]; frame[0] = 0; frame[1] = 0; owner[6] -= 1; qo_context_free(c); return 0;
}

// ---- composed from goose/model/inkling2-loop-layout.goose ----
// The decoder visits shared weights by physical layer. KV and short-conv
// state are indexed by cache slot, including one slot per extra core visit.
const I2_VISIT_WORDS: i64 = 4;
const I2_MAX_LAYERS: i64 = 128;

fn i2_build_visits_impl(physical: i64, start: i64, end: i64, passes: i64, block_size: i64,
                          sliding: const i64[:], visits: i64[:]) -> i64 {
    if physical < 1 || physical > I2_MAX_LAYERS || start <= 0 || end <= start ||
       end > physical || passes < 2 || passes > I2_MAX_LAYERS || block_size < 1 ||
       start % block_size != 0 || end % block_size != 0 || sliding.len != physical { return -1; }

    let core = end - start;
    let count = physical + (passes - 1) * core;
    if count > I2_MAX_LAYERS || visits.len / I2_VISIT_WORDS < count { return -1; }
    for i in physical {
        if sliding[i] < 0 || sliding[i] > 1 { return -1; }
    }

    for i in count {
        var layer = i;
        var slot = i;
        var pass: i64 = -1;
        if i >= start && i < start + passes * core {
            pass = (i - start) / core;
            layer = start + (i - start) % core;
            slot = if pass == 0 { layer } else { physical + (pass - 1) * core + layer - start };
        } else if i >= start + passes * core {
            layer = i - (passes - 1) * core;
            slot = layer;
        }
        let at = i * I2_VISIT_WORDS;
        visits[at] = layer;
        visits[at + 1] = slot;
        visits[at + 2] = pass;
        visits[at + 3] = sliding[layer];
    }
    return count;
}

export fn i2_build_visits(physical: i64, start: i64, end: i64, passes: i64, block_size: i64,
                          sliding: const i64[:], visits: i64[:]) -> i64 {
    return i2_build_visits_impl(physical, start, end, passes, block_size, sliding, visits);
}

fn i2_find_key(data: const u8[:], state: i64[:], kv: i64[:], slots: i64[:],
               prefix: const u8[:], suffix: const u8[:]) -> i64 {
    var key: u8[96] = [0; 96];
    if prefix.len + suffix.len > key.len { return -1; }
    for i in prefix.len { key[i] = prefix[i]; }
    for i in suffix.len { key[prefix.len + i] = suffix[i]; }
    return gr_lookup(data, state, kv, slots, key[0 .. prefix.len + suffix.len], 8, 2);
}

fn i2_integer(data: const u8[:], state: i64[:], kv: i64[:], slots: i64[:],
              prefix: const u8[:], suffix: const u8[:], scratch: i64[:]) -> i64 {
    let id = i2_find_key(data, state, kv, slots, prefix, suffix);
    if gr_meta_int_impl(data, state, kv, id, scratch) != 0 { return -1; }
    return scratch[0];
}

// config: physical layers, core start/end, passes, gate rank, residual block size,
// sliding window, model capacity and execution visits.
export fn i2_read_layout(data: const u8[:], state: i64[:], kv: i64[:], slots: i64[:],
                         config: i64[:], visits: i64[:]) -> i64 {
    let legacy = mr_text(data, state, kv, slots, "general.architecture", "inkling2");
    if config.len < 9 || (!legacy && !mr_text(data, state, kv, slots, "general.architecture", "inkling2_loop")) {
        return -1;
    }
    let prefix = if legacy { "inkling2." } else { "inkling2_loop." };

    var scalar: i64[2] = [0; 2];
    let stored = i2_integer(data, state, kv, slots, prefix, "block_count", scalar);
    let start_key = if legacy { "loop.core_start" } else { "loop.start" };
    let end_key = if legacy { "loop.core_end" } else { "loop.end" };
    let pass_key = if legacy { "num_loops" } else { "loop.count" };
    let start = i2_integer(data, state, kv, slots, prefix, start_key, scalar);
    let end = i2_integer(data, state, kv, slots, prefix, end_key, scalar);
    let passes = i2_integer(data, state, kv, slots, prefix, pass_key, scalar);
    if stored < 1 || stored > I2_MAX_LAYERS || start < 1 || end <= start ||
       end > stored || passes < 2 || passes > I2_MAX_LAYERS { return -1; }
    let extra = (passes - 1) * (end - start);
    let physical = if legacy { stored - extra } else { stored };
    let rank = i2_integer(data, state, kv, slots, prefix, "loop.gate_rank", scalar);
    let block_size = i2_integer(data, state, kv, slots, prefix, "attn_res.block_size", scalar);
    let window = i2_integer(data, state, kv, slots, prefix, "attention.sliding_window", scalar);
    let capacity = i2_integer(data, state, kv, slots, prefix, "context_length", scalar);
    if physical < 1 || physical > I2_MAX_LAYERS || rank < 1 || window < 1 || capacity < window {
        return -1;
    }

    let pattern = i2_find_key(data, state, kv, slots, prefix, "attention.sliding_window_pattern");
    if gr_arr_n_impl(state, kv, pattern) != stored || kv[pattern * 8 + 3] != 7 {
        return -1;
    }
    var sliding: i64[128] = [0; 128];
    for i in physical {
        let logical = if legacy && i >= end { i + extra } else { i };
        if gr_array_int_impl(data, state, kv, pattern, logical, scalar) != 0 { return -1; }
        sliding[i] = scalar[0];
    }
    let count = i2_build_visits_impl(physical, start, end, passes, block_size, sliding[0 .. physical], visits);
    if count < 0 { return -1; }
    if legacy {
        if count != stored { return -1; }
        for i in count {
            let at = i * I2_VISIT_WORDS;
            if gr_array_int_impl(data, state, kv, pattern, i, scalar) != 0 ||
               scalar[0] != visits[at + 3] { return -1; }
            visits[at + 1] = i;
        }
    }

    config[0] = physical;
    config[1] = start;
    config[2] = end;
    config[3] = passes;
    config[4] = rank;
    config[5] = block_size;
    config[6] = window;
    config[7] = capacity;
    config[8] = count;
    return count;
}

// Weight bindings point at validated GGUF tensor records. They do not own
// memory. Type checks here qualify the selected AD-IQ4_XS text checkpoint.
const I2_TEXT_GLOBALS: i64 = 5;
const I2_TEXT_LAYER_WEIGHTS: i64 = 10;

fn i2_expected_tensor(data: const u8[:], state: i64[:], tensors: i64[:], slots: i64[:], name: const u8[:],
                      kind: i64, n0: i64, n1: i64, n2: i64) -> i64 {
    let id = gr_lookup(data, state, tensors, slots, name, 12, 3);
    if id < 0 { return -1; }
    let base = 12 * id;
    if tensors[base + 2] != kind || tensors[base + 4] != n0 || tensors[base + 5] != n1 ||
       tensors[base + 6] != n2 || tensors[base + 7] != 1 { return -1; }
    return id;
}

export fn i2_bind_text_weights(data: const u8[:], state: i64[:], kv: i64[:], kv_slots: i64[:],
                              tensors: i64[:], tensor_slots: i64[:], layout: const i64[:],
                              globals: i64[:], layers: i64[:]) -> i64 {
    let legacy = mr_text(data, state, kv, kv_slots, "general.architecture", "inkling2");
    if layout.len < 9 || globals.len < I2_TEXT_GLOBALS ||
       (!legacy && !mr_text(data, state, kv, kv_slots, "general.architecture", "inkling2_loop")) { return -1; }

    let prefix = if legacy { "inkling2." } else { "inkling2_loop." };
    var scratch: i64[2] = [0; 2];
    let stored = i2_integer(data, state, kv, kv_slots, prefix, "block_count", scratch);
    let physical = layout[0];
    if physical < 1 || physical > I2_MAX_LAYERS || stored < physical || stored > I2_MAX_LAYERS ||
       stored != (if legacy { layout[8] } else { physical }) || layout[2] < 1 || layout[2] > physical ||
       layers.len / I2_TEXT_LAYER_WEIGHTS < physical { return -1; }
    let width = i2_integer(data, state, kv, kv_slots, prefix, "embedding_length", scratch);
    let vocabulary = i2_integer(data, state, kv, kv_slots, prefix, "vocab_size", scratch);
    let experts = i2_integer(data, state, kv, kv_slots, prefix, "expert_count", scratch);
    let keep = i2_integer(data, state, kv, kv_slots, prefix, "expert_used_count", scratch);
    let ff = i2_integer(data, state, kv, kv_slots, prefix, "expert_feed_forward_length", scratch);
    let key_width = i2_integer(data, state, kv, kv_slots, prefix, "attention.key_length", scratch);
    let value_width = i2_integer(data, state, kv, kv_slots, prefix, "attention.value_length", scratch);
    if width != 2304 || vocabulary != 201024 || experts != 128 || keep != 8 || ff != 1152 ||
       key_width != 128 || value_width != 128 { return -1; }
    let q_heads_key = i2_find_key(data, state, kv, kv_slots, prefix, "attention.head_count");
    let kv_heads_key = i2_find_key(data, state, kv, kv_slots, prefix, "attention.head_count_kv");
    if gr_arr_n_impl(state, kv, q_heads_key) != stored || gr_arr_n_impl(state, kv, kv_heads_key) != stored {
        return -1;
    }

    globals[0] = i2_expected_tensor(data, state, tensors, tensor_slots, "token_embd.weight", 8, width, vocabulary, 1);
    globals[1] = i2_expected_tensor(data, state, tensors, tensor_slots, "token_embd_norm.weight", 0, width, 1, 1);
    globals[2] = i2_expected_tensor(data, state, tensors, tensor_slots, "output.weight", 8, width, vocabulary, 1);
    globals[3] = i2_expected_tensor(data, state, tensors, tensor_slots, "output_norm.weight", 0, width, 1, 1);
    globals[4] = i2_expected_tensor(data, state, tensors, tensor_slots, "output_res_query.weight", 0, width, 1, 1);
    for i in I2_TEXT_GLOBALS { if globals[i] < 0 { return -1; } }

    var name: u8[96] = [0; 96];
    for layer in physical {
        let logical = if legacy && layer >= layout[2] { layer + stored - physical } else { layer };
        if gr_array_int_impl(data, state, kv, q_heads_key, logical, scratch) != 0 || scratch[0] != 24 {
            return -1;
        }
        if gr_array_int_impl(data, state, kv, kv_heads_key, logical, scratch) != 0 || scratch[0] != 8 {
            return -1;
        }
        let q_width = 24 * key_width;
        let kv_width = 8 * key_width;
        for i in I2_TEXT_LAYER_WEIGHTS {
            let suffix = if i == 0 { "attn_q.weight" }
                else if i == 1 { "attn_k.weight" }
                else if i == 2 { "attn_v.weight" }
                else if i == 3 { "attn_output.weight" }
                else if i == 4 { "attn_gate.weight" }
                else if i == 5 { "ffn_gate_inp.weight" }
                else if i == 6 { "ffn_gate_up_exps.weight" }
                else if i == 7 { "ffn_down_exps.weight" }
                else if i == 8 { "exp_probs_b.bias" }
                else { "ffn_norm.weight" };
            let name_size = mr_name(layer, suffix, name);
            if name_size < 0 { return -1; }
            let kind = if i < 5 { 8 } else if i == 6 { 23 } else if i == 7 { 20 } else { 0 };
            let n0 = if i == 3 { q_width } else if i == 7 { ff } else if i == 8 { experts } else { width };
            let n1 = if i == 0 || i == 4 { q_width }
                else if i == 1 || i == 2 { kv_width }
                else if i == 3 || i == 7 { width }
                else if i == 5 { experts }
                else if i == 6 { 2 * ff }
                else { 1 };
            let n2 = if i == 6 || i == 7 { experts } else { 1 };
            let id = i2_expected_tensor(data, state, tensors, tensor_slots, name[0 .. name_size], kind, n0, n1, n2);
            if id < 0 { return -1; }
            layers[I2_TEXT_LAYER_WEIGHTS * layer + i] = id;
        }
    }
    return physical;
}

// Canonical Inkling auxiliaries: shared convolution and relative attention,
// optional residual query, local/global input paths, and loop controllers.
// Each physical layer gets 30 slots; -1 denotes an inapplicable tensor.
const I2_TEXT_AUX_WEIGHTS: i64 = 30;

export fn i2_bind_text_aux(data: const u8[:], state: i64[:], kv: i64[:], kv_slots: i64[:],
                         tensors: i64[:], tensor_slots: i64[:], layout: const i64[:],
                         layers: i64[:]) -> i64 {
    if layout.len < 9 || layout[0] != 24 || layout[1] != 6 || layout[2] != 18 || layout[4] != 64 ||
       layers.len / I2_TEXT_AUX_WEIGHTS < layout[0] ||
       !mr_text(data, state, kv, kv_slots, "general.architecture", "inkling2_loop") { return -1; }
    let pattern = gr_lookup(data, state, kv, kv_slots, "inkling2_loop.attention.sliding_window_pattern", 8, 2);
    if gr_arr_n_impl(state, kv, pattern) != layout[0] || kv[pattern * 8 + 3] != 7 { return -1; }
    var scratch: i64[2] = [0; 2];
    var name: u8[96] = [0; 96];
    for layer in layout[0] {
        if gr_array_int_impl(data, state, kv, pattern, layer, scratch) != 0 { return -1; }
        let sliding = scratch[0] != 0;
        let core = layer >= layout[1] && layer < layout[2];
        for i in I2_TEXT_AUX_WEIGHTS {
            let at = layer * I2_TEXT_AUX_WEIGHTS + i;
            layers[at] = -1;
            if (i == 10 && layer == 0) || (i == 11 && !sliding) ||
               (i >= 12 && i < 17 && sliding) || (i >= 17 && !core) { continue; }
            let suffix = if i == 0 { "attn_k_conv.weight" }
            else if i == 1 { "attn_v_conv.weight" }
            else if i == 2 { "attn_post_conv.weight" }
            else if i == 3 { "ffn_post_conv.weight" }
            else if i == 4 { "attn_q_clip.weight" }
            else if i == 5 { "attn_rel.weight" }
            else if i == 6 { "attn_rel_bias.weight" }
            else if i == 7 { "attn_rel_clip.weight" }
            else if i == 8 { "attn_sink_proj.weight" }
            else if i == 9 { "ffn_res_query.weight" }
            else if i == 10 { "attn_res_query.weight" }
            else if i == 11 { "attn_norm.weight" }
            else if i == 12 { "attn_q_inp_norm.weight" }
            else if i == 13 { "attn_k_inp_norm.weight" }
            else if i == 14 { "attn_v_inp_norm.weight" }
            else if i == 15 { "attn_k_conv_proj.weight" }
            else if i == 16 { "attn_v_conv_proj.weight" }
            else if i == 17 { "loop_msg_query.weight" }
            else if i == 18 { "loop_q_ctrl_down.weight" }
            else if i == 19 { "loop_q_ctrl_forget.weight" }
            else if i == 20 { "loop_q_ctrl_gain.weight" }
            else if i == 21 { "loop_k_ctrl_down.weight" }
            else if i == 22 { "loop_k_ctrl_forget.weight" }
            else if i == 23 { "loop_k_ctrl_gain.weight" }
            else if i == 24 { "loop_v_ctrl_down.weight" }
            else if i == 25 { "loop_v_ctrl_forget.weight" }
            else if i == 26 { "loop_v_ctrl_gain.weight" }
            else if i == 27 { "loop_ffn_ctrl_down.weight" }
            else if i == 28 { "loop_ffn_ctrl_forget.weight" }
            else { "loop_ffn_ctrl_gain.weight" };
            let kind = if i == 0 || i == 1 || i == 2 || i == 3 || i == 4 || i == 6 || i == 7 || i == 9 || i == 10 || i == 11 || i == 12 || i == 13 || i == 14 || i == 17 { 0 }
            else { 8 };
            let n0 = if i == 0 || i == 1 || i == 2 || i == 3 { 4 }
            else if i == 4 { 128 }
            else if i == 5 || i == 8 || i == 9 || i == 10 || i == 11 || i == 12 || i == 13 || i == 14 || i == 15 || i == 16 || i == 17 { 2304 }
            else if i == 6 || i == 7 { 16 }
            else if i == 18 || i == 21 || i == 24 || i == 27 { 4608 }
            else { 64 };
            let n1 = if i == 0 || i == 1 || i == 6 { 1024 }
            else if i == 2 || i == 3 || i == 19 || i == 20 || i == 22 || i == 23 || i == 25 || i == 26 || i == 28 || i == 29 { 2304 }
            else if i == 4 || i == 7 || i == 8 { 24 }
            else if i == 5 { 384 }
            else if i == 9 || i == 11 || i == 12 || i == 13 || i == 14 { 1 }
            else if i == 10 { (if sliding { 1 } else { 3 }) }
            else if i == 15 || i == 16 { 32 }
            else if i == 17 { 4 }
            else { 64 };
            let size = mr_name(layer, suffix, name);
            if size < 0 { return -1; }
            let id = i2_expected_tensor(data, state, tensors, tensor_slots, name[0 .. size], kind, n0, n1, 1);
            if id < 0 { return -1; }
            layers[at] = id;
        }
    }
    return layout[0];
}

// ---- composed from goose/model/inkling2-situ.goose ----
extern "tanhf" fn i2_tanh(value: f32) -> f32;
extern "expf" fn i2_exp(value: f32) -> f32;

// Match the reference SiTU graph's FP32 stage order. The caller provides
// separate or elementwise-identical buffers, as for the other unary kernels.
export fn i2_situ(gate: const f32[:], up: const f32[:], beta: f32, linear_beta: f32, out: f32[:]) -> i64 {
    if gate.len != up.len || out.len < gate.len || !(beta > 0.0) || !(linear_beta >= 0.0) ||
       beta > 3.4028234663852886e38 || linear_beta > 3.4028234663852886e38 { return -1; }

    let gate_scale: f32 = 1.0 / beta;
    let up_scale: f32 = if linear_beta > 0.0 { 1.0 / linear_beta } else { 0.0 };
    for i in gate.len {
        let gate_activation = i2_tanh(gate[i] * gate_scale) * beta;
        let gate_sigmoid: f32 = 1.0 / (1.0 + i2_exp(-gate[i]));
        let activated = gate_activation * gate_sigmoid;
        let up_activation = if linear_beta > 0.0 { i2_tanh(up[i] * up_scale) * linear_beta } else { up[i] };
        out[i] = activated * up_activation;
    }
    return gate.len;
}

// ---- composed from goose/model/inkling2-attention-ops.goose ----
extern "sqrtf" fn i2_sqrt(value: f32) -> f32;

// Produce gather indices into the learned relative-bias table. The final
// row is reserved for empty cells, future keys and out-of-range distances.
export fn i2_relative_positions(query: i64, keys: const i64[:], extent: i64, out: i32[:]) -> i64 {
    if query < 0 || extent < 1 || extent > 2147483647 || out.len < keys.len { return -1; }
    for i in keys.len {
        let key = keys[i];
        var relative = extent;
        if key >= 0 && key <= query {
            let distance = query - key;
            if distance < extent { relative = distance; }
        }
        out[i] = relative as i32;
    }
    return keys.len;
}

// Decode combines the existing depthwise convolution with per-head dynamic
// taps. Histories are oldest to newest, three values per channel. The tap
// vector has four entries per head, starting with the current token.
fn i2_shortconv_decode_impl(current: const f32[:], past: const f32[:], static_conv: const f32[:],
                              taps: const f32[:], out: f32[:]) -> i64 {
    let channels = current.len;
    if channels <= 0 || channels > 2147483647 || past.len != 3 * channels ||
       static_conv.len != channels || out.len < channels || taps.len % 4 != 0 { return -1; }
    let heads = taps.len / 4;
    if heads > 0 && channels % heads != 0 { return -1; }
    let scale: f32 = if heads == 0 { 1.0 / i2_sqrt(5.0) } else { 1.0 / i2_sqrt(9.0) };
    let group = if heads == 0 { 1 } else { channels / heads };
    for i in channels {
        var mixed = static_conv[i];
        if heads > 0 {
            let tap = (i / group) * 4;
            let history = 3 * i;
            mixed += current[i] * taps[tap];
            mixed += past[history + 2] * taps[tap + 1];
            mixed += past[history + 1] * taps[tap + 2];
            mixed += past[history] * taps[tap + 3];
        }
        out[i] = (current[i] + mixed) * scale;
    }
    return channels;
}

extern "expf" fn i2_attn_exp(value: f32) -> f32;

fn i2_attention_dot(a: const f32[:], b: const f32[:]) -> f32 {
    var sum: f64 = 0.0;
    for i in a.len {
        let product: f32 = a[i] * b[i];
        sum += product as f64;
    }
    return sum as f32;
}

// Scalar one-token attention for the Inkling text layout. Inputs are the
// projected, clipped Q/K and normalized V. Relative vectors include the
// model's position scaling for this query. Cache rows may be in any order.
fn i2_attention_decode_impl(query: const f32[:], keys: const f32[:], values: const f32[:],
                               relative: const f32[:], bias: const f32[:], sink: const f32[:],
                               positions: const i64[:], absolute: i64, window: i64,
                               scratch: f32[:], output: f32[:]) -> i64 {
    let heads: i64 = 24;
    let kv_heads: i64 = 8;
    let head_width: i64 = 128;
    let relative_width: i64 = 16;
    let relative_extent: i64 = 1024;
    let rows = positions.len;
    let q_size = heads * head_width;
    let kv_row = kv_heads * head_width;
    if absolute < 0 || window < 0 || rows < 1 || rows > 1048576 || scratch.len < rows ||
       query.len != q_size || output.len < q_size || relative.len != heads * relative_width ||
       bias.len != relative_width * relative_extent || sink.len != heads ||
       keys.len != rows * kv_row || values.len != keys.len { return -1; }

    let qk_scale: f32 = 1.0 / i2_sqrt(128.0);
    for head in heads {
        let q_at = head * head_width;
        let r_at = head * relative_width;
        let kv_at = (head / (heads / kv_heads)) * head_width;
        var maximum: f32 = 0.0;
        for row in rows {
            let k = row * kv_row + kv_at;
            let position = positions[row];
            var logit = float_bits(4286578688);
            if position >= 0 && position <= absolute {
                let distance = absolute - position;
                if window == 0 || distance < window {
                    var relative_score: f32 = 0.0;
                    if distance < relative_extent {
                        let b = distance * relative_width;
                        relative_score = i2_attention_dot(relative[r_at .. r_at + relative_width],
                            bias[b .. b + relative_width]);
                    }
                    let qk = i2_attention_dot(query[q_at .. q_at + head_width], keys[k .. k + head_width]);
                    logit = qk * qk_scale + (relative_score - sink[head]);
                }
            }
            scratch[row] = logit;
            if logit > maximum { maximum = logit; }
        }

        var total: f64 = i2_attn_exp(-maximum) as f64;
        for row in rows {
            let weight = i2_attn_exp(scratch[row] - maximum);
            total += weight as f64;
            scratch[row] = weight;
        }
        let inverse: f32 = 1.0 / (total as f32);
        for row in rows { scratch[row] *= inverse; }

        for channel in head_width {
            var value: f64 = 0.0;
            for row in rows {
                let product: f32 = scratch[row] * values[row * kv_row + kv_at + channel];
                value += product as f64;
            }
            output[q_at + channel] = value as f32;
        }
    }
    return q_size;
}

export fn i2_shortconv_decode(current: const f32[:], past: const f32[:], static_conv: const f32[:],
                              taps: const f32[:], out: f32[:]) -> i64 {
    return i2_shortconv_decode_impl(current, past, static_conv, taps, out);
}

export fn i2_attention_decode(query: const f32[:], keys: const f32[:], values: const f32[:],
                               relative: const f32[:], bias: const f32[:], sink: const f32[:],
                               positions: const i64[:], absolute: i64, window: i64,
                               scratch: f32[:], output: f32[:]) -> i64 {
    return i2_attention_decode_impl(query, keys, values, relative, bias, sink, positions, absolute, window, scratch, output);
}

// ---- composed from goose/model/inkling2-kv.goose ----
// Each record is indexed by cache slot and contains its row capacity and
// K, V and short-convolution offsets. Local slots use a bounded ring.
const I2_KV_WORDS: i64 = 4;
const I2_MAX_CONTEXT: i64 = 1048576;
const I2_CACHE_ALIGNMENT: i64 = 32;

fn i2_cache_span(raw: i64) -> i64 {
    return ((raw + I2_CACHE_ALIGNMENT - 1) / I2_CACHE_ALIGNMENT) * I2_CACHE_ALIGNMENT;
}

export fn i2_cache_layout(visits: const i64[:], count: i64, capacity: i64, window: i64,
                          key_bytes: i64, value_bytes: i64, history_bytes: i64, slots: i64[:]) -> i64 {
    if count < 1 || count > 128 || visits.len / 4 < count || slots.len / I2_KV_WORDS < count ||
       capacity < 1 || capacity > I2_MAX_CONTEXT || window < 1 || window > I2_MAX_CONTEXT ||
       key_bytes < 1 || key_bytes > 1048576 || value_bytes < 1 || value_bytes > 1048576 ||
       history_bytes < 0 || history_bytes > 1048576 { return -1; }

    var seen: i64[128] = [0; 128];
    for visit in count {
        let slot = visits[visit * 4 + 1];
        let sliding = visits[visit * 4 + 3];
        if slot < 0 || slot >= count || seen[slot] != 0 || sliding < 0 || sliding > 1 { return -1; }
        seen[slot] = 1;
    }

    var next: i64 = 0;
    for visit in count {
        let slot = visits[visit * 4 + 1];
        let sliding = visits[visit * 4 + 3] != 0;
        let rows = if sliding && window < capacity { window } else { capacity };
        let at = slot * I2_KV_WORDS;
        slots[at] = rows;
        slots[at + 1] = next;
        next += i2_cache_span(rows * key_bytes);
        slots[at + 2] = next;
        next += i2_cache_span(rows * value_bytes);
        slots[at + 3] = next;
        next += i2_cache_span(history_bytes);
    }
    return next;
}

// Resolve a committed absolute token position to its physical row.
fn i2_cache_row_impl(position: i64, capacity: i64, rows: i64, sliding: bool) -> i64 {
    if position < 0 || capacity < 1 || capacity > I2_MAX_CONTEXT || position >= capacity ||
       rows < 1 || rows > capacity || (!sliding && rows != capacity) { return -1; }
    return if sliding { position % rows } else { position };
}

export fn i2_cache_row(position: i64, capacity: i64, rows: i64, sliding: bool) -> i64 {
    return i2_cache_row_impl(position, capacity, rows, sliding);
}

export fn i2_reset_cache_positions(positions: i64[:]) {
    for row in positions.len { positions[row] = -1; }
}

// Bind the new key and value before publishing its position. The caller
// serializes the text stream and supplies one model-visit cache slot.
fn i2_store_kv_impl(position: i64, capacity: i64, sliding: bool, positions: i64[:],
                      key: const f32[:], value: const f32[:], keys: f32[:], values: f32[:]) -> i64 {
    let rows = positions.len;
    let row = i2_cache_row_impl(position, capacity, rows, sliding);
    if row < 0 || key.len < 1 || value.len < 1 || keys.len % rows != 0 ||
       values.len % rows != 0 || keys.len / rows != key.len || values.len / rows != value.len {
        return -1;
    }
    let key_at = row * key.len;
    for i in key.len { keys[key_at + i] = key[i]; }
    let value_at = row * value.len;
    for i in value.len { values[value_at + i] = value[i]; }
    positions[row] = position;
    return row;
}

export fn i2_store_kv(position: i64, capacity: i64, sliding: bool, positions: i64[:],
                      key: const f32[:], value: const f32[:], keys: f32[:], values: f32[:]) -> i64 {
    return i2_store_kv_impl(position, capacity, sliding, positions, key, value, keys, values);
}

// ---- composed from goose/model/inkling2-loop-ops.goose ----
// Mix the ordered residual blocks for each learned query. Each block row
// is independently RMS-normalized before forming scores and output values.
export fn i2_depth_mix(states: const f32[:], width: i64, queries: const f32[:],
                        norm: f32[:], probabilities: f32[:], output: f32[:]) -> i64 {
    if width <= 0 || width > 8192 || states.len == 0 || states.len % width != 0 ||
       norm.len < states.len || queries.len == 0 || queries.len % width != 0 ||
       output.len < queries.len { return -1; }
    let count = states.len / width;
    let q_count = queries.len / width;
    if count > 128 || q_count > 24 || probabilities.len < count { return -1; }

    for row in count {
        let at = row * width;
        var sum: f64 = 0.0;
        for i in width {
            let square: f32 = states[at + i] * states[at + i];
            sum += square as f64;
        }
        let mean = (sum / (width as f64)) as f32;
        let scale: f32 = 1.0 / i2_sqrt(mean + 0.000001);
        for i in width { norm[at + i] = states[at + i] * scale; }
    }

    let score_scale: f32 = 1.0 / i2_sqrt(width as f32);
    for q in q_count {
        let q_at = q * width;
        var maximum: f32 = -3.4028234663852886e38;
        for row in count {
            let at = row * width;
            let score = i2_attention_dot(norm[at .. at + width], queries[q_at .. q_at + width]) * score_scale;
            probabilities[row] = score;
            if score > maximum { maximum = score; }
        }
        var total: f64 = 0.0;
        for row in count {
            let weight = i2_attn_exp(probabilities[row] - maximum);
            total += weight as f64;
            probabilities[row] = weight;
        }
        let inverse: f32 = 1.0 / (total as f32);
        for row in count { probabilities[row] *= inverse; }

        for i in width {
            var sum: f64 = 0.0;
            for row in count {
                let term = probabilities[row] * norm[row * width + i];
                sum += term as f64;
            }
            output[q_at + i] = sum as f32;
        }
    }
    return q_count;
}

// Gain and forget are the controller projections before tanh.
export fn i2_loop_blend(current: const f32[:], message: const f32[:], gain: const f32[:],
                         forget: const f32[:], output: f32[:]) -> i64 {
    let width = current.len;
    if width <= 0 || message.len != width || gain.len != width || forget.len != width ||
       output.len < width { return -1; }
    for i in width {
        let keep: f32 = 1.0 - i2_tanh(forget[i]);
        let residual = keep * current[i];
        let update = i2_tanh(gain[i]) * message[i];
        output[i] = residual + update;
    }
    return width;
}

// ---- composed from goose/model/inkling2-embedding.goose ----
extern "sqrtf" fn i2_embedding_sqrt(value: f32) -> f32;

// Q8_0 token rows feed the Inkling embedding RMS normalization. The
// caller binds the row and gain from the checked GGUF weight records.
export fn i2_embed_row(packed: const u8[:], gain: const f32[:], epsilon: f32, out: f32[:]) -> i64 {
    let width = gain.len;
    if width <= 0 || width > 2147483647 || width % 32 != 0 || out.len < width ||
       packed.len != (width / 32) * 34 || !(epsilon > 0.0) || epsilon > 3.4028234663852886e38 {
        return -1;
    }
    if dq_impl(8, packed, width, out) != width { return -1; }
    var squares: f64 = 0.0;
    for i in width {
        let square: f32 = out[i] * out[i];
        squares += square as f64;
    }
    let mean = (squares / (width as f64)) as f32;
    let inverse: f32 = 1.0 / i2_embedding_sqrt(mean + epsilon);
    for i in width {
        let normalized = out[i] * inverse;
        out[i] = normalized * gain[i];
    }
    return width;
}

// ---- composed from goose/model/inkling2-moe.goose ----
// The model uses the shared graph builders, but its router, fused expert
// layout and activation differ from the Qwen path.
fn i2_graph_unary(c: i64, input: i64, op: i64, work: i64[:]) -> i64 {
    qa_begin(work, 3, c, input, 0, 0, op);
    return gb_common_args(work);
}

fn i2_graph_scale(c: i64, input: i64, scale_bits: i64, work: i64[:]) -> i64 {
    qa_begin(work, 8, c, input, 0, 0, 32);
    work[7] = scale_bits;
    return gb_common_args(work);
}

// weights: router, selection bias, fused gate/up and down.
// nodes retains router IDs and normalized route weights for graph inspection.
export fn i2_moe_ffn(c: i64, input: i64, weights: i64[:], work: i64[:], nodes: i64[:]) -> i64 {
    if c == 0 || input == 0 || weights.len < 4 || work.len < 16 || nodes.len < 8 { return 0; }
    let hidden: i64 = 2304;
    let experts: i64 = 128;
    let used: i64 = 8;
    let ff: i64 = 1152;
    let count = ne(input, 1);
    if count < 1 || count > 4096 || !qm_shape(input, hidden, count, 1) || prop(input, 0) != 0 ||
       !qm_shape(weights[0], hidden, experts, 1) || prop(weights[0], 0) != 0 ||
       !qm_shape(weights[1], experts, 1, 1) || prop(weights[1], 0) != 0 ||
       !qm_shape(weights[2], hidden, 2 * ff, experts) || prop(weights[2], 0) != 23 ||
       !qm_shape(weights[3], ff, hidden, experts) || prop(weights[3], 0) != 20 { return 0; }

    nodes[0] = qa_mm(c, weights[0], input, work);
    nodes[1] = i2_graph_unary(c, nodes[0], 7, work);
    nodes[2] = qa_binary(c, nodes[1], weights[1], 2, work);
    qa_begin(work, 30, c, nodes[2], 0, 0, used);
    nodes[3] = gb_common_args(work);
    nodes[4] = qm_route_weights_separate(c, nodes[1], nodes[3], experts, used, count, 1090519040, work);

    let grouped = qa_reshape(c, input, hidden, 1, count, 1);
    nodes[5] = qm_mm_id(c, weights[2], grouped, nodes[3], work);
    let stride = 2 * ff * 4;
    let plane = stride * used;
    let gate = view4(c, nodes[5], ff, used, count, 1, stride, plane, plane * count, 0);
    let up = view4(c, nodes[5], ff, used, count, 1, stride, plane, plane * count, ff * 4);

    let gate_tanh = i2_graph_unary(c, i2_graph_scale(c, gate, 1048576000, work), 4, work);
    let gate_clip = i2_graph_scale(c, gate_tanh, 1082130432, work);
    let gate_situ = qa_binary(c, gate_clip, i2_graph_unary(c, gate, 7, work), 7, work);
    let up_tanh = i2_graph_unary(c, i2_graph_scale(c, up, 1025758986, work), 4, work);
    let up_clip = i2_graph_scale(c, up_tanh, 1103626240, work);
    nodes[6] = qa_binary(c, gate_situ, up_clip, 7, work);
    nodes[7] = qm_mm_id(c, weights[3], nodes[6], nodes[3], work);
    return qm_weighted(c, nodes[7], nodes[4]);
}

// ---- composed from goose/model/inkling2-projections.goose ----
// Bind the independent Q/K/V paths for one normalized attention input.
// The four extra projections are relative bias, sink, gate and the
// optional per-head K/V taps used by full-attention layers.
export fn i2_attention_projections(c: i64, inputs: i64[:], weights: i64[:], sliding: bool,
                                    work: i64[:], nodes: i64[:]) -> i64 {
    if c == 0 || inputs.len < 3 || weights.len < 8 || work.len < 16 || nodes.len < 8 ||
       inputs[0] == 0 { return -1; }
    let width: i64 = 2304;
    let count = ne(inputs[0], 1);
    if count < 1 || count > 4096 { return -1; }
    for i in 3 {
        if !qm_shape(inputs[i], width, count, 1) || prop(inputs[i], 0) != 0 { return -1; }
    }

    let projections = if sliding { 6 } else { 8 };
    for i in projections {
        let rows = if i == 0 || i == 5 { 3072 }
            else if i == 1 || i == 2 { 1024 }
            else if i == 3 { 384 }
            else if i == 4 { 24 }
            else { 32 };
        if !qm_shape(weights[i], width, rows, 1) || prop(weights[i], 0) != 8 { return -1; }
    }

    for i in projections {
        let input = if i == 1 || i == 6 { inputs[1] } else if i == 2 || i == 7 { inputs[2] } else { inputs[0] };
        let node = qa_mm(c, weights[i], input, work);
        if node == 0 { return -1; }
        nodes[i] = node;
    }
    if sliding {
        nodes[6] = 0;
        nodes[7] = 0;
    }
    return projections;
}

// Clipping is based on the norm of the scaled row, not on individual
// channel magnitudes. An empty scale leaves that row unchanged before clipping.
fn i2_clip_heads_impl(input: const f32[:], width: i64, weight: const f32[:],
                         limit: f32, output: f32[:]) -> i64 {
    if width < 1 || width > 8192 || input.len == 0 || input.len % width != 0 ||
       (weight.len != 0 && weight.len != input.len) || output.len < input.len ||
       !(limit > 0.0) || limit > 3.4028234663852886e38 { return -1; }

    for row in input.len / width {
        let at = row * width;
        var sum: f64 = 0.0;
        for i in width {
            let k = at + i;
            let scaled = if weight.len == 0 { input[k] } else { input[k] * weight[k] };
            output[k] = scaled;
            let square: f32 = scaled * scaled;
            sum += square as f64;
        }
        let clip = limit / (i2_sqrt(sum as f32) + 0.000001);
        let factor = if clip < 1.0 { clip } else { 1.0 };
        for i in width { output[at + i] *= factor; }
    }
    return input.len;
}

export fn i2_clip_heads(input: const f32[:], width: i64, weight: const f32[:],
                         limit: f32, output: f32[:]) -> i64 {
    return i2_clip_heads_impl(input, width, weight, limit, output);
}

// ---- composed from goose/model/inkling2-attention-step.goose ----
extern "logf" fn i2_attention_log(value: f32) -> f32;

fn i2_projection_conv(projected: const f32[:], history: const f32[:], kernel: const f32[:],
                      taps: const f32[:], output: f32[:]) {
    var base: f32[1024] = [0.0; 1024];
    for ch in 1024 {
        var value: f32 = 0.0;
        for lag in 3 { value += history[3 * ch + lag] * kernel[4 * ch + lag]; }
        value += projected[ch] * kernel[4 * ch + 3];
        base[ch] = value;
    }
    i2_shortconv_decode_impl(projected, history, base, taps, output);
}

fn i2_advance_projection(history: f32[:], projected: const f32[:]) {
    for i in projected.len {
        let at = i * 3;
        history[at] = history[at + 1];
        history[at + 1] = history[at + 2];
        history[at + 2] = projected[i];
    }
}

// The packed projection block contains Q, K, V, relative query, sink,
// gate and optional K/V taps in the order from i2_attention_projections.
// This is the CPU text-decode path for one physical cache slot.
export fn i2_attention_token(projected: const f32[:], q_clip: const f32[:], r_clip: const f32[:],
                             key_kernel: const f32[:], value_kernel: const f32[:], bias: const f32[:],
                             position: i64, capacity: i64, sliding: bool, positions: i64[:],
                             keys: f32[:], values: f32[:], key_history: f32[:], value_history: f32[:],
                             scratch: f32[:], output: f32[:]) -> i64 {
    let window: i64 = if sliding { 1024 } else { 0 };
    let rows = if sliding && capacity > window { window } else { capacity };
    let expected = if sliding { 8600 } else { 8664 };
    if i2_cache_row_impl(position, capacity, rows, sliding) < 0 || positions.len != rows ||
       projected.len != expected || q_clip.len != 3072 || r_clip.len != 384 ||
       key_kernel.len != 4096 || value_kernel.len != 4096 || bias.len != 16384 ||
       keys.len != rows * 1024 || values.len != keys.len || key_history.len != 3072 ||
       value_history.len != 3072 || scratch.len < rows || output.len < 3072 { return -1; }

    var q: f32[3072] = [0.0; 3072];
    var r: f32[384] = [0.0; 384];
    var k_raw: f32[1024] = [0.0; 1024];
    var k: f32[1024] = [0.0; 1024];
    var v: f32[1024] = [0.0; 1024];
    var no_weight: f32[0] = [];
    let k_taps = if sliding { projected[8600 .. 8600] } else { projected[8600 .. 8632] };
    let v_taps = if sliding { projected[8600 .. 8600] } else { projected[8632 .. 8664] };
    i2_projection_conv(projected[3072 .. 4096], key_history, key_kernel, k_taps, k_raw);
    i2_projection_conv(projected[4096 .. 5120], value_history, value_kernel, v_taps, v);
    i2_clip_heads_impl(projected[0 .. 3072], 128, q_clip, 22.627416610717773, q);
    i2_clip_heads_impl(k_raw, 128, no_weight, 22.627416610717773, k);
    i2_clip_heads_impl(projected[5120 .. 5504], 16, r_clip, 8.0, r);

    for head in 8 {
        let at = head * 128;
        let square_sum = i2_attention_dot(v[at .. at + 128], v[at .. at + 128]);
        let norm: f32 = 1.0 / i2_sqrt(square_sum / 128.0 + 0.000001);
        for i in 128 { v[at + i] *= norm; }
    }
    if !sliding {
        let fraction: f32 = ((position as f32) + 1.0) / 8192.0;
        let tau: f32 = 1.0 + 0.1 * i2_attention_log(if fraction < 1.0 { 1.0 } else { fraction });
        for i in q.len { q[i] *= tau; }
        for i in r.len { r[i] *= tau; }
    }
    if i2_store_kv_impl(position, capacity, sliding, positions, k, v, keys, values) < 0 { return -1; }
    i2_advance_projection(key_history, projected[3072 .. 4096]);
    i2_advance_projection(value_history, projected[4096 .. 5120]);
    let size = i2_attention_decode_impl(q, keys, values, r, bias, projected[5504 .. 5528],
        positions, position, window, scratch, output);
    if size < 0 { return -1; }
    for i in size {
        let gate: f32 = 1.0 / (1.0 + i2_attn_exp(-projected[5528 + i]));
        output[i] *= gate;
    }
    return size;
}

// ---- composed from goose/model/inkling2-layer-ops.goose ----

// RMS normalization used on the residual and projection inputs. A gain
// may either be absent or have one value for every channel.
export fn i2_rms_gain(input: const f32[:], weight: const f32[:], epsilon: f32, out: f32[:]) -> i64 {
    let n = input.len;
    if n < 1 || out.len < n || (weight.len != 0 && weight.len != n) || !(epsilon > 0.0) ||
       epsilon > 3.4028234663852886e38 { return -1; }
    var squares: f64 = 0.0;
    for i in n {
        let square: f32 = input[i] * input[i];
        squares += square as f64;
    }
    let mean = (squares / (n as f64)) as f32;
    let inverse: f32 = 1.0 / i2_sqrt(mean + epsilon);
    for i in n {
        let normalized = input[i] * inverse;
        out[i] = if weight.len == 0 { normalized } else { normalized * weight[i] };
    }
    return n;
}

// Post-attention and post-MoE convolution are static and have separate
// history within each cache slot. Commit history only after shape checks.
export fn i2_postconv_token(input: const f32[:], weights: const f32[:],
                             history: f32[:], out: f32[:]) -> i64 {
    let n = input.len;
    if n < 1 || n > 8192 || weights.len != 4 * n || history.len != 3 * n || out.len < n {
        return -1;
    }
    let inverse: f32 = 1.0 / i2_sqrt(5.0);
    for i in n {
        let at = 3 * i;
        let k = 4 * i;
        let current = input[i];
        var value: f32 = 0.0;
        for tap in 3 { value += history[at + tap] * weights[k + tap]; }
        value += current * weights[k + 3];
        out[i] = (current + value) * inverse;
        history[at] = history[at + 1];
        history[at + 1] = history[at + 2];
        history[at + 2] = current;
    }
    return n;
}

// Output rows use the unpadded vocabulary. Padded entries are kept out of
// the sampler, rather than relying on model padding values.
export fn i2_text_logits(logits: f32[:], unpadded: i64, cap: f32) -> i64 {
    if unpadded < 1 || unpadded > logits.len || !(cap > 0.0) || cap > 3.4028234663852886e38 {
        return -1;
    }
    let inverse: f32 = 1.0 / cap;
    for i in unpadded {
        let scaled = logits[i] * inverse;
        logits[i] = i2_tanh(scaled) * cap;
    }
    return unpadded;
}

// ---- composed from goose/model/qwen35-device-state.goose ----
extern "fg_cuda_load_model_state" fn state_load(ranges: const i64[:], bytes: i64) -> i64;
extern "fg_cuda_reset_model_state" fn state_reset_cuda() -> i64;
extern "fg_model_zero_host_pages" fn state_zero_host_pages(address: u64, bytes: i64) -> i64;

// State manifest rows: host address, byte span, device offset, kind.
// Kind 0 is Q4 KV, kind 1 is the recurrent matrix, kind 2 is convolution history.
fn qr_state_span(tensor: i64, kind: i64) -> i64 {
    if tensor == 0 || pred(0, tensor, 0) == 0 || ne(tensor, 3) != 1 { return 0; }
    if kind == 0 {
        if prop(tensor, 0) != 2 || ne(tensor, 2) != 1 { return 0; }
        return qk_row_bytes(ne(tensor, 0)) * ne(tensor, 1);
    }
    if prop(tensor, 0) != 0 { return 0; }
    return 4 * ne(tensor, 0) * ne(tensor, 1) * ne(tensor, 2);
}

fn qr_zero_host_kv(tensor: i64) -> bool {
    let bytes = qr_state_span(tensor, 0);
    return bytes > 0 && (state_zero_host_pages(qa_get(tensor, 4, 0), bytes) != 0 || qo_tensor_zero(tensor) != 0);
}

export fn qr_cuda_state(owner: const i64[:], layers: const i64[:], head: i64) -> i64 {
    if owner.len < 13 || owner[0] != 9191 || owner[5] <= 0 ||
       layers.len / 32 < owner[5] || head == 0 { return -1; }
    let available = mr_cuda_free();
    if available <= 0 { return available; }
    var ranges: i64[>..] = [];
    ranges.resize(owner[5] * 8, 0);
    var bytes: i64 = 0;
    var count: i64 = 0;
    for i in owner[5] {
        let row = i * 32;
        let recurrent = layers[row] == 1;
        for j in 2 {
            let at = if recurrent { row + 20 + j } else { row + 22 + j };
            let t = layers[at];
            let kind = if recurrent { 2 - j } else { 0 };
            let length = qr_state_span(t, kind);
            if length <= 0 || length > owner[12] - bytes { return -1; }
            let addr = qa_get(t, 4, 0);
            if addr == 0 { return -1; }
            ranges[count] = addr as! i64;
            ranges[count + 1] = length;
            ranges[count + 2] = bytes;
            ranges[count + 3] = kind;
            bytes += length;
            count += 4;
        }
    }
    if bytes > available || mr_cuda_head_bytes(head) > available - bytes { return 0; }
    return state_load(ranges[0 .. count], bytes);
}

fn qr_find_state_range(ranges: const i64[:], address: u64, bytes: i64, kind: i64) -> i64 {
    if bytes <= 0 || ranges.len % 4 != 0 { return -1; }
    for i in ranges.len / 4 {
        let at = 4 * i;
        let base = ranges[at] as! u64;
        let size = ranges[at + 1];
        if address < base || size < bytes || (kind >= 0 && ranges[at + 3] != kind) { continue; }
        let offset = address - base;
        if offset > ((size - bytes) as u64) { continue; }
        // Device recurrence reads and publishes complete registered tensors.
        if kind > 0 && (offset != 0 || bytes != size) { continue; }
        return at;
    }
    return -1;
}

export fn qr_state_index(ranges: const i64[:], address: u64, bytes: i64, kind: i64) -> i64 {
    return qr_find_state_range(ranges, address, bytes, kind);
}

export fn qr_state_offset(ranges: const i64[:], address: u64, bytes: i64, kind: i64) -> i64 {
    let at = qr_find_state_range(ranges, address, bytes, kind);
    if at < 0 { return -1; }
    return ranges[at + 2] + ((address - (ranges[at] as! u64)) as i64);
}

export fn qr_reset_state(owner: const i64[:], layers: const i64[:], session: i64[:]) -> i64 {
    if owner.len < 12 || owner[0] != 9191 || owner[5] <= 0 || layers.len / 32 < owner[5] { return -1; }
    for i in owner[5] {
        let row = i * 32;
        if layers[row] == 1 {
            if qo_tensor_zero(layers[row + 20]) == 0 || qo_tensor_zero(layers[row + 21]) == 0 { return -1; }
        } else if !qr_zero_host_kv(layers[row + 22]) || !qr_zero_host_kv(layers[row + 23]) { return -1; }
    }
    if state_reset_cuda() != 0 { return -1; }
    return q35_kv_init(owner[10], 32, session);
}

// ---- composed from goose/model/goose-model-loader.goose ----
// Model-loader decisions in Goose (APX: model loader).
//
// From llama-model-loader.cpp:881-928. This is the check that decides whether a tensor found in
// the GGUF matches the shape the model asked for, and it is exactly what caught a wrong
// is_recr value in EXP200 ("blk.1.attn_qkv.weight has wrong shape").


extern "fg201l_fail" fn fgl_fail(code: i64);
extern "fg201l_ld_ne" fn ld_ne(desc: u64, i: i64) -> i64;
extern "fg201l_st_i64" fn fgl_st_i64(base: u64, byte: i64, v: i64);

fn fgl_ensure(v: bool, c: i64) {
    if !v {
        fgl_fail(c);
    }
}
// 4 as i64 is written as a literal everywhere: a `const` lives in gg_globals, which the emitter
// initialises inside gg_program -- and a bridge that calls a generated function directly never
// runs that, so a const reads as zero. Same trap EXP199 hit with W.
// nelements: product of the first `n` dims of a descriptor array.

fn nelements(desc: u64, n: i64) -> i64 {
    fgl_ensure(n >= 0 && n <= 4 as i64, 10);
    var p: i64 = 1;
    var i: i64 = 0;

    while i < n {
        let v: i64 = ld_ne(desc, i);
        fgl_ensure(v >= 0, 11);
        p = p * v;
        i += 1;
    }
    return p;
}
// dims_ok: llama-model-loader.cpp:907-915, the non-reshape branch.
// A requested dim must match exactly; dims the request does not mention must be 1.

fn dims_ok(desc: u64, nreq: i64, r0: i64, r1: i64, r2: i64, r3: i64) -> i64 {
    fgl_ensure(nreq >= 0 && nreq <= 4 as i64, 20);
    var i: i64 = 0;

    while i < 4 as i64 {
        let want: i64 = if i == 0 as i64 {
            r0
        } else {
            if i == 1 as i64 {
                r1
            } else {
                if i == 2 as i64 {
                    r2
                } else {
                    r3
                }
            }
        }
        ;
        let have: i64 = ld_ne(desc, i);
        let expect: i64 = if i < nreq {
            want
        } else {
            1 as i64
        }
        ;

        if have != expect {
            return 0 as i64;
        }
        i += 1;
    }
    return 1 as i64;
}
// shape_ok: the two branches of check_tensor_dims. allow_reshape compares element counts only.

fn shape_ok(allow_reshape: i64, desc: u64, nreq: i64, total_req: i64, r0: i64, r1: i64, r2: i64, r3: i64) -> i64 {
    fgl_ensure(total_req >= 0, 30);

    if allow_reshape != 0 {
        if nelements(desc, 4 as i64) == total_req {
            return 1 as i64;
        }
        return 0 as i64;
    }
    return dims_ok(desc, nreq, r0, r1, r2, r3);
}
// get_key_or_arr and load-mode decisions, from llama-model-loader.cpp:455-560.
// or_arr_too_many: line 470, `n > N_MAX`.

fn or_arr_too_many(n: i64, n_max: i64) -> i64 {
    fgl_ensure(n >= 0 && n_max >= 0, 40);

    if n > n_max {
        return 1 as i64;
    }
    return 0 as i64;
}
// is_array_kv: line 474, `gguf_get_kv_type(...) == GGUF_TYPE_ARRAY`. The enum value is passed in.

fn is_array_kv(kv_type: i64, array_type: i64) -> i64 {
    if kv_type == array_type {
        return 1 as i64;
    }
    return 0 as i64;
}
// arr_length_ok: line 479, `n == arr_info.length`.

fn arr_length_ok(n: i64, length: i64) -> i64 {
    fgl_ensure(n >= 0 && length >= 0, 41);

    if n == length {
        return 1 as i64;
    }
    return 0 as i64;
}
// use_mmap: line 558, `MMAP || MMAP_MLOCK || AUTO`.
//   AUTO = -1, MMAP = 1, MMAP_MLOCK = 3

fn use_mmap_mode(load_mode: i64) -> i64 {
    if load_mode == (0 as i64) - 1 as i64 {
        return 1 as i64;
    }

    if load_mode == 1 as i64 {
        return 1 as i64;
    }

    if load_mode == 3 as i64 {
        return 1 as i64;
    }
    return 0 as i64;
}
// use_direct_io: line 559, `load_mode == DIRECT_IO`, DIRECT_IO = 4.

fn use_direct_io_mode(load_mode: i64) -> i64 {
    if load_mode == 4 as i64 {
        return 1 as i64;
    }
    return 0 as i64;
}
// mmap range arithmetic, from llama-model-loader.cpp:1455-1508.
//
// merge_ranges produces a sorted, non-overlapping cover; sub_ranges subtracts one cover from
// another. Both are pure integer interval logic, and an error there means a mapped range that is
// wrong by a byte -- which shows up as a corrupted weight rather than a clear failure.
// merge_touches: line 1462, `range.first <= res.back().last` -- merge into the previous range.
// Ranges are half-open [first, last), and the comparison is `<=`, so adjacent ranges merge.

fn merge_touches(prev_last: i64, cur_first: i64) -> i64 {
    fgl_ensure(prev_last >= 0 && cur_first >= 0, 50);

    if cur_first <= prev_last {
        return 1 as i64;
    }
    return 0 as i64;
}
// merged_last: line 1463, `max(prev.last, cur.last)`.

fn merged_last(prev_last: i64, cur_last: i64) -> i64 {
    if prev_last > cur_last {
        return prev_last;
    }
    return cur_last;
}
// sub_skip: line 1481, `y.last <= cur || y.first >= x.last` -- this subtraction does not apply.

fn sub_skip(y_first: i64, y_last: i64, cur: i64, x_last: i64) -> i64 {
    fgl_ensure(y_first >= 0 && y_last >= 0 && cur >= 0 && x_last >= 0, 51);

    if y_last <= cur {
        return 1 as i64;
    }

    if y_first >= x_last {
        return 1 as i64;
    }
    return 0 as i64;
}
// sub_emit_gap: line 1484, `y.first > cur` -- emit [cur, y.first) before advancing.

fn sub_emit_gap(cur: i64, y_first: i64) -> i64 {
    if y_first > cur {
        return 1 as i64;
    }
    return 0 as i64;
}
// sub_advance: line 1486, `cur = max(cur, y.last)`.

fn sub_advance(cur: i64, y_last: i64) -> i64 {
    if cur > y_last {
        return cur;
    }
    return y_last;
}
// sub_emit_tail: line 1489, `cur < x.last` -- the remainder of the range survives.

fn sub_emit_tail(cur: i64, x_last: i64) -> i64 {
    if cur < x_last {
        return 1 as i64;
    }
    return 0 as i64;
}
// Full interval algorithms over flat arrays of (first,last) int64 pairs.
//   src: n pairs, assumed sorted by first (the caller sorts, as native does)
//   dst: capacity-cap pairs; the return value is the number of pairs written.
// The caller owns both buffers, so no allocation happens in Goose.

fn st_pair(dst: u64, k: i64, a: i64, b: i64) {
    fgl_st_i64(dst, k * 16 as i64, a);
    fgl_st_i64(dst, k * 16 as i64 + 8 as i64, b);
}

fn ld_first(src: u64, k: i64) -> i64 {
    return ld_ne(src, k * 2 as i64);
}

fn ld_last(src: u64, k: i64) -> i64 {
    return ld_ne(src, k * 2 as i64 + 1 as i64);
}
// merge_ranges: llama-model-loader.cpp:1455-1471. Input already sorted by first.

fn merge_ranges(src: u64, n: i64, dst: u64, cap: i64) -> i64 {
    fgl_ensure(n >= 0 && cap >= 0, 60);
    var k: i64 = 0;
    var i: i64 = 0;

    while i < n {
        let f: i64 = ld_first(src, i);
        let l: i64 = ld_last(src, i);
        fgl_ensure(f <= l, 61);

        if k > 0 as i64 {
            let pl: i64 = ld_last(dst, k - 1 as i64);

            if merge_touches(pl, f) != 0 {
                st_pair(dst, k - 1 as i64, ld_first(dst, k - 1 as i64), merged_last(pl, l));
                i += 1;
                continue;
            }
        }
        fgl_ensure(k < cap, 62);
        st_pair(dst, k, f, l);
        k += 1;
        i += 1;
    }
    return k;
}
// sub_ranges: lines 1476-1495. Subtracts `sub` (sorted, non-overlapping) from `a`.

fn sub_ranges(a: u64, na: i64, sub: u64, ns: i64, dst: u64, cap: i64) -> i64 {
    fgl_ensure(na >= 0 && ns >= 0 && cap >= 0, 70);
    var k: i64 = 0;
    var x: i64 = 0;

    while x < na {
        let xf: i64 = ld_first(a, x);
        let xl: i64 = ld_last(a, x);
        var cur: i64 = xf;
        var y: i64 = 0;

        while y < ns {
            let yf: i64 = ld_first(sub, y);
            let yl: i64 = ld_last(sub, y);

            if sub_skip(yf, yl, cur, xl) == 0 as i64 {
                if sub_emit_gap(cur, yf) != 0 {
                    fgl_ensure(k < cap, 71);
                    st_pair(dst, k, cur, yf);
                    k += 1;
                }
                cur = sub_advance(cur, yl);
            }
            y += 1;
        }

        if sub_emit_tail(cur, xl) != 0 {
            fgl_ensure(k < cap, 72);
            st_pair(dst, k, cur, xl);
            k += 1;
        }
        x += 1;
    }
    return k;
}
// Stable insertion sort over (first,last) pairs, by first. llama-model-loader.cpp:1483 used
// std::sort for this and it had to stay in C++ while Goose had no ordering pass; with bounded
// arrays the ordering is Goose's too. Equal keys keep their input order, which matches the
// std::sort tie behaviour the loader relies on only by accident -- recorded, not assumed.

fn sort_pairs(base: u64, n: i64) -> i64 {
    fgl_ensure(n >= 0, 80);

    if n <= 1 as i64 {
        return n;
    }
    // STOCK std.sort with an index comparator when the count fits a compile-time array bound.
    // Native llama-model-loader.cpp:1483 uses std::sort, so this is the faithful route; the
    // insertion sort below stays as the general path so no artificial capacity limit is introduced
    // (an mmap range list is small, but "small in practice" is not a bound).

    if n <= 256 as i64 {
        var key: i64[256] = [0 as i64;
        256];
        var idx: i64[256] = [0 as i64;
        256];
        var a: i64 = 0;

        while a < n {
            key[a] = ld_ne(base, a * 2 as i64);
            idx[a] = a;
            a += 1;
        }
        sort(idx[0..n]) {
            x, y => key[x] < key[y]
        }
        ;
        // read the pairs in sorted order first, then write them back: an in-place scatter would
        // overwrite pairs it has not read yet
        var sf: i64[256] = [0 as i64;
        256];
        var sl: i64[256] = [0 as i64;
        256];
        a = 0;

        while a < n {
            let s: i64 = idx[a];
            sf[a] = ld_ne(base, s * 2 as i64);
            sl[a] = ld_ne(base, s * 2 as i64 + 1 as i64);
            a += 1;
        }
        a = 0;

        while a < n {
            fgl_st_i64(base, a * 16 as i64, sf[a]);
            fgl_st_i64(base, a * 16 as i64 + 8 as i64, sl[a]);
            a += 1;
        }
        return n;
    }
    var i: i64 = 1;

    while i < n {
        let kf: i64 = ld_ne(base, i * 2 as i64);
        let kl: i64 = ld_ne(base, i * 2 as i64 + 1 as i64);
        var j: i64 = i - 1 as i64;

        while j >= 0 as i64 {
            let pf: i64 = ld_ne(base, j * 2 as i64);

            if pf <= kf {
                break;
            }
            fgl_st_i64(base, (j + 1 as i64) * 16 as i64, pf);
            fgl_st_i64(base, (j + 1 as i64) * 16 as i64 + 8 as i64, ld_ne(base, j * 2 as i64 + 1 as i64));
            j -= 1;
        }
        fgl_st_i64(base, (j + 1 as i64) * 16 as i64, kf);
        fgl_st_i64(base, (j + 1 as i64) * 16 as i64 + 8 as i64, kl);
        i += 1;
    }
    return n;
}

// ---- composed from goose/model/file-io.goose ----
// Bounded reader decisions in Goose, from ggml/src/gguf.cpp (struct gguf_reader:
// read, read(string), read(vector), seek, read_raw, file_remain).
//
// Owned decisions: whether a read fits, the array/string limits, the seek bounds,
// the chunked transfer length and EOF handling, and the resulting
// (data_offset, nbytes_remain) state. The actual byte copy, the FILE* and the
// callback stay native.
//
// Limits: GGUF_MAX_STRING_LENGTH and GGUF_MAX_ARRAY_ELEMENTS are both 1<<30.
extern "fg458_st_i64" fn fio_st_i64(p: u64, o: u64, v: i64);

fn put(out: u64, i: i64, v: i64) {
    fio_st_i64(out, (i * (8 as i64)) as u64, v);
}
const MAX_STRING: i64 = 1073741824 as i64;
const MAX_ARRAY: i64 = 1073741824 as i64;
const I64_MAX: i64 = 9223372036854775807 as i64;
// 1 when a scalar of `size` bytes fits in the remaining bytes.

export fn fits(size: i64, remain: i64) -> i64 {
    if size < 0 as i64 {
        return 0 as i64;
    }

    if remain < 0 as i64 {
        return 0 as i64;
    }

    if size <= remain {
        return 1 as i64;
    }
    return 0 as i64;
}
// 0 ok, 1 too many elements, 2 element count overflows, 3 not enough bytes.

export fn array_check(n: i64, elem: i64, remain: i64, out: u64) -> i64 {
    var st: i64 = 0 as i64;

    if n < 0 as i64 {
        st = 1 as i64;
    } else {
        if n > MAX_ARRAY {
            st = 1 as i64;
        } else {
            if elem <= 0 as i64 {
                st = 2 as i64;
            } else {
                if n > (I64_MAX / elem) {
                    st = 2 as i64;
                } else {
                    if n * elem > remain {
                        st = 3 as i64;
                    }
                }
            }
        }
    }
    put(out, 0 as i64, st);
    return st;
}
// 0 ok, 1 longer than the string limit, 2 longer than the remaining bytes.

export fn string_check(size: i64, remain: i64, out: u64) -> i64 {
    var st: i64 = 0 as i64;

    if size < 0 as i64 {
        st = 1 as i64;
    } else {
        if size > MAX_STRING {
            st = 1 as i64;
        } else {
            if size > remain {
                st = 2 as i64;
            }
        }
    }
    put(out, 0 as i64, st);
    return st;
}
// seek: 1 accepted with the new remaining count, 0 rejected.

export fn seek(abs_off: i64, data_offset: i64, remain: i64, out: u64) -> i64 {
    var ok: i64 = 0 as i64;
    var new_remain: i64 = remain;

    if abs_off >= 0 as i64 {
        let end: i64 = data_offset + remain;

        if end >= data_offset {
            if abs_off <= end {
                ok = 1 as i64;
                new_remain = end - abs_off;
            }
        }
    }
    put(out, 0 as i64, ok);
    put(out, 1 as i64, new_remain);
    return ok;
}
// Chunked transfer: writes total copied, new data_offset, new remain and the
// reached-EOF flag. Returns the copied byte count.

export fn read_raw(size: i64, max_chunk: i64, data_offset: i64, remain: i64, file_end: i64, out: u64) -> i64 {
    var total: i64 = 0 as i64;
    var eof: i64 = 0 as i64;
    var off: i64 = data_offset;

    if size > 0 as i64 && max_chunk > 0 as i64 {
        var done: i64 = 0 as i64;

        while done == 0 as i64 && total < size {
            let want: i64 = size - total;
            var chunk: i64 = max_chunk;

            if want < chunk {
                chunk = want;
            }
            let pos: i64 = data_offset + total;

            if pos < data_offset {
                done = 1 as i64;
            } else {
                let avail: i64 = file_end - pos;

                if avail >= chunk {
                    total = total + chunk;
                } else {
                    if avail > 0 as i64 {
                        total = total + avail;
                    }
                    eof = 1 as i64;
                    done = 1 as i64;
                }
            }
        }
    }
    var new_remain: i64 = remain - total;

    if eof != 0 as i64 {
        new_remain = 0 as i64;
    }

    if new_remain < 0 as i64 {
        new_remain = 0 as i64;
    }
    off = data_offset + total;
    put(out, 0 as i64, total);
    put(out, 1 as i64, off);
    put(out, 2 as i64, new_remain);
    put(out, 3 as i64, eof);
    return total;
}
// Remaining bytes of a file: 0 when either position is unknown.

export fn file_remain(file_end: i64, cur: i64, out: u64) -> i64 {
    var r: i64 = 0 as i64;

    if cur >= 0 as i64 && file_end >= cur {
        r = file_end - cur;
    }
    put(out, 0 as i64, r);
    return r;
}

// ---- composed from goose/model/arch-registry.goose ----
// P9-01 S2: the MoE architecture registry and its tensor-name matcher.
//
// Native sources:
//   runtime/core/src/moe/arch_registry.cpp — the nine-row k_recipes table and
//     find_moe_recipe / n_moe_recipes / moe_recipe_at (whole file, 84 lines);
//   runtime/core/include/bmoe/recipe.h — MoeRecipe, max_exps;
//   runtime/core/src/moe/router_hook.cpp:22-39 — match_expert, the only consumer
//     of a recipe's suffix table that decides anything without a graph. It is
//     static in the native file and reads no llama.cpp state, so the gate
//     compares it against a transcription of those lines.
//
// The recipe IS the architecture gate: streaming is refused when the gguf's
// general.architecture is not in this table, and the table's row decides which
// tensors are streamed. Nothing here is model-specific beyond the suffix names.
//
// Flat ABI:
//   ar_count()                      -> the row count (n_moe_recipes)
//   ar_find(arch)                   -> row index, or -1 (find_moe_recipe == nullptr)
//   ar_arch(i, out)                 -> arch length, or -1 when i is out of range
//   ar_suffix(i, slot, out)         -> suffix length, or -1 when the slot is unused
//                                      (the native nullptr) or out of range
//   ar_exps(i)                      -> number of non-null suffixes in the row
//   ar_match(name, row, lay)        -> slot index with lay[0] = layer number, or -1
//                                      (-1 also for a bad row or a short lay buffer)
//
// Lookup is exact std::strcmp: no case folding, no prefix match, no alias.
// That is the native behaviour and it is part of the port.

const AR_COUNT: i64 = 9;
const AR_MAX_EXPS: i64 = 3;
const AR_NONE: i64 = -1;

// k_recipes[i], in the native table order.
fn ar_nth_arch(i: i64) -> const u8[:] {
    if i == 0 {
        return "qwen3moe";
    }
    if i == 1 {
        return "qwen2moe";
    }
    if i == 2 {
        return "qwen35moe";
    }
    if i == 3 {
        return "gemma4";
    }
    if i == 4 {
        return "gpt-oss";
    }
    if i == 5 {
        return "lfm2moe";
    }
    if i == 6 {
        return "deepseek4";
    }
    if i == 7 {
        return "bailingmoe3";
    }
    if i == 8 {
        return "qwen4exp";
    }
    return "";
}

// k_recipes[i].exps_suffix[slot]; "" is the native nullptr and is never a real
// suffix, so ar_suffix reports it as -1 rather than as an empty string.
fn ar_nth_suffix(i: i64, slot: i64) -> const u8[:] {
    if i == 3 {
        // gemma4 fuses gate+up into one tensor and leaves the third slot unused.
        if slot == 0 {
            return "ffn_gate_up_exps";
        }
        if slot == 1 {
            return "ffn_down_exps";
        }
        return "";
    }
    if slot == 0 {
        return "ffn_gate_exps";
    }
    if slot == 1 {
        return "ffn_up_exps";
    }
    if slot == 2 {
        return "ffn_down_exps";
    }
    return "";
}

// Exact byte equality, standing in for std::strcmp(...) == 0.
fn ar_eq(a: const u8[:], b: const u8[:]) -> i64 {
    if a.len != b.len {
        return 0;
    }
    var k: i64 = 0;
    while k < a.len {
        if a[k] != b[k] {
            return 0;
        }
        k += 1;
    }
    return 1;
}

// Byte at `at`, or 0 past the end. The native side reads NUL-terminated C
// strings; mapping "past the end" to 0 keeps a prefix of a shorter name from
// matching the longer literal by accident.
fn ar_at(s: const u8[:], at: i64) -> i64 {
    if at < 0 || at >= s.len {
        return 0;
    }
    return s[at];
}

fn ar_put(out: u8[:], s: const u8[:]) -> i64 {
    var k: i64 = 0;
    while k < s.len {
        if k < out.len {
            out[k] = s[k];
        }
        k += 1;
    }
    return s.len;
}

// arch_registry.cpp:73-81 — find_moe_recipe: nullptr for a null pointer or an
// unknown string. The empty string is unknown too.
export fn ar_find(arch: const u8[:]) -> i64 {
    var i: i64 = 0;
    while i < AR_COUNT {
        if ar_eq(arch, ar_nth_arch(i)) != 0 {
            return i;
        }
        i += 1;
    }
    return AR_NONE;
}

export fn ar_count() -> i64 {
    return AR_COUNT;
}

export fn ar_arch(i: i64, out: u8[:]) -> i64 {
    if i < 0 || i >= AR_COUNT {
        return AR_NONE;
    }
    return ar_put(out, ar_nth_arch(i));
}

export fn ar_suffix(i: i64, slot: i64, out: u8[:]) -> i64 {
    if i < 0 || i >= AR_COUNT || slot < 0 || slot >= AR_MAX_EXPS {
        return AR_NONE;
    }
    let s: const u8[:] = ar_nth_suffix(i, slot);
    if s.len == 0 {
        return AR_NONE; // unused slot: the native exps_suffix[slot] == nullptr
    }
    return ar_put(out, s);
}

// How many expert tensors the row names. The streamer iterates max_exps slots
// and skips the null ones (session.cpp:1019-1026, expert_stream_source.cpp:61-73);
// this is that count in one answer.
export fn ar_exps(i: i64) -> i64 {
    if i < 0 || i >= AR_COUNT {
        return AR_NONE;
    }
    var n: i64 = 0;
    var slot: i64 = 0;
    while slot < AR_MAX_EXPS {
        if ar_nth_suffix(i, slot).len != 0 {
            n += 1;
        }
        slot += 1;
    }
    return n;
}

// router_hook.cpp:22-39 — match_expert("blk.<il>.<suffix>.weight"):
//
//   int il = -1, consumed = 0;
//   if (sscanf(name, "blk.%d.%n", &il, &consumed) != 1 || il < 0) return -1;
//   const char * rest = name + consumed;
//   for (p ...) { if (!suffix) continue;
//                 if (!strncmp(rest, suffix, sl) && !strcmp(rest + sl, ".weight")) return p; }
//   return -1;
//
// %d semantics carried over: leading whitespace is skipped, one optional sign,
// then one or more digits. The exact ".weight" tail is load-bearing — a
// companion "ffn_down_exps.scale" prefix-matches its suffix and must not
// stream. The loop stops at the FIRST matching slot, and the row's unused slots
// are skipped, which is what makes the fused gemma4 layout work.
//
// Integer overflow inside %d is undefined in the native call; the engine only
// ever scans names it generated, so the port accumulates in i64 and the gate
// stays inside the range where both agree.
export fn ar_match(name: const u8[:], row: i64, lay: i64[:]) -> i64 {
    if row < 0 || row >= AR_COUNT || lay.len < 1 {
        return AR_NONE;
    }
    if ar_at(name, 0) != 98 || ar_at(name, 1) != 108 || ar_at(name, 2) != 107 || ar_at(name, 3) != 46 {
        return AR_NONE; // "blk."
    }
    var at: i64 = 4;
    while ar_at(name, at) == 32 || ar_at(name, at) == 9 || ar_at(name, at) == 10 ||
          ar_at(name, at) == 11 || ar_at(name, at) == 12 || ar_at(name, at) == 13 {
        at += 1;
    }
    var neg: i64 = 0;
    if ar_at(name, at) == 43 || ar_at(name, at) == 45 {
        if ar_at(name, at) == 45 {
            neg = 1;
        }
        at += 1;
    }
    var il: i64 = 0;
    var digits: i64 = 0;
    while ar_at(name, at) >= 48 && ar_at(name, at) <= 57 {
        il = il * 10 + (ar_at(name, at) - 48);
        at += 1;
        digits += 1;
    }
    if digits == 0 {
        return AR_NONE; // sscanf reports no conversion
    }
    if neg != 0 {
        il = 0 - il;
    }
    if il < 0 {
        return AR_NONE;
    }
    if ar_at(name, at) != 46 {
        return AR_NONE; // "%d.%n" requires the dot after the number
    }
    at += 1;
    var slot: i64 = 0;
    while slot < AR_MAX_EXPS {
        let suf: const u8[:] = ar_nth_suffix(row, slot);
        if suf.len != 0 {
            var k: i64 = 0;
            var hit: i64 = 1;
            while k < suf.len {
                if ar_at(name, at + k) != ar_at(suf, k) {
                    hit = 0;
                    break;
                }
                k += 1;
            }
            if hit != 0 {
                // rest + sl must equal ".weight" exactly.
                if ar_at(name, at + suf.len) == 46 && ar_at(name, at + suf.len + 1) == 119 &&
                   ar_at(name, at + suf.len + 2) == 101 && ar_at(name, at + suf.len + 3) == 105 &&
                   ar_at(name, at + suf.len + 4) == 103 && ar_at(name, at + suf.len + 5) == 104 &&
                   ar_at(name, at + suf.len + 6) == 116 && ar_at(name, at + suf.len + 7) == 0 {
                    lay[0] = il;
                    return slot;
                }
            }
        }
        slot += 1;
    }
    return AR_NONE;
}

