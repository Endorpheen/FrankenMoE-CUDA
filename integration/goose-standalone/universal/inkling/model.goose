import math;
import std;
// ---- composed from goose/model/goose-model-graph.goose ----
// Apex model graph decisions in Goose (APX: model runtime).
//
// From models/qwen35moe.cpp and llama-hparams / llama-graph.h. These are the per-layer decisions
// the builder makes while constructing the graph for qwen35moe (Apex), not the graph itself:
// which layer kind to build, and how the NextN/MTP hidden state is cropped.
//
// Kept separate from EXP199 (KV cells) because it is a different subsystem.
extern "fg200g_fail" fn fgg_fail(code: i64);
extern "fg200g_st_i64" fn st_i64(base: u64, byte: i64, v: i64);
extern "fg200g_ld_u32" fn ld_u32(base: u64, index: i64) -> i64;

fn fgg_ensure(v: bool, c: i64) {
    if !v {
        fgg_fail(c);
    }
}
// is_recr: llama-hparams.cpp:260. `is_recr_impl` is std::array<uint32_t, LLAMA_MAX_LAYERS> -- one
// 4-byte element per layer, NOT a packed bitset. Reading it as words was the first bug here: the
// model then loaded with the wrong attention shape and refused to start.

fn is_recr(il: i64, n_layer_all: i64, flags: u64) -> i64 {
    fgg_ensure(il >= 0, 10);
    fgg_ensure(n_layer_all >= 0, 11);

    if il >= n_layer_all {
        return -1 as i64;
    }
    // native aborts; the caller must treat -1 as fatal
    let v: i64 = ld_u32(flags, il);

    if v != 0 as i64 {
        return 1 as i64;
    }
    return 0 as i64;
}
// crop_before_nextn: llama-graph.h:1086.
//   inp_out_ids != null && (!embeddings_nextn || embeddings_nextn_masked)

fn crop_before_nextn(has_out_ids: i64, emb_nextn: i64, emb_masked: i64) -> i64 {
    fgg_ensure(has_out_ids == 0 || has_out_ids == 1, 20);

    if has_out_ids == 0 {
        return 0 as i64;
    }

    if emb_nextn == 0 {
        return 1 as i64;
    }

    if emb_masked != 0 {
        return 1 as i64;
    }
    return 0 as i64;
}
// crop_after_nextn: llama-graph.h:1091.
//   inp_out_ids != null && embeddings_nextn && !embeddings_nextn_masked

fn crop_after_nextn(has_out_ids: i64, emb_nextn: i64, emb_masked: i64) -> i64 {
    fgg_ensure(has_out_ids == 0 || has_out_ids == 1, 30);

    if has_out_ids == 0 {
        return 0 as i64;
    }

    if emb_nextn == 0 {
        return 0 as i64;
    }

    if emb_masked != 0 {
        return 0 as i64;
    }
    return 1 as i64;
}
// capture_layer_input: models/qwen35moe.cpp:182 -- `res->t_layer_inp[il] = inpL` for every layer
// in the main pass. Returns 1 to record it, 0 when nextn layers are being executed separately.

fn capture_layer_input(il: i64, n_layer: i64) -> i64 {
    fgg_ensure(il >= 0 && n_layer >= 0, 40);

    if il < n_layer {
        return 1 as i64;
    }
    return 0 as i64;
}
// shift_skip: llama-kv-cache.cpp:1303 area -- a shift of 0 means the shift graph is not built.

fn shift_skip(shift: i64) -> i64 {
    if shift == 0 as i64 {
        return 1 as i64;
    }
    return 0 as i64;
}
// build_moe_ffn decisions, from llama-graph.cpp:2189-2348.
//
// The MoE body is graph construction; what it decides, and what is ported here, is which gating
// op to apply, whether group selection runs, whether weights are normalised and scaled, and
// whether the weights are applied before the FFN.
// gating_kind: the four gating functions, as the switch at 2227-2249 expresses them.
//   0 SOFTMAX, 1 SIGMOID, 2 SOFTMAX_WEIGHT (identity before top-k), 3 SQRT_SOFTPLUS

fn gating_kind(gating_op: i64) -> i64 {
    if gating_op == 0 as i64 {
        return 0 as i64;
    }

    if gating_op == 1 as i64 {
        return 1 as i64;
    }

    if gating_op == 2 as i64 {
        return 2 as i64;
    }

    if gating_op == 3 as i64 {
        return 3 as i64;
    }
    fgg_ensure(false, 50);
    // native aborts on an unknown gating type
    return 0 as i64;
}
// group_select: line 2283, `n_expert_groups > 1 && n_tokens > 0`.

fn group_select(n_expert_groups: i64, n_tokens: i64) -> i64 {
    // Native has no lower bound here: a model may report 0 groups, and `> 1` then simply fails.
    fgg_ensure(n_expert_groups >= 0, 51);
    fgg_ensure(n_tokens >= 0, 52);

    if n_expert_groups > 1 as i64 && n_tokens > 0 as i64 {
        return 1 as i64;
    }
    return 0 as i64;
}
// weight_before_ffn: line 2214, only llama4 applies the sigmoid-ed weights before the FFN.

fn weight_before_ffn(is_llama4: i64) -> i64 {
    if is_llama4 != 0 {
        return 1 as i64;
    }
    return 0 as i64;
}
// weights_need_scale: line 2345, `w_scale != 0 && w_scale != 1`.
// The comparison is on the float value; the caller passes it as a bit pattern so the decision
// stays integer arithmetic. 0.0f = 0x00000000, 1.0f = 0x3f800000.

fn weights_need_scale(w_scale_bits: i64) -> i64 {
    if w_scale_bits == 0 as i64 {
        return 0 as i64;
    }

    if w_scale_bits == 1065353216 as i64 {
        return 0 as i64;
    }
    // 0x3f800000
    return 1 as i64;
}
// build_layer_attn, from models/qwen35moe.cpp:276-355.
// kq_scale_kind: line 344.
//   f_attention_scale == 0.0f ? 1/sqrt(n_embd_head) : f_attention_scale
// The decision is whether to compute the reciprocal square root at all; the value itself stays
// with the caller, which already has sqrtf.
//   1 -> caller must compute 1/sqrt(n_embd_head);  0 -> caller uses f_attention_scale

fn kq_scale_auto(f_attention_scale_bits: i64) -> i64 {
    if f_attention_scale_bits == 0 as i64 {
        return 1 as i64;
    }
    // 0.0f
    return 0 as i64;
}
// gate_view_offset: line 311-313. The gate is the second half of the QG projection, so its byte
// offset inside one row is element_size * n_embd_head. Returned as an element count so the caller
// multiplies by element size once.

fn gate_elem_offset(n_embd_head: i64) -> i64 {
    fgg_ensure(n_embd_head > 0, 60);
    return n_embd_head;
}
// q_full_width: line 288, the QG projection emits query and gate interleaved, so the projection
// width is twice the head width.

fn q_full_width(n_embd_head: i64) -> i64 {
    fgg_ensure(n_embd_head > 0, 61);
    return n_embd_head * 2 as i64;
}
// build_layer_attn_linear geometry, from models/qwen35moe.cpp:357-440.
//
// The recurrent branch derives every view shape from four head counts and one inner size. These
// are exact integer divisions and products, and an off-by-one here silently corrupts the state
// rather than failing, so they are worth having in Goose.
// head_v_dim: line 365, `d_inner / num_v_heads`.

fn head_v_dim(d_inner: i64, num_v_heads: i64) -> i64 {
    fgg_ensure(num_v_heads > 0, 70);
    fgg_ensure(d_inner >= 0, 71);
    return d_inner / num_v_heads;
}
// conv_channels: line 400, `d_inner + 2 * ssm_n_group * ssm_d_state`.

fn conv_channels(d_inner: i64, n_group: i64, d_state: i64) -> i64 {
    fgg_ensure(d_inner >= 0 && n_group >= 0 && d_state >= 0, 72);
    return d_inner + 2 as i64 * n_group * d_state;
}
// qkv_dim: line 425, `head_k_dim * num_k_heads * 2 + head_v_dim * num_v_heads`.

fn qkv_dim(head_k_dim: i64, num_k_heads: i64, head_v_dim_: i64, num_v_heads: i64) -> i64 {
    fgg_ensure(head_k_dim >= 0 && num_k_heads >= 0 && head_v_dim_ >= 0 && num_v_heads >= 0, 73);
    return head_k_dim * num_k_heads * 2 as i64 + head_v_dim_ * num_v_heads;
}
// k_view_offset_elems: line 447, the K view starts after the whole Q block:
//   head_k_dim * num_k_heads   elements into the row.

fn k_view_offset_elems(head_k_dim: i64, num_k_heads: i64) -> i64 {
    fgg_ensure(head_k_dim >= 0 && num_k_heads >= 0, 74);
    return head_k_dim * num_k_heads;
}
// v_view_offset_elems: the V view starts after Q and K blocks together.

fn v_view_offset_elems(head_k_dim: i64, num_k_heads: i64) -> i64 {
    fgg_ensure(head_k_dim >= 0 && num_k_heads >= 0, 75);
    return head_k_dim * num_k_heads * 2 as i64;
}
// Recurrent-branch tail, from models/qwen35moe.cpp:457-484.
// need_repeat: line 457.
//   num_k_heads != num_v_heads && (!fused_gdn_ar || !fused_gdn_ch)
// The repeat is skipped when the fused GDN path already matches the shapes, so this decides
// whether two extra graph nodes are inserted.

fn need_repeat(num_k_heads: i64, num_v_heads: i64, fused_ar: i64, fused_ch: i64) -> i64 {
    fgg_ensure(num_k_heads >= 0 && num_v_heads >= 0, 80);

    if num_k_heads == num_v_heads {
        return 0 as i64;
    }

    if fused_ar != 0 as i64 && fused_ch != 0 as i64 {
        return 0 as i64;
    }
    return 1 as i64;
}
// repeat_divisible: the assert at line 458, `num_v_heads % num_k_heads == 0`.
// Returns 1 when the repeat is legal; the caller aborts otherwise, as native does.

fn repeat_divisible(num_k_heads: i64, num_v_heads: i64) -> i64 {
    fgg_ensure(num_k_heads >= 0 && num_v_heads >= 0, 81);

    if num_k_heads == 0 as i64 {
        return 0 as i64;
    }

    if num_v_heads % num_k_heads == 0 as i64 {
        return 1 as i64;
    }
    return 0 as i64;
}
// final_output_width: line 480, `head_v_dim * num_v_heads`.

fn final_output_width(hv: i64, nv: i64) -> i64 {
    fgg_ensure(hv >= 0 && nv >= 0, 82);
    return hv * nv;
}
// final_output_rows: line 480, `n_seq_tokens * n_seqs`.

fn final_output_rows(nt: i64, ns: i64) -> i64 {
    fgg_ensure(nt >= 0 && ns >= 0, 83);
    return nt * ns;
}
// Tensor-shape geometry from models/qwen35moe.cpp:54-96.
//
// This is what decides every expert and SSM tensor's declared shape at load time. A wrong value
// here is exactly what produced "blk.1.attn_qkv.weight has wrong shape" earlier, so the divisions
// belong in Goose where the gate can hold them.
// n_ff_exp: line 57, `hparams.n_ff_exp() ? that : n_ff / n_expert_used`.

fn n_ff_exp(declared: i64, n_ff: i64, n_expert_used: i64) -> i64 {
    fgg_ensure(n_expert_used > 0, 90);

    if declared != 0 as i64 {
        return declared;
    }
    return n_ff / n_expert_used;
}
// n_ff_shexp: line 58, `hparams.n_ff_shexp ? that : n_ff`.

fn n_ff_shexp(declared: i64, n_ff: i64) -> i64 {
    if declared != 0 as i64 {
        return declared;
    }
    return n_ff;
}
// key_dim / value_dim / conv_dim: lines 65-67.

fn key_dim(head_k_dim: i64, n_k_heads: i64) -> i64 {
    fgg_ensure(head_k_dim >= 0 && n_k_heads >= 0, 91);
    return head_k_dim * n_k_heads;
}

fn value_dim(head_v_dim: i64, n_v_heads: i64) -> i64 {
    fgg_ensure(head_v_dim >= 0 && n_v_heads >= 0, 92);
    return head_v_dim * n_v_heads;
}
// conv_dim = key_dim*2 + value_dim

fn conv_dim(key_d: i64, value_d: i64) -> i64 {
    fgg_ensure(key_d >= 0 && value_d >= 0, 93);
    return key_d * 2 as i64 + value_d;
}
// wqkv_width: line 86, `{ n_embd, key_dim*2 + value_dim }`.

fn wqkv_width(key_d: i64, value_d: i64) -> i64 {
    return conv_dim(key_d, value_d);
}
// build_moe_ffn tail, from llama-graph.cpp:2129-2440.
// merged_half: line 2383, `n_ff = gate_up->ne[0] / 2` -- the merged gate_up tensor holds gate
// and up side by side, so each half is half the row.

fn merged_half(ne0: i64) -> i64 {
    fgg_ensure(ne0 >= 0, 100);
    return ne0 / 2 as i64;
}
// up_view_offset: line 2387, the up view starts one half-row in:
//   n_ff * nb0, where nb0 is the element size.

fn up_view_offset(n_ff: i64) -> i64 {
    fgg_ensure(n_ff >= 0, 101);
    return n_ff;
}
// has_gate: line 2412, `gate_exps || gate_up_exps`.

fn has_gate(has_gate_exps: i64, has_gate_up: i64) -> i64 {
    if has_gate_exps != 0 || has_gate_up != 0 {
        return 1 as i64;
    }
    return 0 as i64;
}
// swiglu_limit_used: line 2420-2422, `limit > eps` with eps = 1e-6f.
// The comparison is on float bits; 1e-6f = 0x358637BD. Only greater-than matters, and every
// non-negative float below that pattern compares less, so an integer compare on the bit pattern
// is exact for non-negative finite values.

fn swiglu_limit_used(limit_bits: i64) -> i64 {
    const EPS_BITS: i64 = 897988541 as i64;
    // 0x358637BD = 1e-6f (checked, not hand-computed)

    if limit_bits <= 0 as i64 {
        return 0 as i64;
    }
    // negative or zero

    if limit_bits > EPS_BITS {
        return 1 as i64;
    }
    return 0 as i64;
}
// fused_swiglu_clamp: line 2423, the architectures that have a fused clamped swiglu rather than
// the clamp/silu/mul sequence.

fn fused_swiglu_clamp(is_maple: i64, is_dsv4: i64, is_glm5: i64, is_dflash: i64, has_hc: i64, is_hy_v4: i64) -> i64 {
    if is_maple != 0 || is_dsv4 != 0 || is_glm5 != 0 || is_hy_v4 != 0 {
        return 1 as i64;
    }

    if is_dflash != 0 && has_hc != 0 {
        return 1 as i64;
    }
    return 0 as i64;
}

// ---- composed from goose/model/qwen35moe.goose ----
// P6-05 architecture 1: qwen35moe (Apex) builder preparation.
//
// This is the decision/shape half of the builder, not the graph emitter. It
// reuses the accepted qwen35moe slice in base/model_graph.goose (a verbatim
// copy of goose/model/goose-model-graph.goose with only its `fn main()` removed):
//   is_recr, n_ff_exp, n_ff_shexp, key_dim, value_dim, conv_dim, wqkv_width,
//   head_v_dim, conv_channels, qkv_dim, q_full_width, gate_elem_offset.
//
// Native anchors (src/models/qwen35moe.cpp):
//   trunk tensors and shapes        :54-100
//   MTP tensors and shapes          :102-146
//   layer loop and kind choice      :166-232
//   full-attention QKV/norm/rope    :276-355
//   gated delta net geometry        :357-484
//   MoE + gated shared expert       :486-548
//   MTP block                       :551-735
//
// The parameter vector p is indexed by the P_* constants. The shape function
// answers exactly what load_arch_tensors declares; the plan function answers
// the per-layer kind (0 attention, 1 recurrent, 2 MTP).



// p indices
const P_N_EMBD: i64 = 0;
const P_N_VOCAB: i64 = 1;
const P_N_LAYER: i64 = 2;
const P_N_LAYER_ALL: i64 = 3;
const P_N_HEAD: i64 = 4;
const P_N_HEAD_KV: i64 = 5;
const P_N_FF: i64 = 6;
const P_N_EXPERT: i64 = 7;
const P_N_EXPERT_USED: i64 = 8;
const P_N_FF_EXP: i64 = 9;      // declared, 0 -> n_ff / n_expert_used
const P_N_FF_SHEXP: i64 = 10;   // declared, 0 -> n_ff
const P_D_CONV: i64 = 11;
const P_D_INNER: i64 = 12;
const P_D_STATE: i64 = 13;
const P_DT_RANK: i64 = 14;
const P_N_GROUP: i64 = 15;
const P_HEAD_K: i64 = 16;
const P_INTERVAL: i64 = 17;
const P_HAS_OUTPUT: i64 = 18;
const P_LEN: i64 = 19;

// layer kinds
const K_ATTN: i64 = 0;
const K_RECR: i64 = 1;
const K_MTP: i64 = 2;

// tensor ids
const T_TOKEN_EMBD: i64 = 0;
const T_OUTPUT_NORM: i64 = 1;
const T_OUTPUT: i64 = 2;
const T_ATTN_NORM: i64 = 3;
const T_ATTN_POST_NORM: i64 = 4;
const T_ATTN_QKV: i64 = 5;
const T_ATTN_OUT: i64 = 6;
const T_ATTN_Q_NORM: i64 = 7;
const T_ATTN_K_NORM: i64 = 8;
const T_WQKV: i64 = 9;
const T_WQKV_GATE: i64 = 10;
const T_SSM_CONV1D: i64 = 11;
const T_SSM_DT: i64 = 12;
const T_SSM_A: i64 = 13;
const T_SSM_BETA: i64 = 14;
const T_SSM_ALPHA: i64 = 15;
const T_SSM_NORM: i64 = 16;
const T_SSM_OUT: i64 = 17;
const T_FFN_GATE_INP: i64 = 18;
const T_FFN_DOWN_EXPS: i64 = 19;
const T_FFN_GATE_UP_EXPS: i64 = 20;
const T_FFN_GATE_EXPS: i64 = 21;
const T_FFN_UP_EXPS: i64 = 22;
const T_FFN_GATE_INP_SHEXP: i64 = 23;
const T_FFN_GATE_SHEXP: i64 = 24;
const T_FFN_UP_SHEXP: i64 = 25;
const T_FFN_DOWN_SHEXP: i64 = 26;
const T_NEXTN_EH_PROJ: i64 = 27;
const T_NEXTN_ENORM: i64 = 28;
const T_NEXTN_HNORM: i64 = 29;
const T_NEXTN_EMBED: i64 = 30;
const T_NEXTN_HEAD: i64 = 31;
const T_NEXTN_HEAD_NORM: i64 = 32;
const T_LEN: i64 = 33;

fn q_ensure(v: bool, c: i64) {
    if !v {
        fail(c);
    }
}

fn q_put3(out: i64[:], a: i64, b: i64, c: i64) {
    out[0] = a;
    out[1] = b;
    out[2] = c;
}

// 0 attention, 1 recurrent, 2 MTP. flags_base is the address of the native
// per-layer u32 array; 0 selects the interval formula the loader uses when
// LLM_KV_ATTENTION_RECURRENT_LAYERS is absent.
export fn q35_kind(p: i64[:], il: i64, flags_base: i64) -> i64 {
    q_ensure(p.len >= P_LEN, 10);
    if il < 0 {
        return -1;
    }
    if il >= p[P_N_LAYER] {
        return if il < p[P_N_LAYER_ALL] { K_MTP } else { -1 };
    }
    if flags_base != 0 {
        let r = is_recr(il, p[P_N_LAYER_ALL], flags_base as! u64);
        if r == 1 { return K_RECR; }
        if r == 0 { return K_ATTN; }
        return -1;
    }
    let interval = p[P_INTERVAL];
    if interval <= 0 {
        return K_ATTN;
    }
    return if (il + 1) % interval != 0 { K_RECR } else { K_ATTN };
}

export fn q35_plan(p: i64[:], flags_base: i64, kinds: i64[:]) -> i64 {
    q_ensure(p.len >= P_LEN, 11);
    q_ensure(kinds.len >= p[P_N_LAYER_ALL], 12);
    var i: i64 = 0;
    while i < p[P_N_LAYER_ALL] {
        kinds[i] = q35_kind(p, i, flags_base);
        i = i + 1;
    }
    return p[P_N_LAYER_ALL];
}

// Shape of one tensor for a layer of the given kind. Returns 1 when the tensor
// exists for that kind and fills out[0..2], 0 when the kind does not own it.
// The values are exactly the loader's declarations; n_ff_exp/n_ff_shexp follow
// the declared-else-derived rule at qwen35moe.cpp:57-58.
export fn q35_shape(p: i64[:], kind: i64, tid: i64, out: i64[:]) -> i64 {
    q_ensure(p.len >= P_LEN, 20);
    q_ensure(out.len >= 3, 21);

    let n_embd = p[P_N_EMBD];
    let n_vocab = p[P_N_VOCAB];
    let n_ff = p[P_N_FF];
    let n_expert = p[P_N_EXPERT];
    let used = p[P_N_EXPERT_USED];
    let n_ff_exp_v = n_ff_exp(p[P_N_FF_EXP], n_ff, used);
    let n_ff_shexp_v = n_ff_shexp(p[P_N_FF_SHEXP], n_ff);

    let d_state = p[P_D_STATE];
    let d_inner = p[P_D_INNER];
    let dt_rank = p[P_DT_RANK];
    let n_group = p[P_N_GROUP];
    let head_v = head_v_dim(d_inner, dt_rank);
    let key_d = key_dim(d_state, n_group);
    let value_d = value_dim(head_v, dt_rank);
    let conv_d = conv_dim(key_d, value_d);
    let qkv_w = wqkv_width(key_d, value_d);

    let head_k = p[P_HEAD_K];
    let n_head = p[P_N_HEAD];
    let n_head_kv = p[P_N_HEAD_KV];
    let n_embd_k_gqa = head_k * n_head_kv;
    let n_embd_v_gqa = head_v * n_head_kv;
    let q_width = q_full_width(head_k) * n_head;
    let qkv_fused = q_width + n_embd_k_gqa + n_embd_v_gqa;
    let wo_in = head_k * n_head;

    if tid == T_TOKEN_EMBD {
        q_put3(out, n_embd, n_vocab, 1);
        return 1;
    }
    if tid == T_OUTPUT {
        // output is optional; when absent the loader duplicates token_embd and
        // the declared shape is the same either way.
        q_put3(out, n_embd, n_vocab, 1);
        return 1;
    }
    if tid == T_OUTPUT_NORM || tid == T_ATTN_NORM || tid == T_ATTN_POST_NORM {
        q_put3(out, n_embd, 1, 1);
        return 1;
    }

    if kind == K_ATTN || kind == K_MTP {
        if tid == T_ATTN_QKV { q_put3(out, n_embd, qkv_fused, 1); return 1; }
        if tid == T_ATTN_OUT { q_put3(out, wo_in, n_embd, 1); return 1; }
        if tid == T_ATTN_Q_NORM || tid == T_ATTN_K_NORM { q_put3(out, head_k, 1, 1); return 1; }
    }

    if kind == K_RECR {
        if tid == T_WQKV { q_put3(out, n_embd, qkv_w, 1); return 1; }
        if tid == T_WQKV_GATE { q_put3(out, n_embd, value_d, 1); return 1; }
        if tid == T_SSM_CONV1D { q_put3(out, p[P_D_CONV], conv_d, 1); return 1; }
        if tid == T_SSM_DT || tid == T_SSM_A { q_put3(out, dt_rank, 1, 1); return 1; }
        if tid == T_SSM_BETA || tid == T_SSM_ALPHA { q_put3(out, n_embd, dt_rank, 1); return 1; }
        if tid == T_SSM_NORM { q_put3(out, head_v, 1, 1); return 1; }
        if tid == T_SSM_OUT { q_put3(out, value_d, n_embd, 1); return 1; }
    }

    if kind == K_ATTN || kind == K_RECR || kind == K_MTP {
        if tid == T_FFN_GATE_INP { q_put3(out, n_embd, n_expert, 1); return 1; }
        if tid == T_FFN_DOWN_EXPS { q_put3(out, n_ff_exp_v, n_embd, n_expert); return 1; }
        if tid == T_FFN_GATE_UP_EXPS { q_put3(out, n_embd, n_ff_exp_v * 2, n_expert); return 1; }
        if tid == T_FFN_GATE_EXPS || tid == T_FFN_UP_EXPS { q_put3(out, n_embd, n_ff_exp_v, n_expert); return 1; }
        if tid == T_FFN_GATE_INP_SHEXP { q_put3(out, n_embd, 1, 1); return 1; }
        if tid == T_FFN_GATE_SHEXP || tid == T_FFN_UP_SHEXP { q_put3(out, n_embd, n_ff_shexp_v, 1); return 1; }
        if tid == T_FFN_DOWN_SHEXP { q_put3(out, n_ff_shexp_v, n_embd, 1); return 1; }
    }

    if kind == K_MTP {
        if tid == T_NEXTN_EH_PROJ { q_put3(out, n_embd * 2, n_embd, 1); return 1; }
        if tid == T_NEXTN_ENORM || tid == T_NEXTN_HNORM || tid == T_NEXTN_HEAD_NORM { q_put3(out, n_embd, 1, 1); return 1; }
        if tid == T_NEXTN_EMBED || tid == T_NEXTN_HEAD { q_put3(out, n_embd, n_vocab, 1); return 1; }
    }

    return 0;
}

// ---- IMRoPE, the family's rope variant ----
//
// qwen35moe.cpp:9 reads rope.dimension_sections (four values, [11 11 10 0] for Apex)
// and passes them to ggml_rope_multi. This is NOT ggml_rope_ext: the sections split
// the rotary dimension into bands, and using the plain variant produced a layer whose
// arms agreed with each other while neither matched the model.
extern "fg158_rope_multi" fn rope_multi(c: i64, a: i64, pos: i64, n_rot: i64,
    s0: i64, s1: i64, s2: i64, s3: i64, mode: i64, n_ctx_orig: i64,
    fb: i64, fs: i64, ef: i64, af: i64, bf: i64, bs: i64) -> i64;

export fn q35_rope_multi(c: i64, a: i64, pos: i64, n_rot: i64,
                         s0: i64, s1: i64, s2: i64, s3: i64, mode: i64,
                         n_ctx_orig: i64, fb: i64, fs: i64, ef: i64,
                         af: i64, bf: i64, bs: i64) -> i64 {
    if a == 0 || n_rot <= 0 {
        q_ensure(false, 30);
    }
    let r: i64 = rope_multi(c, a, pos, n_rot, s0, s1, s2, s3, mode,
                            n_ctx_orig, fb, fs, ef, af, bf, bs);
    if r == 0 {
        q_ensure(false, 32);
    }
    return r;
}

// ---- composed from goose/model/qgate-split.goose ----
// The joint QG split of the Qwen hybrid family (qwen35moe, qwen3next).
//
// From llama.cpp/src/models/qwen35moe.cpp:293-300:
//
//   ggml_tensor * Qcur = ggml_view_3d(ctx0, Qcur_full, n_embd_head, n_head, n_tokens,
//       ggml_element_size(Qcur_full) * n_embd_head * 2,
//       ggml_element_size(Qcur_full) * n_embd_head * 2 * n_head, 0);
//
// The Q projection emits query and gate interleaved per head, so the head stride is
// two head widths and the gate sits one head width inside each head. Splitting the
// tensor into halves would run and compute nonsense, which is why this is a module
// decision and not a host convenience.
//
// The module owns the numbers; the host owns the view primitive.
extern "fg158_view4" fn view4(c: i64, a: i64, n0: i64, n1: i64, n2: i64, n3: i64,
                              nb1: i64, nb2: i64, nb3: i64, offset: i64) -> i64;
// Reuse the graph builder's abort so a refusal stops loudly instead of returning a
// plausible handle.
extern "fg158_fail" fn fail(code: i64);

export fn qg_split(c: i64, qfull: i64, head_dim: i64, n_head: i64, n_tokens: i64,
                   elem: i64, out: i64[:]) -> i64 {
    if head_dim <= 0 {
        fail(60);
    }
    if n_head <= 0 {
        fail(61);
    }
    if n_tokens <= 0 {
        fail(62);
    }
    if elem <= 0 {
        fail(63);
    }
    if out.len < 2 {
        fail(64);
    }

    let head_stride = elem * head_dim * 2;
    let tok_stride  = head_stride * n_head;
    let seq_stride  = tok_stride * n_tokens;

    out[0] = view4(c, qfull, head_dim, n_head, n_tokens, 1,
                   head_stride, tok_stride, seq_stride, 0);
    out[1] = view4(c, qfull, head_dim, n_head, n_tokens, 1,
                   head_stride, tok_stride, seq_stride, elem * head_dim);
    return 2;
}

// ---- composed from goose/model/qwen35-attention.goose ----
// Depends on the accepted typed graph builder and qg_split. Handles, immutable
// weights/config, argument workspace and node workspace belong to the caller.
extern "fg156_tget" fn qa_get(t: i64, field: i64, index: i64) -> u64;
extern "fg156_tset" fn qa_set(t: i64, field: i64, index: i64, value: u64);
extern "fg156_name" fn qa_name(t: i64, source: i64, style: i64);
extern "fg_q35_fwht_node" fn qa_fwht_node(c: i64, input: i64, width: i64) -> i64;
extern "fg_q35_rms_mul_enabled" fn qa_rms_mul_enabled() -> bool;

fn qa_begin(work: i64[:], mode: i64, c: i64, a: i64, b: i64, d: i64, op: i64) {
    var i: i64 = 0;
    while i < 16 {
        work[i] = 0;
        i += 1;
    }
    work[0] = mode;
    work[1] = c;
    work[2] = a;
    work[3] = b;
    work[4] = d;
    work[5] = op;
}

fn qa_binary(c: i64, a: i64, b: i64, op: i64, work: i64[:]) -> i64 {
    qa_begin(work, 1, c, a, b, 0, op);
    return gb_common_args(work);
}

fn qa_mm(c: i64, weight: i64, input: i64, work: i64[:]) -> i64 {
    qa_begin(work, 11, c, weight, input, 0, gb_op(1));
    return gb_common_args(work);
}

fn qa_rms(c: i64, input: i64, epsilon: i64, work: i64[:]) -> i64 {
    qa_begin(work, 4, c, input, 0, 0, 25);
    work[7] = epsilon;
    return gb_common_args(work);
}

fn qa_weighted_rms(c: i64, input: i64, weight: i64, epsilon: i64, work: i64[:]) -> i64 {
    let normalized = qa_rms(c, input, epsilon, work);
    if normalized == 0 { return 0; }
    if !qa_rms_mul_enabled() { return qa_binary(c, normalized, weight, 7, work); }
    qa_set(normalized, 8, 1, weight as u64);
    qa_set(normalized, 10, 14, 1);
    return normalized;
}

// The accepted EXP156 reshape policy, using an existing native view allocation
// primitive and POD projections. Only contiguous F32 intermediates reach it.
fn qa_reshape(c: i64, a: i64, n0: i64, n1: i64, n2: i64, n3: i64) -> i64 {
    ensure(prop(a, 0) == 0 && pred(0, a, 0) != 0, 901);
    ensure(times(times(n0, n1), times(n2, n3)) == pred(13, a, 0), 902);
    let r = view(c, a);
    qa_set(r, 0, 0, n0 as u64);
    qa_set(r, 0, 1, n1 as u64);
    qa_set(r, 0, 2, n2 as u64);
    qa_set(r, 0, 3, n3 as u64);
    qa_set(r, 1, 0, 4 as u64);
    qa_set(r, 1, 1, times(n0, 4) as u64);
    qa_set(r, 1, 2, times(times(n0, n1), 4) as u64);
    qa_set(r, 1, 3, times(times(times(n0, n1), n2), 4) as u64);
    qa_set(r, 7, 0, 36 as u64);
    qa_set(r, 8, 0, a as u64);
    qa_name(r, a, 1);
    return r;
}

// Exact fixed-axis specialization of the accepted EXP156 permutation policy.
// Unlike a contiguous copy this preserves strides, view roots and op params.
fn qa_permute(c: i64, a: i64) -> i64 {
    let r = view(c, a);
    var i: i64 = 0;
    while i < 4 {
        let axis: i64 = if i == 1 { 2 } else { if i == 2 { 1 } else { i } };
        qa_set(r, 0, axis, qa_get(a, 0, i));
        qa_set(r, 1, axis, qa_get(a, 1, i));
        qa_set(r, 10, i, axis as u64);
        i += 1;
    }
    qa_set(r, 7, 0, 38 as u64);
    qa_set(r, 8, 0, a as u64);
    qa_name(r, a, 2);
    return r;
}

fn qa_rope(c: i64, a: i64, positions: i64, cfg: i64[:], sections: i64, work: i64[:]) -> i64 {
    qa_begin(work, 25, c, a, positions, 0, cfg[3]);
    work[7] = cfg[2];
    work[8] = cfg[4];
    var j: i64 = 0;
    while j < 6 {
        work[9 + j] = cfg[6 + j];
        j += 1;
    }
    work[15] = sections;
    return gb_common_args(work);
}

// weights: pre_norm, QG, K, V, O, Q_norm, K_norm, post_norm.
// cfg: heads, KV_heads, n_rot, rope_type, original_context, epsilon_bits,
// base/scale/ext/attn/beta_fast/beta_slow bits, attention_scale_bits, F32_prec.
export fn q35_attn_project(c: i64, x: i64, positions: i64, weights: i64[:], cfg: i64[:],
                          sections: i64, work: i64[:], nodes: i64[:]) -> i64 {
    if c == 0 || x == 0 || positions == 0 || sections == 0 || weights.len < 8 || cfg.len < 14 || work.len < 16 || nodes.len < 29 {
        return 0;
    }
    var j: i64 = 0;
    while j < 8 {
        if weights[j] == 0 { return 0; }
        j += 1;
    }
    let h = cfg[0];
    let hk = cfg[1];
    let k = ne(x, 0);
    let t = ne(x, 1);
    if h <= 0 || hk <= 0 || h % hk != 0 || k <= 0 || t <= 0 || ne(x, 2) != 1 || ne(x, 3) != 1 || prop(x, 0) != 0 {
        return 0;
    }
    if ne(weights[1], 1) % times(h, 2) != 0 { return 0; }
    let hd = ne(weights[1], 1) / times(h, 2);
    if hd <= 0 || cfg[2] <= 0 || cfg[2] % 2 != 0 || cfg[2] > hd || cfg[3] != 40 || cfg[4] <= 0 {
        return 0;
    }
    if !(float_bits(cfg[5]) >= 0.0) || !(float_bits(cfg[6]) > 0.0) || !(float_bits(cfg[7]) > 0.0) {
        return 0;
    }
    if prop(positions, 0) != 26 || ne(positions, 0) != times(t, 4) {
        return 0;
    }
    if ne(weights[0], 0) != k || ne(weights[7], 0) != k || ne(weights[5], 0) != hd || ne(weights[6], 0) != hd {
        return 0;
    }
    if ne(weights[1], 0) != k || ne(weights[2], 0) != k || ne(weights[3], 0) != k ||
       ne(weights[2], 1) != times(hd, hk) || ne(weights[3], 1) != times(hd, hk) ||
       ne(weights[4], 0) != times(hd, h) || ne(weights[4], 1) != k {
        return 0;
    }
    nodes[1] = qa_weighted_rms(c, x, weights[0], cfg[5], work);
    nodes[2] = qa_mm(c, weights[1], nodes[1], work);
    nodes[3] = qa_mm(c, weights[2], nodes[1], work);
    nodes[4] = qa_mm(c, weights[3], nodes[1], work);
    if qg_split(c, nodes[2], hd, h, t, 4, nodes[5 .. 7]) != 2 { return 0; }
    nodes[7] = qa_reshape(c, nodes[3], hd, hk, t, 1);
    nodes[8] = qa_reshape(c, nodes[4], hd, hk, t, 1);
    nodes[10] = qa_weighted_rms(c, nodes[5], weights[5], cfg[5], work);
    nodes[12] = qa_weighted_rms(c, nodes[7], weights[6], cfg[5], work);
    nodes[13] = qa_rope(c, nodes[10], positions, cfg, sections, work);
    nodes[14] = qa_rope(c, nodes[12], positions, cfg, sections, work);
    qa_begin(work, 24, c, nodes[6], 0, 0, 35);
    work[7] = times(hd, h);
    work[8] = t;
    work[9] = 1;
    work[10] = 1;
    nodes[15] = gb_common_args(work);
    return nodes[13];
}

// K/V may be fresh projection tensors or later cache views. The caller inserts
// the state update between project and finish; this function owns the MHA path.
fn qa_attn_finish(c: i64, x: i64, q: i64, k: i64, v: i64, gate: i64, mask: i64,
                  weights: i64[:], cfg: i64[:], work: i64[:], nodes: i64[:], value_rotation: i64) -> i64 {
    if c == 0 || x == 0 || q == 0 || k == 0 || v == 0 || gate == 0 ||
       weights.len < 8 || cfg.len < 14 || work.len < 16 || nodes.len < 29 {
        return 0;
    }
    nodes[16] = qa_permute(c, q);
    nodes[17] = qa_permute(c, k);
    nodes[18] = qa_permute(c, v);
    nodes[19] = nodes[17];
    nodes[20] = nodes[18];
    if prop(nodes[17], 0) == 0 {
        qa_begin(work, 22, c, nodes[17], 0, 0, gb_type(1));
        nodes[19] = gb_common_args(work);
    }
    if prop(nodes[18], 0) == 0 {
        qa_begin(work, 22, c, nodes[18], 0, 0, gb_type(1));
        nodes[20] = gb_common_args(work);
    }
    qa_begin(work, 26, c, nodes[16], nodes[19], nodes[20], 0);
    work[7] = mask;
    work[8] = cfg[12];
    nodes[21] = gb_common_args(work);
    qa_begin(work, 35, c, nodes[21], 0, 0, 2);
    work[7] = cfg[13];
    if gb_common_args(work) != 1 { return 0; }
    let attention = if value_rotation == 0 { nodes[21] } else { qa_fwht_node(c, nodes[21], value_rotation) };
    if attention == 0 { return 0; }
    nodes[22] = qa_reshape(c, attention, times(ne(q, 0), ne(q, 1)), ne(q, 2), 1, 1);
    qa_begin(work, 3, c, gate, 0, 0, 7);
    nodes[23] = gb_common_args(work);
    nodes[24] = qa_binary(c, nodes[22], nodes[23], 7, work);
    nodes[25] = qa_mm(c, weights[4], nodes[24], work);
    nodes[26] = qa_binary(c, nodes[25], x, 2, work);
    nodes[28] = qa_weighted_rms(c, nodes[26], weights[7], cfg[5], work);
    return nodes[28];
}

export fn q35_attn_finish(c: i64, x: i64, q: i64, k: i64, v: i64, gate: i64, mask: i64,
                         weights: i64[:], cfg: i64[:], work: i64[:], nodes: i64[:]) -> i64 {
    return qa_attn_finish(c, x, q, k, v, gate, mask, weights, cfg, work, nodes, 0);
}

export fn q35_attn_block(c: i64, x: i64, positions: i64, mask: i64, weights: i64[:], cfg: i64[:],
                        sections: i64, work: i64[:], nodes: i64[:]) -> i64 {
    if mask == 0 { return 0; }
    if q35_attn_project(c, x, positions, weights, cfg, sections, work, nodes) == 0 { return 0; }
    return q35_attn_finish(c, x, nodes[13], nodes[14], nodes[8], nodes[15], mask, weights, cfg, work, nodes);
}

// ---- composed from goose/model/qwen35-kv.goose ----
// Single-stream contiguous-prefix session state:
// [914, capacity, valid_prefix, native_padding, pending_tokens, generation].
fn qk_state_ok(state: i64[:]) -> bool {
    if state.len < 6 { return false; }
    return state[0] == 914 && state[1] > 0 && state[1] <= 2147483647 &&
           state[2] >= 0 && state[2] <= state[1] && state[3] > 0 && state[3] <= state[1] &&
           (state[3] & (state[3] - 1)) == 0 && state[1] % state[3] == 0 &&
           state[4] >= 0 && state[4] <= state[1] - state[2] && state[5] >= 0;
}

export fn q35_kv_init(capacity: i64, padding: i64, state: i64[:]) -> i64 {
    if state.len < 6 || capacity <= 0 || capacity > 2147483647 || padding <= 0 || padding > capacity ||
       (padding & (padding - 1)) != 0 || capacity % padding != 0 {
        return -1;
    }
    state[0] = 914;
    state[1] = capacity;
    state[2] = 0;
    state[3] = padding;
    state[4] = 0;
    state[5] = 0;
    return 0;
}

export fn q35_kv_read_rows(state: i64[:], added: i64) -> i64 {
    if !qk_state_ok(state) || (state[4] != 0 && state[4] != added) || added <= 0 || added > state[1] - state[2] { return -1; }
    let step: i64 = if state[3] > 256 { state[3] } else { 256 };
    let used: i64 = state[2] + added;
    let padded: i64 = ((used + step - 1) / step) * step;
    let result: i64 = if padded > step { padded } else { step };
    return if result < state[1] { result } else { state[1] };
}

// One ticket for the complete model step, shared by every layer's cache build.
export fn q35_kv_begin(state: i64[:], added: i64) -> i64 {
    if !qk_state_ok(state) || state[4] != 0 || q35_kv_read_rows(state, added) < 0 || state[5] == 9223372036854775807 { return -1; }
    state[4] = added;
    state[5] += 1;
    return state[5];
}

export fn q35_kv_indices(state: i64[:], added: i64, out: i64[:]) -> i64 {
    if q35_kv_read_rows(state, added) < 0 || out.len < added { return -1; }
    var i: i64 = 0;
    while i < added { out[i] = q35_kv_position(state[2], i, 0); i += 1; }
    return added;
}

fn q35_kv_position(prefix: i64, token: i64, plane: i64) -> i64 {
    return if plane < 3 { prefix + token } else { 0 };
}

export fn q35_kv_positions(state: i64[:], added: i64, out: i64[:]) -> i64 {
    if q35_kv_read_rows(state, added) < 0 || out.len < added * 4 { return -1; }
    var s: i64 = 0;
    while s < 4 {
        var i: i64 = 0;
        while i < added {
            out[s * added + i] = q35_kv_position(state[2], i, s);
            i += 1;
        }
        s += 1;
    }
    return added * 4;
}

// Caller uploads/converts this host mask through its backend input primitive.
export fn q35_kv_mask(state: i64[:], added: i64, out: f32[:]) -> i64 {
    let rows: i64 = q35_kv_read_rows(state, added);
    if rows < 0 || out.len < rows * added { return -1; }
    let negative_infinity: f32 = float_bits(4286578688);
    var i: i64 = 0;
    while i < added {
        var j: i64 = 0;
        while j < rows {
            out[i * rows + j] = if j <= state[2] + i { 0.0 } else { negative_infinity };
            j += 1;
        }
        i += 1;
    }
    return rows;
}

export fn q35_kv_commit(state: i64[:], ticket: i64) -> i64 {
    if !qk_state_ok(state) || state[4] <= 0 || state[5] != ticket { return -1; }
    state[2] += state[4];
    state[4] = 0;
    return state[2];
}

export fn q35_kv_abort(state: i64[:], ticket: i64) -> i64 {
    if !qk_state_ok(state) || state[4] <= 0 || state[5] != ticket || state[5] == 9223372036854775807 { return -1; }
    state[4] = 0;
    state[5] += 1;
    return state[2];
}

export fn q35_kv_rewind(state: i64[:], prefix: i64) -> i64 {
    if !qk_state_ok(state) || state[4] != 0 || prefix < 0 || prefix > state[2] || state[5] == 9223372036854775807 { return -1; }
    state[2] = prefix;
    state[5] += 1;
    return prefix;
}

fn qk_row_bytes(width: i64) -> i64 {
    if width <= 0 || width > 2147483647 || width % 32 != 0 { return -1; }
    return (width / 32) * 18;
}

// Host byte slices, never raw device pointers. Snapshot metadata:
// [914, capacity, prefix, padding, width, Q4_0, generation, reserved0].
export fn q35_kv_host_save(state: i64[:], width: i64, keys: u8[:], values: u8[:], meta: i64[:], bytes: u8[:]) -> i64 {
    let row: i64 = qk_row_bytes(width);
    if !qk_state_ok(state) || state[4] != 0 || row < 0 || meta.len < 8 { return -1; }
    let n: i64 = row * state[2];
    if keys.len < n || values.len < n || bytes.len < n * 2 { return -1; }
    var i: i64 = 0;
    while i < n { bytes[i] = keys[i]; bytes[n + i] = values[i]; i += 1; }
    meta[0] = 914; meta[1] = state[1]; meta[2] = state[2]; meta[3] = state[3];
    meta[4] = width; meta[5] = 2; meta[6] = state[5]; meta[7] = 0;
    return n * 2;
}

export fn q35_kv_host_restore(state: i64[:], width: i64, keys: u8[:], values: u8[:], meta: i64[:], bytes: u8[:]) -> i64 {
    let row: i64 = qk_row_bytes(width);
    if !qk_state_ok(state) || state[4] != 0 || row < 0 || meta.len < 8 || state[5] == 9223372036854775807 { return -1; }
    if meta[0] != 914 || meta[1] != state[1] || meta[2] < 0 || meta[2] > state[1] || meta[3] != state[3] ||
       meta[4] != width || meta[5] != 2 || meta[6] < 0 || meta[7] != 0 { return -1; }
    let n: i64 = row * meta[2];
    if keys.len < n || values.len < n || bytes.len < n * 2 { return -1; }
    var i: i64 = 0;
    while i < n { keys[i] = bytes[i]; values[i] = bytes[n + i]; i += 1; }
    state[2] = meta[2]; state[4] = 0; state[5] += 1;
    return state[2];
}

// Explicit SET_ROWS dependencies replace reliance on host graph-expand order.
export fn q35_attn_cached(c: i64, x: i64, positions: i64, mask: i64, weights: i64[:], cfg: i64[:], sections: i64,
                          cache_k: i64, cache_v: i64, indices: i64, state: i64[:], ticket: i64, work: i64[:], nodes: i64[:]) -> i64 {
    if c == 0 || x == 0 || cache_k == 0 || cache_v == 0 || indices == 0 || cfg.len < 14 ||
       weights.len < 8 || work.len < 16 || nodes.len < 35 || !qk_state_ok(state) || state[4] <= 0 || state[5] != ticket { return 0; }
    let count: i64 = ne(x, 1);
    let padded_rows: i64 = q35_kv_read_rows(state, count);
    if padded_rows < 0 || cfg[1] <= 0 || state[4] != count { return 0; }
    let read_rows = if mask == 0 { state[2] + count } else { padded_rows };
    let width: i64 = ne(cache_k, 0);
    if qk_row_bytes(width) < 0 || prop(cache_k, 0) != 2 || prop(cache_v, 0) != 2 ||
       ne(cache_v, 0) != width || ne(cache_k, 1) != state[1] || ne(cache_v, 1) != state[1] ||
       ne(cache_k, 2) != 1 || ne(cache_k, 3) != 1 || ne(cache_v, 2) != 1 || ne(cache_v, 3) != 1 ||
       pred(0, cache_k, 0) == 0 || pred(0, cache_v, 0) == 0 ||
       width % cfg[1] != 0 || (width / cfg[1]) % 32 != 0 || prop(indices, 0) != 27 || ne(indices, 0) != count ||
       ne(indices, 1) != 1 || ne(indices, 2) != 1 || ne(indices, 3) != 1 || pred(0, indices, 0) == 0 { return 0; }
    if mask != 0 && (prop(mask, 0) != 1 || ne(mask, 0) != read_rows || ne(mask, 1) < count ||
       ne(mask, 2) != 1 || ne(mask, 3) != 1 || pred(0, mask, 0) == 0) { return 0; }
    if weights[2] == 0 || ne(weights[2], 1) != width { return 0; }
    if q35_attn_project(c, x, positions, weights, cfg, sections, work, nodes) == 0 { return 0; }
    if ne(nodes[14], 0) * ne(nodes[14], 1) != width { return 0; }
    let head: i64 = width / cfg[1];
    var q = nodes[13];
    var k = nodes[14];
    var v = nodes[8];
    var value_rotation: i64 = 0;
    if head % 64 == 0 {
        var key_rotation: i64 = 64;
        while head % (2 * key_rotation) == 0 { key_rotation *= 2; }
        value_rotation = 64;
        q = qa_fwht_node(c, q, key_rotation);
        k = qa_fwht_node(c, k, key_rotation);
        v = qa_fwht_node(c, v, value_rotation);
        if q == 0 || k == 0 || v == 0 { return 0; }
    }
    let k_stride: i64 = qa_get(k, 1, 2) as! i64;
    let v_stride: i64 = qa_get(v, 1, 2) as! i64;
    nodes[29] = view4(c, k, width, count, 1, 1, k_stride, k_stride * count, k_stride * count, 0);
    nodes[30] = view4(c, v, width, count, 1, 1, v_stride, v_stride * count, v_stride * count, 0);
    qa_begin(work, 19, c, cache_k, nodes[29], indices, 0);
    nodes[31] = gb_common_args(work);
    qa_begin(work, 19, c, cache_v, nodes[30], indices, 0);
    nodes[32] = gb_common_args(work);
    let head_bytes: i64 = qk_row_bytes(head);
    let row_bytes: i64 = qk_row_bytes(width);
    let stream_bytes: i64 = row_bytes * state[1];
    nodes[33] = view4(c, nodes[31], head, cfg[1], read_rows, 1, head_bytes, row_bytes, stream_bytes, 0);
    nodes[34] = view4(c, nodes[32], head, cfg[1], read_rows, 1, head_bytes, row_bytes, stream_bytes, 0);
    let result: i64 = qa_attn_finish(c, x, q, nodes[33], nodes[34], nodes[15], mask, weights, cfg, work, nodes, value_rotation);
    if result == 0 { return 0; }
    // Zero is the ordinary attention ABI. The standalone executor reads
    // the positive first-query key count from the private parameter word.
    if mask == 0 { qa_set(nodes[21], 10, 5, (state[2] + 1) as u64); }
    return result;
}

// ---- composed from goose/model/gdn-ops.goose ----
// The two graph operations the recurrent (GDN) path needs and the graph builder has
// no mode for: L2 normalisation and repeat-to-extents.
//
// From llama.cpp/src/models/qwen35moe.cpp:459-470:
//
//   q_conv = ggml_l2_norm(ctx0, q_conv, eps_norm);
//   k_conv = ggml_l2_norm(ctx0, k_conv, eps_norm);
//   if (num_k_heads != num_v_heads) {
//       q_conv = ggml_repeat_4d(ctx0, q_conv, head_k_dim, num_v_heads, n_seq_tokens, n_seqs);
//       k_conv = ggml_repeat_4d(ctx0, k_conv, head_k_dim, num_v_heads, n_seq_tokens, n_seqs);
//   }
//
// The module owns the epsilon policy and the target extents; the host owns the two
// ggml calls.
extern "fg158_l2norm" fn l2norm(c: i64, a: i64, eps_bits: i64) -> i64;
extern "fg158_repeat4" fn repeat4(c: i64, a: i64, n0: i64, n1: i64, n2: i64, n3: i64) -> i64;
extern "fg158_ne" fn ne(t: i64, i: i64) -> i64;
extern "fg158_transpose" fn transpose(c: i64, a: i64) -> i64;
extern "fg158_concat" fn concat(c: i64, a: i64, b: i64, dim: i64) -> i64;
extern "fg158_cpy" fn cpy(c: i64, a: i64, b: i64) -> i64;
extern "fg158_view2" fn view2(c: i64, a: i64, n0: i64, n1: i64, nb1: i64, offset: i64) -> i64;
extern "fg158_reshape3" fn reshape3(c: i64, a: i64, n0: i64, n1: i64, n2: i64) -> i64;

// L2-normalise one tensor. The epsilon is passed as f32 bits so the host does not
// reinterpret a float through an integer parameter.
export fn gdn_l2norm(c: i64, a: i64, eps_bits: i64) -> i64 {
    if a == 0 {
        fail(70);
    }
    let r: i64 = l2norm(c, a, eps_bits);
    if r == 0 {
        fail(71);
    }
    return r;
}

// Repeat q or k to the value head count. The guard is the native one: the value
// count must be a multiple of the key count, otherwise the repeat is not a repeat.
export fn gdn_repeat_to_v(c: i64, a: i64, head_dim: i64, n_k_heads: i64,
                         n_v_heads: i64, n_tokens: i64, n_seqs: i64) -> i64 {
    if n_k_heads <= 0 {
        fail(72);
    }
    if n_v_heads % n_k_heads != 0 {
        fail(73);
    }
    if n_v_heads == n_k_heads {
        return a;   // nothing to repeat; the native builder skips the op too
    }
    let r: i64 = repeat4(c, a, head_dim, n_v_heads, n_tokens, n_seqs);
    if r == 0 {
        fail(74);
    }
    return r;
}

// The qkv views over the convolved output (qwen35moe.cpp:432-452).
//
// The mixed output carries q, k and v at the stride 2*head_k*n_k + head_v*n_v, so
// each view needs its own offset and the same outer strides. These numbers were
// carried in the gate before this export; they are a decision, so they live here.
//
// `which` selects q (0), k (1) or v (2). One symbol with a selector rather than an
// array out-parameter: the C side then calls it with plain integers, and the
// decision - which extents, which offset - never leaves this function.
export fn gdn_qkv_view(c: i64, mixed: i64, which: i64, head_k: i64, n_k: i64,
                       head_v: i64, n_v: i64, n_tokens: i64, n_seqs: i64,
                       elem: i64) -> i64 {
    if head_k <= 0 || n_k <= 0 || head_v <= 0 || n_v <= 0 {
        fail(75);
    }
    if n_tokens <= 0 || n_seqs <= 0 || elem <= 0 {
        fail(76);
    }

    let nb1 = elem * (2 * head_k * n_k + head_v * n_v);
    let nb2 = nb1 * n_tokens;
    let nb3 = nb2 * n_seqs;

    if which == 0 {
        return view4(c, mixed, head_k, n_k, n_tokens, n_seqs,
                     elem * head_k, nb1, nb2, 0);
    }
    if which == 1 {
        return view4(c, mixed, head_k, n_k, n_tokens, n_seqs,
                     elem * head_k, nb1, nb2, elem * head_k * n_k);
    }
    if which == 2 {
        return view4(c, mixed, head_v, n_v, n_tokens, n_seqs,
                     elem * head_v, nb1, nb2, elem * 2 * head_k * n_k);
    }
    fail(78);
    return 0;
}

// ---- the recurrent state update (delta-net-base.cpp:449-496) ----
//
// The state is not a separate subsystem: it is a concat at the front and a cpy of the
// tail at the back, on the same graph, every token.
//
//   conv_states = reshape(build_rs(...), kernel-1, channels, n_seqs)
//   qkv_mixed   = transpose(qkv_mixed)
//   conv_input  = concat(conv_states, qkv_mixed, 0)
//   ... ssm_conv(conv_input, kernel) ...
//   cpy(view_3d(conv_input, tail), view_2d(conv_states_all, slot offset))
//
// The reshaped state is passed in already reshaped by the caller's slot view; the
// decisions that live here are the transpose, the concat axis, which rows are the
// tail, and the slot arithmetic.

// conv_input = concat(state, transpose(mixed), dim 0)
export fn gdn_conv_input(c: i64, state: i64, mixed: i64, elem: i64) -> i64 {
    if state == 0 || mixed == 0 || elem <= 0 {
        fail(80);
    }
    let t: i64 = transpose(c, mixed);
    if t == 0 {
        fail(81);
    }
    let r: i64 = concat(c, state, t, 0);
    if r == 0 {
        fail(82);
    }
    return r;
}

// The tail of conv_input becomes the next state: the last kernel-1 kernel rows.
//
// conv_input is [kernel-1+T, channels], so axis 0 is the kernel position and axis 1
// is the channel. nb[1] is therefore elem * ne0, NOT elem * channels - getting this
// backwards produced a view that read the wrong 24576 elements while every other
// node in the chain still matched, which is exactly what a tail comparison catches
// and a conv-output comparison does not.
export fn gdn_conv_tail(c: i64, conv_input: i64, kernel: i64, channels: i64,
                        n_seqs: i64, elem: i64) -> i64 {
    if kernel < 2 || channels <= 0 || n_seqs <= 0 {
        fail(83);
    }
    let keep: i64 = kernel - 1;
    let total_rows: i64 = ne(conv_input, 0);
    if total_rows < kernel {
        fail(88);
    }
    let nb1: i64 = elem * total_rows;
    let nb2: i64 = nb1 * channels;
    let off_rows: i64 = total_rows - keep;
    return view4(c, conv_input, keep, channels, n_seqs, 1, nb1, nb2, nb2, elem * off_rows);
}

// The destination slot inside the flat per-layer state tensor.
export fn gdn_conv_slot(c: i64, states_all: i64, kernel: i64, channels: i64,
                        n_seqs: i64, slot: i64, mem_size: i64, kv_head: i64,
                        elem: i64) -> i64 {
    if kernel < 2 || channels <= 0 || n_seqs <= 0 || mem_size <= 0 {
        fail(84);
    }
    if slot < 0 || kv_head < 0 || kv_head >= mem_size {
        fail(85);
    }
    let row_count: i64 = (kernel - 1) * channels;
    let row_size: i64 = elem * row_count;
    let nb1: i64 = elem * row_count;
    let offset: i64 = (slot * mem_size + kv_head) * row_size;
    return view2(c, states_all, row_count, n_seqs, nb1, offset);
}

// Write the tail into the slot. Returns the cpy node, which must be part of the graph.
export fn gdn_conv_store(c: i64, tail: i64, dst: i64) -> i64 {
    if tail == 0 || dst == 0 {
        fail(86);
    }
    let r: i64 = cpy(c, tail, dst);
    if r == 0 {
        fail(87);
    }
    return r;
}

// ---- attention KV cache slot ----
//
// The cache is one flat tensor per kind: [head_dim, n_ctx, n_kv_heads, n_layers]. A token
// at position `pos` writes `n_tokens` consecutive positions into its own layer's head
// block, so the slot is
//
//   offset = ((layer * n_kv_heads + head) * n_ctx + pos) * head_dim * elem
//
// and the returned view is [head_dim, n_tokens, n_kv_heads, 1]. The layout and the
// arithmetic are a decision, so they live here rather than in the gate that happens to
// allocate the buffer.
export fn attn_kv_slot(c: i64, cache: i64, layer: i64, pos: i64, head_dim: i64,
                       n_ctx: i64, n_kv_heads: i64, n_layers: i64, n_tokens: i64,
                       elem: i64) -> i64 {
    if cache == 0 || head_dim <= 0 || n_ctx <= 0 || n_kv_heads <= 0 || n_layers <= 0 {
        fail(90);
    }
    if n_tokens <= 0 || elem <= 0 {
        fail(91);
    }
    if layer < 0 || layer >= n_layers {
        fail(92);
    }
    if pos < 0 || pos + n_tokens > n_ctx {
        fail(93);
    }
    let nb1: i64 = elem * head_dim;
    let nb2: i64 = nb1 * n_ctx;
    let nb3: i64 = nb2 * n_kv_heads;
    let offset: i64 = layer * nb3 + pos * nb1;
    return view4(c, cache, head_dim, n_tokens, n_kv_heads, 1, nb1, nb2, nb3, offset);
}

// ---- one slot mechanism for both caches ----
//
// The attention KV cache and the recurrent conv cache answer the same question: "give me
// the view of this layer's state for these positions". They differ only in layout, so the
// layout is a parameter and the arithmetic is written once.
//
// Layout 0 - attention KV: the cache is [head_dim, n_ctx, n_kv_heads, n_layers] and a
// position writes one row of head_dim into its layer's head block.
//
//   offset = layer * (n_kv_heads * n_ctx * head_dim * elem) + pos * (head_dim * elem)
//   view   = [head_dim, n_tokens, n_kv_heads, 1]
//
// Layout 1 - recurrent conv: the cache is flat, one slot per (sequence, layer), each
// holding (kernel-1) rows of the conv channel count.
//
//   offset = (layer * mem_size + kv_head) * ((kernel-1) * channels * elem)
//   view   = [(kernel-1) * channels, n_seqs]
//
// Having one function rather than two copies means a fix to the range checks or to the
// offset form cannot land in one cache and miss the other.
export fn state_slot(c: i64, cache: i64, layout: i64, layer: i64, pos: i64,
                     a: i64, b: i64, c2: i64, n_layers: i64, n_tokens: i64,
                     elem: i64) -> i64 {
    if cache == 0 || n_layers <= 0 || n_tokens <= 0 || elem <= 0 {
        fail(100);
    }
    if layer < 0 || layer >= n_layers {
        fail(101);
    }

    if layout == 0 {
        // a = head_dim, b = n_ctx, c2 = n_kv_heads
        if a <= 0 || b <= 0 || c2 <= 0 {
            fail(102);
        }
        if pos < 0 || pos + n_tokens > b {
            fail(103);
        }
        let nb1 = elem * a;
        let nb2 = nb1 * b;
        let nb3 = nb2 * c2;
        let offset = layer * nb3 + pos * nb1;
        return view4(c, cache, a, n_tokens, c2, 1, nb1, nb2, nb3, offset);
    }

    if layout == 1 {
        // a = kernel (the slot holds kernel-1 rows), b = channels, c2 = mem_size,
        // pos = kv_head inside the sequence. The view is the one gdn_conv_slot returns:
        // [(kernel-1)*channels, n_seqs] with a flat slot stride, so a caller swapping one
        // for the other gets an identical tensor and not merely an equivalent one.
        if a < 2 || b <= 0 || c2 <= 0 {
            fail(104);
        }
        if pos < 0 || pos >= c2 {
            fail(105);
        }
        let row_count = (a - 1) * b;
        let row_size = elem * row_count;
        let offset = (layer * c2 + pos) * row_size;
        return view2(c, cache, row_count, n_tokens, row_size, offset);
    }

    fail(106);
    return 0;
}

// ---- composed from goose/model/qwen35-gdn.goose ----
// Real recurrent-layer orchestration. GGML remains the allocation/math substrate.
extern "sqrtf" fn qg_sqrt(x: f32) -> f32;

// Exact encoding of nonnegative normal F32 parameters, without a new bitcast
// adapter. Binary power-of-two normalization preserves their significands.
fn qg_positive_bits(input: f32) -> i64 {
    if input == 0.0 { return 0; }
    if !(input >= 1.1754943508222875e-38) || !(input <= 3.4028234663852886e38) { return -1; }
    var v: f32 = input;
    var exponent: i64 = 127;
    while v >= 2.0 { v = v * 0.5; exponent += 1; }
    while v < 1.0 { v = v * 2.0; exponent -= 1; }
    let fraction: i64 = ((v - 1.0) * 8388608.0) as i64;
    return exponent * 8388608 + fraction;
}

// cfg: head width, key heads, value heads, kernel, RMS epsilon bits,
// RMS-based L2 epsilon bits, RMS-based L2 scale bits. One sequence, fused K=1.
export fn q35_gdn_config(head: i64, key_heads: i64, value_heads: i64, kernel: i64,
                          epsilon_bits: i64, out: i64[:]) -> i64 {
    if out.len < 7 || head <= 0 || head > 4096 || key_heads <= 0 || value_heads <= 0 ||
       key_heads > 512 || value_heads > 512 || value_heads % key_heads != 0 || kernel < 2 || kernel > 64 { return -1; }
    let epsilon: f32 = float_bits(epsilon_bits);
    if !(epsilon > 0.0) || qg_positive_bits(epsilon) != epsilon_bits { return -1; }
    let e: i64 = qg_positive_bits(epsilon / (head as f32));
    let s: i64 = qg_positive_bits(1.0 / qg_sqrt(head as f32));
    if e < 0 || s < 0 { return -1; }
    out[0] = head; out[1] = key_heads; out[2] = value_heads; out[3] = kernel;
    out[4] = epsilon_bits; out[5] = e; out[6] = s;
    return 7;
}

fn qg_shape(t: i64, n0: i64, n1: i64, n2: i64) -> bool {
    return t != 0 && ne(t, 0) == n0 && ne(t, 1) == n1 && ne(t, 2) == n2 && ne(t, 3) == 1 && pred(0, t, 0) != 0;
}

fn qg_cfg_ok(cfg: i64[:]) -> bool {
    if cfg.len < 7 || cfg[0] <= 0 || cfg[0] > 4096 || cfg[1] <= 0 || cfg[1] > 512 ||
       cfg[2] <= 0 || cfg[2] > 512 || cfg[2] % cfg[1] != 0 || cfg[3] < 2 || cfg[3] > 64 { return false; }
    let epsilon: f32 = float_bits(cfg[4]);
    return epsilon > 0.0 && qg_positive_bits(epsilon) == cfg[4] &&
           qg_positive_bits(epsilon / (cfg[0] as f32)) == cfg[5] &&
           qg_positive_bits(1.0 / qg_sqrt(cfg[0] as f32)) == cfg[6];
}

// Quiescent host-addressable disjoint buffers only; no device pointer access.
// Metadata is the magic followed by the exact seven-word arithmetic config.
export fn q35_gdn_host_save(conv: f32[:], state: f32[:], cfg: i64[:], meta: i64[:], out: f32[:]) -> i64 {
    if !qg_cfg_ok(cfg) || meta.len < 8 { return -1; }
    let nc: i64 = (cfg[3] - 1) * cfg[0] * (2 * cfg[1] + cfg[2]);
    let ns: i64 = cfg[0] * cfg[0] * cfg[2];
    if conv.len != nc || state.len != ns || out.len < nc + ns { return -1; }
    var i: i64 = 0;
    while i < nc { out[i] = conv[i]; i += 1; }
    i = 0; while i < ns { out[nc + i] = state[i]; i += 1; }
    meta[0] = 917;
    i = 0; while i < 7 { meta[i + 1] = cfg[i]; i += 1; }
    return nc + ns;
}

export fn q35_gdn_host_restore(conv: f32[:], state: f32[:], cfg: i64[:], meta: i64[:], data: f32[:]) -> i64 {
    if !qg_cfg_ok(cfg) || meta.len < 8 || meta[0] != 917 { return -1; }
    var i: i64 = 0; while i < 7 { if meta[i + 1] != cfg[i] { return -1; } i += 1; }
    let nc: i64 = (cfg[3] - 1) * cfg[0] * (2 * cfg[1] + cfg[2]);
    let ns: i64 = cfg[0] * cfg[0] * cfg[2];
    if conv.len != nc || state.len != ns || data.len < nc + ns { return -1; }
    i = 0; while i < nc { conv[i] = data[i]; i += 1; }
    i = 0; while i < ns { state[i] = data[nc + i]; i += 1; }
    return nc + ns;
}

extern "fg_q35_ssm_silu_enabled" fn qg_ssm_silu_enabled() -> bool;

fn qg_unary(c: i64, a: i64, op: i64, w: i64[:]) -> i64 {
    qa_begin(w, 3, c, a, 0, 0, op);
    return gb_common_args(w);
}

// weights: pre_norm,QKV,Z,beta,alpha,dt,A,conv,norm,O,post_norm.
// Persistent conv=[kernel-1,channels], state=[head,head,value_heads,1], F32.
// Roots: nodes[16] conv copy, nodes[29] state copy, returned nodes[39] output.
export fn q35_gdn_layer(c: i64, x: i64, conv: i64, state: i64, weights: i64[:], cfg: i64[:],
                         work: i64[:], nodes: i64[:]) -> i64 {
    if c == 0 || x == 0 || conv == 0 || state == 0 || weights.len < 11 || cfg.len < 7 || work.len < 16 || nodes.len < 40 { return 0; }
    let head: i64 = cfg[0]; let nk: i64 = cfg[1]; let nv: i64 = cfg[2]; let kernel: i64 = cfg[3];
    if !qg_cfg_ok(cfg) { return 0; }
    let hidden: i64 = ne(x, 0); let count: i64 = ne(x, 1);
    let vd: i64 = head * nv; let channels: i64 = head * (2 * nk + nv);
    if hidden <= 0 || count <= 0 || count > 4096 || !qg_shape(x, hidden, count, 1) || prop(x, 0) != 0 ||
       !qg_shape(conv, kernel - 1, channels, 1) || prop(conv, 0) != 0 ||
       !qg_shape(state, head, head, nv) || prop(state, 0) != 0 { return 0; }
    var i: i64 = 0;
    while i < 11 { if weights[i] == 0 { return 0; } i += 1; }
    if !qg_shape(weights[0], hidden, 1, 1) || !qg_shape(weights[10], hidden, 1, 1) ||
       !qg_shape(weights[1], hidden, channels, 1) || !qg_shape(weights[2], hidden, vd, 1) ||
       !qg_shape(weights[3], hidden, nv, 1) || !qg_shape(weights[4], hidden, nv, 1) ||
       !qg_shape(weights[5], nv, 1, 1) || !qg_shape(weights[6], nv, 1, 1) ||
       !qg_shape(weights[7], kernel, channels, 1) || !qg_shape(weights[8], head, 1, 1) ||
       !qg_shape(weights[9], vd, hidden, 1) { return 0; }
    if prop(weights[0], 0) != 0 || prop(weights[10], 0) != 0 || prop(weights[5], 0) != 0 ||
       prop(weights[6], 0) != 0 || prop(weights[7], 0) != 0 || prop(weights[8], 0) != 0 { return 0; }
    nodes[1] = qa_weighted_rms(c, x, weights[0], cfg[4], work);
    nodes[2] = qa_mm(c, weights[1], nodes[1], work);
    nodes[3] = qa_reshape(c, nodes[2], channels, count, 1, 1);
    nodes[4] = qa_mm(c, weights[2], nodes[1], work);
    nodes[5] = qa_mm(c, weights[3], nodes[1], work);
    nodes[6] = qa_reshape(c, nodes[5], 1, nv, count, 1);
    nodes[7] = qg_unary(c, nodes[6], 7, work);
    nodes[8] = qa_mm(c, weights[4], nodes[1], work);
    nodes[9] = qa_reshape(c, nodes[8], nv, count, 1, 1);
    nodes[10] = qa_binary(c, nodes[9], weights[5], 2, work);
    nodes[11] = qg_unary(c, nodes[10], 15, work);
    nodes[12] = qa_binary(c, nodes[11], weights[6], 7, work);
    nodes[13] = qa_reshape(c, nodes[12], 1, nv, count, 1);
    nodes[14] = gdn_conv_input(c, conv, nodes[3], 4);
    nodes[15] = gdn_conv_tail(c, nodes[14], kernel, channels, 1, 4);
    nodes[16] = gdn_conv_store(c, nodes[15], conv);
    qa_begin(work, 27, c, nodes[14], weights[7], 0, 0);
    nodes[17] = gb_common_args(work);
    if qg_ssm_silu_enabled() {
        qa_set(nodes[17], 10, 0, 1);
        nodes[18] = nodes[17];
    } else {
        nodes[18] = qg_unary(c, nodes[17], 10, work);
    }
    nodes[19] = gdn_qkv_view(c, nodes[18], 0, head, nk, head, nv, count, 1, 4);
    nodes[20] = gdn_qkv_view(c, nodes[18], 1, head, nk, head, nv, count, 1, 4);
    nodes[21] = gdn_qkv_view(c, nodes[18], 2, head, nk, head, nv, count, 1, 4);
    nodes[22] = qa_rms(c, nodes[19], cfg[5], work);
    qa_begin(work, 8, c, nodes[22], 0, 0, 32); work[7] = cfg[6]; nodes[23] = gb_common_args(work);
    nodes[24] = qa_rms(c, nodes[20], cfg[5], work);
    qa_begin(work, 8, c, nodes[24], 0, 0, 32); work[7] = cfg[6]; nodes[25] = gb_common_args(work);
    qa_begin(work, 28, c, nodes[23], nodes[25], nodes[21], 0);
    work[7] = nodes[13]; work[8] = nodes[7]; work[9] = state; work[10] = 1;
    nodes[26] = gb_common_args(work);
    // The only consumer of the state tail is the copy to this same model
    // state tensor below. A resident backend can publish that tail in place.
    qa_set(nodes[26], 10, 4, 1);
    nodes[27] = view4(c, nodes[26], head, nv, count, 1, head * 4, vd * 4, vd * count * 4, 0);
    nodes[28] = view4(c, nodes[26], head, head, nv, 1, head * 4, head * head * 4, head * head * nv * 4, vd * count * 4);
    nodes[29] = gdn_conv_store(c, nodes[28], state);
    nodes[30] = qa_reshape(c, nodes[4], head, nv, count, 1);
    nodes[32] = qa_weighted_rms(c, nodes[27], weights[8], cfg[4], work);
    nodes[33] = qg_unary(c, nodes[30], 10, work);
    nodes[34] = qa_binary(c, nodes[32], nodes[33], 7, work);
    nodes[35] = qa_reshape(c, nodes[34], vd, count, 1, 1);
    nodes[36] = qa_mm(c, weights[9], nodes[35], work);
    nodes[37] = qa_binary(c, nodes[36], x, 2, work);
    nodes[39] = qa_weighted_rms(c, nodes[37], weights[10], cfg[4], work);
    return nodes[39];
}

// ---- composed from goose/model/qwen35-trunk.goose ----
// Borrow a real read-only mapping into a persistent metadata-only GGML context.
// Context and mapping ownership remain with the model/session, not each graph.
// Reuses the canonical GGUF type table instead of duplicating quant layouts.
extern "ggml_get_no_alloc" fn qm_noalloc(c: i64) -> bool;

export fn q35_bind_weight(c: i64, mapping: u64, mapping_bytes: i64, offset: i64,
                          dtype: i64, shape: i64[:]) -> i64 {
    if c == 0 || mapping == 0 || mapping == 18446744073709551615 || mapping_bytes <= 0 ||
       offset < 0 || offset > mapping_bytes || offset % 8 != 0 || shape.len < 4 || !qm_noalloc(c) { return 0; }
    let block_size: i64 = t_blck_size(dtype);
    let size: i64 = t_type_size(dtype);
    if block_size <= 0 || size <= 0 || shape[0] <= 0 || shape[0] % block_size != 0 { return 0; }
    let blocks: i64 = shape[0] / block_size;
    if blocks > 9223372036854775807 / size { return 0; }
    var bytes: i64 = blocks * size;
    var elements: i64 = shape[0];
    var i: i64 = 1;
    while i < 4 {
        if shape[i] <= 0 || bytes > 9223372036854775807 / shape[i] || elements > 9223372036854775807 / shape[i] { return 0; }
        bytes *= shape[i]; elements *= shape[i]; i += 1;
    }
    if bytes > mapping_bytes - offset || mapping > 18446744073709551615 - ((offset + bytes) as u64) { return 0; }
    let tensor: i64 = fresh(c, dtype, shape[0], shape[1], shape[2], shape[3]);
    qa_set(tensor, 4, 0, mapping + (offset as u64));
    return tensor;
}

fn qm_shape(t: i64, n0: i64, n1: i64, n2: i64) -> bool {
    return t != 0 && ne(t, 0) == n0 && ne(t, 1) == n1 && ne(t, 2) == n2 && ne(t, 3) == 1 && pred(0, t, 0) != 0;
}

fn qm_mm_id(c: i64, w: i64, x: i64, ids: i64, work: i64[:]) -> i64 {
    qa_begin(work, 12, c, w, x, ids, 30);
    return gb_common_args(work);
}

fn qm_swiglu(c: i64, gate: i64, up: i64, work: i64[:]) -> i64 {
    qa_begin(work, 10, c, gate, up, 0, 2);
    return gb_common_args(work);
}

extern "fg_q35_moe_weighted_node" fn qm_weighted(c: i64, input: i64, weights: i64) -> i64;
extern "fg_q35_moe_norm_node" fn qm_route_weights(c: i64, input: i64, ids: i64, scale_bits: i64) -> i64;
extern "fg_q35_moe_norm_enabled" fn qm_norm_enabled() -> bool;

fn qm_route_weights_separate(c: i64, input: i64, ids: i64, experts: i64, used: i64, count: i64,
    scale_bits: i64, work: i64[:]) -> i64 {
    let bank = qa_reshape(c, input, 1, experts, count, 1);
    qa_begin(work, 18, c, bank, ids, 0, 0);
    let selected = qa_reshape(c, gb_common_args(work), used, count, 1, 1);
    qa_begin(work, 14, c, selected, 0, 0, 15);
    let sum = gb_common_args(work);
    qa_begin(work, 9, c, sum, 0, 0, 50);
    work[7] = 947912704; work[8] = 2139095040;
    let normalized = qa_reshape(c, qa_binary(c, selected, gb_common_args(work), 8, work), 1, used, count, 1);
    let scale = float_bits(scale_bits);
    if scale == 0.0 || scale == 1.0 { return normalized; }
    qa_begin(work, 8, c, normalized, 0, 0, 32); work[7] = scale_bits;
    return gb_common_args(work);
}

// Weights: router, up_exps, gate_exps, down_exps, shared_up, shared_gate,
// shared_down, shared_router. cfg: expert_count, used_count, weight_scale_bits.
// No groups, biases, LoRA, split scaling or activation clamps in this path.
// Required nodes length=26. Return includes the gated shared expert.
export fn q35_moe_ffn(c: i64, x: i64, weights: i64[:], cfg: i64[:],
                      work: i64[:], nodes: i64[:]) -> i64 {
    if c == 0 || x == 0 || weights.len < 8 || cfg.len < 3 || work.len < 16 { return 0; }
    let experts: i64 = cfg[0]; let used: i64 = cfg[1];
    if experts <= 0 || experts > 4096 || used <= 0 || used > experts || used > 64 || nodes.len < 26 { return 0; }
    let scale: f32 = float_bits(cfg[2]);
    if !(scale >= 0.0) || !(scale <= 3.4028234663852886e38) { return 0; }
    let hidden: i64 = ne(x, 0); let count: i64 = ne(x, 1);
    if hidden <= 0 || count <= 0 || count > 4096 || prop(x, 0) != 0 || !qm_shape(x, hidden, count, 1) { return 0; }
    var i: i64 = 0; while i < 8 { if weights[i] == 0 { return 0; } i += 1; }
    let ff: i64 = ne(weights[1], 1); let shared: i64 = ne(weights[4], 1);
    if ff <= 0 || shared <= 0 || !qm_shape(weights[0], hidden, experts, 1) || prop(weights[0], 0) != 0 ||
       !qm_shape(weights[1], hidden, ff, experts) || !qm_shape(weights[2], hidden, ff, experts) ||
       !qm_shape(weights[3], ff, hidden, experts) || !qm_shape(weights[4], hidden, shared, 1) ||
       !qm_shape(weights[5], hidden, shared, 1) || !qm_shape(weights[6], shared, hidden, 1) ||
       !qm_shape(weights[7], hidden, 1, 1) || prop(weights[7], 0) != 0 { return 0; }
    nodes[0] = qa_mm(c, weights[0], x, work);
    qa_begin(work, 20, c, nodes[0], 0, 0, 0); work[7] = 1065353216;
    nodes[1] = gb_common_args(work);
    qa_begin(work, 30, c, nodes[1], 0, 0, used); nodes[2] = gb_common_args(work);
    nodes[3] = nodes[2];
    nodes[11] = if qm_norm_enabled() { qm_route_weights(c, nodes[1], nodes[3], cfg[2]) }
        else { qm_route_weights_separate(c, nodes[1], nodes[3], experts, used, count, cfg[2], work) };
    if nodes[11] == 0 { return 0; }
    nodes[12] = qa_reshape(c, x, hidden, 1, count, 1);
    nodes[13] = qm_mm_id(c, weights[1], nodes[12], nodes[3], work);
    nodes[14] = qm_mm_id(c, weights[2], nodes[12], nodes[3], work);
    nodes[15] = qm_swiglu(c, nodes[14], nodes[13], work);
    nodes[16] = qm_mm_id(c, weights[3], nodes[15], nodes[3], work);
    let aggregate = qm_weighted(c, nodes[16], nodes[11]);
    if aggregate == 0 { return 0; }
    let base: i64 = 17;
    nodes[base] = aggregate;
    nodes[base + 1] = qa_mm(c, weights[4], x, work);
    nodes[base + 2] = qa_mm(c, weights[5], x, work);
    nodes[base + 3] = qm_swiglu(c, nodes[base + 2], nodes[base + 1], work);
    nodes[base + 4] = qa_mm(c, weights[6], nodes[base + 3], work);
    nodes[base + 5] = qa_mm(c, weights[7], x, work);
    qa_begin(work, 3, c, nodes[base + 5], 0, 0, 7); nodes[base + 6] = gb_common_args(work);
    nodes[base + 7] = qa_binary(c, nodes[base + 4], nodes[base + 6], 7, work);
    nodes[base + 8] = qa_binary(c, aggregate, nodes[base + 7], 2, work);
    return nodes[base + 8];
}

// Layer records have stride32: kind (0 attention,1 GDN), branch weights[11],
// MoE weights[8], conv,state,K,V handles, then eight reserved zero words.
// Branch weights use q35_attn_cached's first8 or q35_gdn_layer's eleven order.
// One model-step ticket is shared across layers. This builder never commits it.
// roots=[count,handles...]; generic executor expands every returned root, waits,
// and commits once. On failure discard this unexecuted graph/context.
export fn q35_trunk_output(c: i64, ids: i64, embedding: i64, head_weight: i64, head_norm: i64,
                    layers: i64[:], layer_count: i64, positions: i64, mask: i64, indices: i64,
                    attn_cfg: i64[:], gdn_cfg: i64[:], moe_cfg: i64[:], sections: i64,
                    state: i64[:], ticket: i64, work: i64[:], branch_nodes: i64[:],
                    moe_nodes: i64[:], frames: i64[:], roots: i64[:], logit_rows: i64) -> i64 {
    if c == 0 || ids == 0 || embedding == 0 || head_norm == 0 || head_weight == 0 ||
       layer_count <= 0 || layer_count > 128 || layers.len < layer_count * 32 ||
       frames.len < 4 * layer_count + 4 || roots.len < 2 * layer_count + 2 ||
       work.len < 16 || branch_nodes.len < 40 || attn_cfg.len < 14 || gdn_cfg.len < 7 || moe_cfg.len < 3 ||
       !qk_state_ok(state) || state[4] <= 0 || state[5] != ticket || positions == 0 ||
       indices == 0 || sections == 0 || logit_rows < -1 || logit_rows > 1 { return 0; }
    let count: i64 = ne(ids, 0);
    let hidden: i64 = ne(embedding, 0);
    if count != state[4] || prop(ids, 0) != 26 || ne(ids, 1) != 1 || ne(ids, 2) != 1 || ne(ids, 3) != 1 ||
       ne(embedding, 2) != 1 || ne(embedding, 3) != 1 || ne(head_weight, 0) != hidden || ne(head_weight, 1) != ne(embedding, 1) ||
       !qm_shape(head_norm, hidden, 1, 1) || prop(head_norm, 0) != 0 { return 0; }
    var layer: i64 = 0;
    while layer < layer_count {
        let base: i64 = layer * 32;
        if layers[base] != 0 && layers[base] != 1 { return 0; }
        var w: i64 = 1; let n: i64 = if layers[base] == 0 { 8 } else { 11 };
        while w <= n { if layers[base + w] == 0 { return 0; } w += 1; }
        w = 12; while w < 20 { if layers[base + w] == 0 { return 0; } w += 1; }
        if layers[base] == 0 {
            if layers[base + 22] == 0 || layers[base + 23] == 0 { return 0; }
        } else {
            if layers[base + 20] == 0 || layers[base + 21] == 0 { return 0; }
        }
        layer += 1;
    }
    qa_begin(work, 18, c, embedding, ids, 0, 0);
    var current: i64 = gb_common_args(work);
    frames[0] = current;
    var root_count: i64 = 0;
    layer = 0;
    while layer < layer_count {
        let base: i64 = layer * 32;
        let kind: i64 = layers[base];
        var normed: i64 = 0; var residual: i64 = 0;
        if kind == 0 {
            normed = q35_attn_cached(c, current, positions, mask, layers[base + 1 .. base + 9], attn_cfg, sections,
                                     layers[base + 22], layers[base + 23], indices, state, ticket, work, branch_nodes);
            residual = branch_nodes[26];
        } else {
            normed = q35_gdn_layer(c, current, layers[base + 20], layers[base + 21],
                                    layers[base + 1 .. base + 12], gdn_cfg, work, branch_nodes);
            residual = branch_nodes[37];
            roots[root_count + 1] = branch_nodes[16]; roots[root_count + 2] = branch_nodes[29]; root_count += 2;
        }
        if normed == 0 { return 0; }
        let ffn: i64 = q35_moe_ffn(c, normed, layers[base + 12 .. base + 20], moe_cfg, work, moe_nodes);
        if ffn == 0 { return 0; }
        current = qa_binary(c, ffn, residual, 2, work);
        frames[1 + 4 * layer] = normed; frames[2 + 4 * layer] = moe_nodes[3];
        frames[3 + 4 * layer] = ffn; frames[4 + 4 * layer] = current;
        layer += 1;
    }
    let last: i64 = 1 + 4 * layer_count;
    if logit_rows == 0 {
        roots[root_count + 1] = current; roots[0] = root_count + 1;
        return current;
    }
    if logit_rows == 1 && count > 1 {
        let row_stride = qa_get(current, 1, 1) as! i64;
        current = view2(c, current, hidden, 1, row_stride, (count - 1) * row_stride);
    }
    frames[last] = qa_rms(c, current, attn_cfg[5], work);
    frames[last + 1] = qa_binary(c, frames[last], head_norm, 7, work);
    frames[last + 2] = qa_mm(c, head_weight, frames[last + 1], work);
    roots[root_count + 1] = frames[last + 2]; roots[0] = root_count + 1;
    return frames[last + 2];
}

export fn q35_trunk(c: i64, ids: i64, embedding: i64, head_weight: i64, head_norm: i64,
                    layers: i64[:], layer_count: i64, positions: i64, mask: i64, indices: i64,
                    attn_cfg: i64[:], gdn_cfg: i64[:], moe_cfg: i64[:], sections: i64,
                    state: i64[:], ticket: i64, work: i64[:], branch_nodes: i64[:],
                    moe_nodes: i64[:], frames: i64[:], roots: i64[:]) -> i64 {
    return q35_trunk_output(c, ids, embedding, head_weight, head_norm, layers, layer_count,
        positions, mask, indices, attn_cfg, gdn_cfg, moe_cfg, sections, state, ticket, work,
        branch_nodes, moe_nodes, frames, roots, -1);
}

