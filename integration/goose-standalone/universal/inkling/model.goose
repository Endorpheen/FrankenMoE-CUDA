fn mr_name(layer: i64, suffix: const u8[:], out: u8[:]) -> i64 {
    if layer < 0 || layer > 127 || out.len < suffix.len + 8 { return -1; }
    out[0] = 98; out[1] = 108; out[2] = 107; out[3] = 46;
    var div: i64 = if layer >= 100 { 100 } else { if layer >= 10 { 10 } else { 1 } };
