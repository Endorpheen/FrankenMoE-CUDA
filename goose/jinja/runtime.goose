        if pat.len <= src.len {
            hit = true;
            var i: i64 = 0;

            while i < pat.len {
                if filter_name_is(fname, "startswith") {
                    if src[i] != pat[i] {
                        hit = false;
                    }
                } else {
                    if src[src.len - pat.len + i] != pat[i] {
                        hit = false;
                    }
                }
                i = i + 1;
            }
