            let n = vcc(A, st, arr);
            let base = pool(A, st) + vcs(A, st, arr);
            var i: i64 = 0;

            while i + i < n {
                let left = A[base + i];
                A[base + i] = A[base + n - 1 - i];
                A[base + n - 1 - i] = left;
