            var k: i64 = 0;

            while k < iw {
                out[base + k] = 32;
                k = k + 1;
            }
        }
        var fflag: i64 = 0;
        var bflag: i64 = 0;

        if argc > 1 && vk(A, st, argv[1]) != V_UNDEF {
            fflag = v_bool(A, F, st, argv[1]);
