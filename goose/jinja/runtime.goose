recursive fn eval_binary(
    id: i64,
    ctxc: i64,
    noff: i64[:],
    nlen: i64[:],
    cval: i64[:],
    A: i64[:],
    F: f64[:],
    B: u8[:],
    E: u8[:],
    out: u8[:],
    st: i64[:]) -> i64 {
    let pos = apos(A, st, id);
    let op = astr(B, A, st, id);
    let l = eval_node(ac0(A, st, id), ctxc, noff, nlen, cval, A, F, B, E, out, st);

    if st[1] != 0 {
        return -1;
    }

    if bytes_eq(op, "and") {
        if v_bool(A, F, st, l) != 0 {
            return eval_node(ac1(A, st, id), ctxc, noff, nlen, cval, A, F, B, E, out, st);
        }
        return l;
    }

    if bytes_eq(op, "or") {
        if v_bool(A, F, st, l) != 0 {
            return l;
        }
        return eval_node(ac1(A, st, id), ctxc, noff, nlen, cval, A, F, B, E, out, st);
    }
    let r = eval_node(ac1(A, st, id), ctxc, noff, nlen, cval, A, F, B, E, out, st);

    if st[1] != 0 {
        return -1;
    }

    if bytes_eq(op, "==") {
        return mk_bool(A, F, st, if eqv(A, B, F, st, l, r) {
            1
        } else {
            0
        }
        );
    }

    if bytes_eq(op, "!=") {
        return mk_bool(A, F, st, if eqv(A, B, F, st, l, r) {
            0
        } else {
            1
        }
        );
    }
    let lk = vk(A, st, l);
    let rk = vk(A, st, r);

    if (lk == V_UNDEF || lk == V_NONE || rk == V_UNDEF || rk == V_NONE) && (bytes_eq(op, "+") || bytes_eq(op, "~")) {
        let ln: bool = lk == V_UNDEF || lk == V_NONE;
        let rn: bool = rk == V_UNDEF || rk == V_NONE;
        let ls: bool = lk == V_STRING;
        let rs: bool = rk == V_STRING;

        if (ln && rs) || (rn && ls) {
