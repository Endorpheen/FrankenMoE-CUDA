export fn builtin_names(kind: i64, out: u8[:]) -> i64 {
    if kind == 0 || kind == 1 {
        return apps(out, 0, "abs default float int safe string tojson");
    }
    return 0;
}

export fn builtin_call(
    kind: i64,
    name: const u8[:],
    argc: i64,
    roots: const i64[:],
    kwc: i64,
    kwoff: const i64[:],
    kwlen: const i64[:],
    kwroots: const i64[:],
    blen: i64,
    A: i64[:],
    F: f64[:],
    B: u8[:],
    E: u8[:],
    out: u8[:],
    st: i64[:]) -> i64 {
    reset_io(A, st, blen);
    var r: i64 = -1;

    if kind == 0 {
        if bytes_eq(name, "default") {
            r = h_default(argc, roots, kwc, kwoff, kwlen, kwroots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "abs") {
            r = h_abs_int(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "int") {
            r = h_int_int(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "float") {
            r = h_float_int(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "safe") || bytes_eq(name, "string") || bytes_eq(name, "tojson") {
            r = h_tojson(argc, roots, kwc, kwoff, kwlen, kwroots, name, A, F, B, E, st);
        }
    } else {
        if bytes_eq(name, "default") {
            r = h_default(argc, roots, kwc, kwoff, kwlen, kwroots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "abs") {
            r = h_abs_float(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "int") {
            r = h_int_float(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "float") {
            r = h_float_float(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "safe") || bytes_eq(name, "string") {
            r = h_tostring_float(argc, roots, name, A, F, B, E, st);
        } else

        if bytes_eq(name, "tojson") {
            r = h_tojson(argc, roots, kwc, kwoff, kwlen, kwroots, name, A, F, B, E, st);
        }
    }

    if st[1] != 0 {
        return -1;
    }
    return json_into(r, 0, -1, ", ", ": ", A, B, F, st, out, 0, E);
}
// ---- AST and evaluator state ----------------------------------------------
// A[0] value capacity, A[1] value node count, A[2] value pool used,
// A[3] AST capacity, A[5] value pool capacity.
// F: [0, valcap) value floats, [valcap, valcap+astcap) AST float literals.
// st[10] valcap, st[30..36] AST bases, st[37] astcap.
const K_INT: i64 = 13;
const K_FLOAT: i64 = 14;
const K_STRING: i64 = 15;
const K_ARRAY: i64 = 16;
const K_TUPLE: i64 = 17;
const K_OBJECT: i64 = 18;
const K_BINARY: i64 = 19;
const K_UNARY: i64 = 24;
const K_IDENT: i64 = 12;
const K_SET_NODE: i64 = 6;
const K_SELECT: i64 = 25;
const K_TEST: i64 = 26;
const K_VALUE: i64 = 27;
const K_FOR: i64 = 2;
const K_MACRO: i64 = 7;
const K_CALL: i64 = 21;
const K_FILTER: i64 = 23;
const K_CALLSTMT: i64 = 8;
const K_KWARG: i64 = 22;
const K_MEMBER: i64 = 20;

fn ast_bases(A: const i64[:], st: i64[:]) -> i64 {
    let vc = A[0];
    let pc = A[5];
    let ac = A[3];
    var b: i64 = 32 + 11 * vc + pc;
    st[30] = b;
    st[31] = b + ac;
    st[32] = b + 2 * ac;
    st[33] = b + 3 * ac;
    st[34] = b + 4 * ac;
    st[35] = b + 5 * ac;
    st[36] = b + 6 * ac;
    st[37] = b + 7 * ac;
    st[38] = b + 8 * ac;
    st[39] = b + 9 * ac;
    st[40] = b + 10 * ac;
    st[41] = b + 11 * ac;
    st[42] = ac;
    st[43] = b + 12 * ac;
    return 0;
}

fn ak(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[30] + id];
}

fn apos(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[31] + id];
}

fn aiv(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[32] + id];
}

fn aso(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[33] + id];
}

fn asl(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[34] + id];
}

fn ac0(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[35] + id];
}

fn ac1(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[36] + id];
}

fn ac2(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[37] + id];
}

fn al0s(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[38] + id];
}

fn al0c(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[39] + id];
}

fn al1s(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[40] + id];
}

fn al1c(A: const i64[:], st: const i64[:], id: i64) -> i64 {
    return A[st[41] + id];
}

fn apool(A: const i64[:], st: const i64[:]) -> i64 {
    return st[43];
}

fn astr(B: const u8[:], A: const i64[:], st: const i64[:], id: i64) -> const u8[:] {
    return B[aso(A, st, id) .. aso(A, st, id) + asl(A, st, id)];
}

fn node_name(k: i64) -> const u8[:] {
    if k == 0 {
        return "Program";
    }

    if k == 1 {
        return "If";
    }

    if k == 2 {
        return "For";
    }

    if k == 3 {
        return "Break";
    }

    if k == 4 {
        return "Continue";
    }

    if k == 6 {
        return "Set";
    }

    if k == K_INT {
        return "IntegerLiteral";
    }

    if k == K_FLOAT {
        return "FloatLiteral";
    }

    if k == K_STRING {
        return "StringLiteral";
    }

    if k == K_IDENT {
        return "Identifier";
    }

    if k == K_ARRAY {
        return "ArrayLiteral";
    }

    if k == K_TUPLE {
        return "TupleLiteral";
    }

    if k == K_OBJECT {
        return "ObjectLiteral";
    }

    if k == K_BINARY {
        return "BinaryExpression";
    }

    if k == K_MEMBER {
        return "MemberExpression";
    }

    if k == K_MACRO {
        return "Macro";
    }

    if k == K_CALL {
        return "CallExpression";
    }

    if k == K_FILTER {
        return "FilterExpression";
    }

    if k == K_CALLSTMT {
        return "CallStatement";
    }

    if k == K_TEST {
        return "TestExpression";
    }

    if k == K_VALUE {
        return "ValueLiteral";
    }
    return "UnaryExpression";
}
// prefix the message with the node wrapper the native statement::execute adds

