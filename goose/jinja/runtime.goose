            var p = apps(mb, 0, "Object key of unhashable type: ");
            let tn = type_name(A, B, st, needle, mb[p ..]);
            p = p + tn;
            st[1] = 1;
            st[2] = apps(E, 0, mb[0..p]);
            return -1;
        }

        if has_key_eq(A, B, F, st, hay, needle) {
