            let c = src[i];

            if c == 123 {
                if i + 1 < src.len && src[i + 1] == 125 {
                    if ai >= argc {
                        return fail_node(K_FILTER, apos(A, st, id), "format() missing argument", E, st);
                    }
                    let n = as_string_into(A, B, F, st, argv[ai], out[base + p..], 0, E);

                    if n < 0 || st[1] != 0 {
                        return -1;
