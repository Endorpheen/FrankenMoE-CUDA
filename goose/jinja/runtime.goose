            arr_push(A, st, arr, mk_str(A, F, B, st, src[cur..]));
        } else {
            var cur: i64 = src.len;
            var go: i64 = 1;

            while maxsplit != 0 && go != 0 {
                var pos: i64 = -1;
                var j: i64 = 0;

                while j + delim.len <= cur {
                    var eq: bool = true;
                    var k: i64 = 0;

