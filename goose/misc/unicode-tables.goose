const UF_N: i64 = 3513;
const UL_N: i64 = 1433;

// Largest index with START[i] <= cpt, restricted to the real ranges.
fn uf_range(cpt: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = UF_N;
    while lo + 1 < hi {
        let mid: i64 = (lo + hi) / 2;
        if UFL_START[mid] <= cpt {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    if lo >= UF_N - 1 {
        return 0 - 1;
    }
    return lo;
}

export fn uf_flags(cpt: i64) -> i64 {
    if cpt < 0 {
        return 1;
    }
    let i: i64 = uf_range(cpt);
    if i < 0 {
        return 1;
    }
    return UFL_FLAG[i];
}

export fn ul_lower(cpt: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = UL_N;
    while lo < hi {
        let mid: i64 = (lo + hi) / 2;
        if ULL_CPT[mid] < cpt {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < UL_N && ULL_CPT[lo] == cpt {
        return ULL_LOW[lo];
    }
    return cpt;
}
