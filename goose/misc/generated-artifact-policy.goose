// P10-05 S3: generated-artifact and canonical-tree policy for the owned
// tooling.
//
// Native sources at the base commit 792293ad, copied byte-identical into
// tests/native/:
//
//   tools/check-generated-files.py  the generated-C marker test (49-59), the
//                                  MiB limit conversion (92) and the
//                                  fail/warn decision (96-104)
//   tools/check-goose-tree.py      the required-snippet walk (49-59), the
//                                  manifest row problem order (86-99), the
//                                  orphan pass (101-106) and the exit rule (128)
//
// The slice decides what counts as a generated artifact, whether a staged
// artifact may be committed, and which problems the canonical tree check
// reports. Nothing here reads the repository: the caller supplies paths, file
// heads, sizes and presence flags, so the gate is offline and model-free.
// The gate compares the exports with the native functions themselves (imported
// from the copied scripts) and with `re` for the export scan.
//
// Not owned: git index access, file hashing, the filesystem walk, the
// experiments/ directory layout and the manifest JSON parse.

import std;

const GAP_NL: u8 = 10;
const GAP_TAB: u8 = 9;
const GAP_HASH: u8 = 35;
const GAP_DOT: u8 = 46;

const GAP_MARK: i64 = 1;
const GAP_MARK_EDIT: i64 = 2;
const GAP_MARK_RUNTIME: i64 = 4;

fn gap_ws(c: u8) -> bool {
    return c == 32 || c == GAP_TAB || c == GAP_NL || c == 11 || c == 12 || c == 13;
}

fn gap_at(s: const u8[:], p0: i64, lit: const u8[:]) -> bool {
    if p0 < 0 || p0 + lit.len > s.len {
        return false;
    }
    var i: i64 = 0;
    while i < lit.len {
        if s[p0 + i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn gap_ends(s: const u8[:], lit: const u8[:]) -> bool {
    if lit.len > s.len {
        return false;
    }
    return gap_at(s, s.len - lit.len, lit);
}

fn gap_lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

fn gap_lower_at(s: const u8[:], pos_from: i64, lit: const u8[:]) -> bool {
    if pos_from < 0 || pos_from + lit.len > s.len {
        return false;
    }
    var i: i64 = 0;
    while i < lit.len {
        if gap_lower(s[pos_from + i]) != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn gap_contains_lower(s: const u8[:], lit: const u8[:]) -> bool {
    var p: i64 = 0;
    while p + lit.len <= s.len {
        if gap_lower_at(s, p, lit) {
            return true;
        }
        p = p + 1;
    }
    return false;
}

fn gap_contains(s: const u8[:], lit: const u8[:]) -> bool {
    var p: i64 = 0;
    while p + lit.len <= s.len {
        if gap_at(s, p, lit) {
            return true;
        }
        p = p + 1;
    }
    return false;
}

fn gap_putc(out: u8[:], at: i64, c: u8) -> i64 {
    if at < out.len {
        out[at] = c;
        return at + 1;
    }
    return at;
}

// tools/check-generated-files.py:49-59 — is_generated_goose_c(path, head).
// A .c file is generated when the compiler banner opens the head and the
// "Do not edit." line is inside the inspected prefix; a .cuh file is generated
// when it is named or placed under "generated". Everything else is hand-written
// and never matched.
export fn art_is_generated(path: const u8[:], head: const u8[:]) -> i64 {
    if gap_ends(path, ".c") {
        if gap_at(head, 0, "/* Generated by the Goose compiler from ") &&
            gap_contains(head, "Do not edit.") {
            return 1;
        }
        return 0;
    }
    if gap_ends(path, ".cuh") && gap_contains_lower(path, "generated") {
        return 1;
    }
    return 0;
}

// tools/check-generated-files.py:92 — int(args.mb * 1024 * 1024). The caller
// passes milli-MiB so the slice stays integer; the gate records the values for
// which the double product and this division agree.
export fn art_limit(mb_milli: i64) -> i64 {
    if mb_milli < 0 {
        return 0;
    }
    return mb_milli * 1048576 / 1000;
}

// tools/check-generated-files.py:96-104 — 2 = the commit fails, 1 = warned and
// allowed, 0 = not a generated artifact in the first place.
export fn art_gate(all_flag: i64, size: i64, limit: i64) -> i64 {
    if all_flag != 0 || size >= limit {
        return 2;
    }
    return 1;
}

// tools/check-goose-tree.py:49-59 — one required-snippet line.
// Returns 0 for a blank line and for a comment, otherwise 1 and the two parts
// split at the first tab (the snippet itself may contain tabs).
fn gap_required_split(line: const u8[:], rel: u8[:], snip: u8[:]) -> i64 {
    var start: i64 = 0;
    var end: i64 = line.len;
    while start < end && gap_ws(line[start]) {
        start = start + 1;
    }
    while end > start && gap_ws(line[end - 1]) {
        end = end - 1;
    }
    if start >= end || line[start] == GAP_HASH {
        return 0;
    }
    var tab: i64 = 0 - 1;
    var p: i64 = start;
    while p < end {
        if line[p] == GAP_TAB && tab < 0 {
            tab = p;
        }
        p = p + 1;
    }
    var at: i64 = 0;
    var q: i64 = start;
    while q < end && (tab < 0 || q < tab) {
        at = gap_putc(rel, at, line[q]);
        q = q + 1;
    }
    var bt: i64 = 0;
    if tab >= 0 {
        q = tab + 1;
        while q < end {
            bt = gap_putc(snip, bt, line[q]);
            q = q + 1;
        }
    }
    return 1;
}

// The exported split rule (the native check_required reads the two parts).
export fn art_required_split(line: const u8[:], rel: u8[:], snip: u8[:]) -> i64 {
    return gap_required_split(line, rel, snip);
}

// The same line after the filesystem answer is known: 0 skip, 1 the file is
// missing, 2 the snippet is missing, 3 the line holds.
export fn art_required_kind(line: const u8[:], file_present: i64, snippet_found: i64,
                            rel: u8[:], snip: u8[:]) -> i64 {
    if gap_required_split(line, rel, snip) == 0 {
        return 0;
    }
    if file_present == 0 {
        return 1;
    }
    if snippet_found == 0 {
        return 2;
    }
    return 3;
}

// tools/check-goose-tree.py:86-99 — the problem bitmask for one manifest row:
// 1 missing file (and then nothing else, the native loop continues),
// 2 hash mismatch, 4 missing experiment directory.
export fn art_manifest_mask(file_present: i64, hash_match: i64, exp_present: i64) -> i64 {
    if file_present == 0 {
        return 1;
    }
    var m: i64 = 0;
    if hash_match == 0 {
        m = m + 2;
    }
    if exp_present == 0 {
        m = m + 4;
    }
    return m;
}

// tools/check-goose-tree.py:101-106 — a .goose file that the manifest does not
// list is a problem; one that it lists is silent.
export fn art_orphan(in_manifest: i64) -> i64 {
    if in_manifest == 0 {
        return 1;
    }
    return 0;
}

// tools/check-goose-tree.py:128-133 — the exit rule: problems decide, warnings
// only print.
export fn art_verdict(problems: i64, warnings: i64) -> i64 {
    if problems > 0 {
        return 1;
    }
    return 0;
}

// tools/check-goose-tree.py:20-32 — re.findall(r"(?m)^export fn (\w+)", text):
// names at line start, in text order, appended to the caller's table. Returns
// the count (negative when the table is smaller than the match count).
export fn art_export_names(text: const u8[:], off: i64[:], len: i64[:],
                           names: u8[:]) -> i64 {
    var n: i64 = 0;
    var at: i64 = 0;
    var i: i64 = 0;
    while i < text.len {
        var j: i64 = i;
        while j < text.len && text[j] != GAP_NL {
            j = j + 1;
        }
        if gap_at(text, i, "export fn ") {
            var p: i64 = i + 10;
            var endw: i64 = p;
            var stop: i64 = 0;
            while endw < j && stop == 0 {
                let c: u8 = text[endw];
                let word: bool = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
                                 (c >= 97 && c <= 122) || c == 95;
                if !word {
                    stop = 1;
                } else {
                    endw = endw + 1;
                }
            }
            var q: i64 = endw;
            if q > p {
                if n < off.len && n < len.len {
                    off[n] = at;
                    len[n] = q - p;
                    var k: i64 = p;
                    while k < q {
                        at = gap_putc(names, at, text[k]);
                        k = k + 1;
                    }
                }
                n = n + 1;
            }
        }
        i = j + 1;
    }
    if n > off.len || n > len.len {
        return 0 - n;
    }
    return n;
}
