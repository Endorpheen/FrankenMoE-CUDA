fn hd_copy(s: const u8[:], out: u8[:]) -> i64 {
    var i: i64 = 0;
    while i < s.len && i < out.len {
        out[i] = s[i];
        i = i + 1;
    }
    return i;
}

export fn hdr_count() -> i64 {
    return HDR_N;
}

// The i-th key, in ascending order, so a gate can enumerate the table without
// carrying its own copy of the name list.
export fn hdr_key_at(i: i64, out: u8[:]) -> i64 {
    if i < 0 || i >= HDR_N {
        return 0 - 1;
    }
    return hd_copy(HDR_KEY[i], out);
}

// The value of one public name. found[0] is 1 when the name is in the table and
// 0 otherwise, where the return value is meaningless.
export fn hdr_value(key: const u8[:], found: i64[:]) -> i64 {
    var i: i64 = 0;
    while i < HDR_N {
        if HDR_KEY[i] == key {
            if found.len > 0 {
                found[0] = 1;
            }
            return HDR_VAL[i];
        }
        i = i + 1;
    }
    if found.len > 0 {
        found[0] = 0;
    }
    return 0;
}
