# Generated Goose output inside experiment sources.
experiments/**/source/runtime-gen.c
experiments/**/source/runtime-gen.h

# Generated artefacts inside experiments: reproducible from the Goose source.
# Keep the Goose source, the scripts, the mutation descriptions and the recorded
# results; never the generated C, objects or binaries.
experiments/*/tests/draft.c
experiments/*/tests/draft.h
experiments/*/tests/host
experiments/*/tests/*.o
experiments/*/tests/mut/*/draft.c
experiments/*/tests/mut/*/draft.h
experiments/*/tests/mut/*/draft.goose
experiments/*/tests/mut/*/host
experiments/*/source/*-gen.c
experiments/*/source/*-gen.h

# Oracle binaries are rebuilt by tests/build.sh from probe*.cpp.
experiments/**/tests/probe
experiments/**/tests/probe2

# Object files anywhere under an experiment's tests directory.
experiments/**/tests/*.o

# Goose per-job build cache used by the parallel mutation runner.
experiments/**/tests/mut/*/.goose/

# Generated CUDA headers (exp173 family and the generated/ directories).
experiments/*/source/*-generated.cuh
experiments/*/generated/*.cuh

# Remaining build artefacts that older experiments committed before the rule:
# static archives, shared objects without a soname suffix, and oracle binaries.
experiments/*/*.a
experiments/*/*.so
experiments/*/probe
experiments/*/probe2
experiments/*/goose_detok
experiments/*/native_detok

# Generated Goose C under src/ as well as source/ (EXP470 layout).
experiments/*/src/*-gen.c
experiments/*/src/*-gen.h

# Per-experiment run directories: generated C, objects and gate binaries.
experiments/**/run/
experiments/**/run/*

# Per-mutation copies: each one is regenerated from the Goose source by the
# experiment's mutate script (source, generated C, object, binary, output TSV).
experiments/**/tests/mut_*/
experiments/**/tests/mut/*/

# EXP641: generated mutation C and gate binaries are reproducible
experiments/EXP-2026-11-15-641-p7-04-iq-qgrid/results/gen/
experiments/EXP-2026-11-15-641-p7-04-iq-qgrid/results/bin/

# EXP644: generated mutation C, binaries and materialised copies
experiments/EXP-2026-11-15-644-p7-04-iq1m/results/gen/
experiments/EXP-2026-11-15-644-p7-04-iq1m/results/bin/
experiments/EXP-2026-11-15-644-p7-04-iq1m/results/work/

# EXP661: generated server C/header are reproducible
experiments/EXP-2026-11-15-661-p8-12b-server-switches/source/server.c
experiments/EXP-2026-11-15-661-p8-12b-server-switches/source/server.h

# Runtime snapshots keep the library and objects that produced a measurement; the manifests are tracked, the
# binaries are not (they are reproducible and large).
results/runtime-snapshots/*/libllama.so
results/runtime-snapshots/*/objects/

# Build backups: binary sets kept for rollback. Ignored by git because they are large concrete files; the
# store outside the repository keeps the authoritative copies.
Backup/

# Reference binary sets: large files, kept out of Git; manifests are tracked.
reference/apex-47/bin/
reference/apex-47/lib/
reference/apex-47/responses/
reference/independent-build/libllama.so
experiments/EXP-2026-11-19-1468-quant-rows-gate/quant-rows.c
experiments/EXP-2026-11-19-1468-quant-rows-gate/quant-rows2.c
experiments/EXP-2026-11-19-1468-quant-rows-gate/quant-rows.h
experiments/EXP-2026-11-19-1468-quant-rows-gate/quant-rows2.h
experiments/EXP-2026-11-19-1468-quant-rows-gate/gate

# Permanent test builds: objects, generated C and gate binaries are reproducible.
tests/*/*/build/
tests/*/*/build/**
