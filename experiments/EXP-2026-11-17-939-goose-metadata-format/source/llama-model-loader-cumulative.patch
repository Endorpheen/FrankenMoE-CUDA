+
+struct goose_meta {
+    void * hdr = nullptr;
+    int64_t len = 0;
+    int64_t fd = -1;
+    std::vector<int64_t> state, kv, tens, kvsl, tensl;
+    bool ok = false;
+    struct arr_text { std::string text; std::vector<int64_t> offs; };
+    mutable std::map<int64_t, arr_text> arr_str; // NUL-terminated table, stable for the model's life
+    ~goose_meta() { if (hdr && hdr != MAP_FAILED) munmap(hdr, (size_t) len); if (fd >= 0) close(fd); }
+};
+
+static std::mutex g_goose_mu;
+static std::map<const void *, std::unique_ptr<goose_meta>> g_goose_metas;
+
+static inline int64_t llama_goose_find_kv_or_gguf(const struct gguf_context * ctx, const char * key) {
+    if (!llama_goose_ready(ctx)) {
+        return gguf_find_key(ctx, key);
+    }
+    // the Goose table holds every key of the file, so -1 means "absent" there too
+    return llama_goose_find_kv(ctx, key);
+}
+
+static void goose_register(const struct gguf_context * ctx, const char * path) {
+    static bool inited = false;
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    if (!inited) { fg937_goose_init(0, nullptr); inited = true; }
+    auto m = std::make_unique<goose_meta>();
+    struct stat st{};
+    m->fd = open(path, O_RDONLY);
+    if (m->fd >= 0 && fstat(m->fd, &st) == 0) {
+        m->len = st.st_size < 67108864 ? (int64_t) st.st_size : 67108864;
+        m->hdr = mmap(nullptr, (size_t) m->len, PROT_READ, MAP_PRIVATE, m->fd, 0);
+        if (m->hdr != MAP_FAILED) {
+            m->state.assign(8, 0); m->kv.assign(256 * 8, 0); m->tens.assign(2048 * 12, 0);
+            m->kvsl.assign(512, 0); m->tensl.assign(8192, 0);
+            m->ok = gr_parse(gsl_u8x{ (uint8_t *) m->hdr, m->len }, st.st_size,
+                             gsl_i64x{ m->state.data(), 8 }, gsl_i64x{ m->kv.data(), (int64_t) m->kv.size() },
+                             gsl_i64x{ m->tens.data(), (int64_t) m->tens.size() },
+                             gsl_i64x{ m->kvsl.data(), (int64_t) m->kvsl.size() },
+                             gsl_i64x{ m->tensl.data(), (int64_t) m->tensl.size() }) == 0;
+        }
+    }
+    LLAMA_LOG_INFO("%s: ctx=%p ok=%d\n", __func__, (const void *) ctx, m->ok ? 1 : 0);
+    g_goose_metas[ctx] = std::move(m);
+}
+
+static const goose_meta * goose_meta_of(const struct gguf_context * ctx) {
+    auto it = g_goose_metas.find(ctx);
+    return (it == g_goose_metas.end() || !it->second->ok) ? nullptr : it->second.get();
+}
+
+int64_t llama_goose_kv_type(const struct gguf_context * ctx, int64_t index) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    const goose_meta * m = goose_meta_of(ctx);
+    if (!m) return -1;
+    return gr_kv_type(gsl_i64x{ (int64_t *) m->state.data(), 8 }, gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() }, index);
+}
+
+int64_t llama_goose_arr_type(const struct gguf_context * ctx, int64_t index) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    const goose_meta * m = goose_meta_of(ctx);
+    if (!m) return -1;
+    return gr_arr_type(gsl_i64x{ (int64_t *) m->state.data(), 8 }, gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() }, index);
+}
+
+int64_t llama_goose_arr_n(const struct gguf_context * ctx, int64_t index) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    const goose_meta * m = goose_meta_of(ctx);
+    if (!m) return -1;
+    return gr_arr_n(gsl_i64x{ (int64_t *) m->state.data(), 8 }, gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() }, index);
+}
+
+const void * llama_gguf_get_arr_data(const struct gguf_context * ctx, int64_t index, int64_t * bytes) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    const goose_meta * m = goose_meta_of(ctx);
+    if (!m) return nullptr;
+    int64_t out[4] = {0, 0, 0, 0};
+    if (gr_val_span(gsl_i64x{ (int64_t *) m->state.data(), 8 }, gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() }, index, gsl_i64x{ out, 4 }) != 0) {
+        return nullptr;
+    }
+    if (bytes) *bytes = out[2];
+    return (const uint8_t *) m->hdr + out[1];
+}
+
+const char * llama_goose_arr_str(const struct gguf_context * ctx, int64_t index, int64_t element) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    const goose_meta * m = goose_meta_of(ctx);
+    if (!m) return nullptr;
+
+    // Goose owns the GGUF layout, the pass over the elements and the
+    // terminators; this function only holds the storage and returns the entry.
+    auto it = m->arr_str.find(index);
+    if (it == m->arr_str.end()) {
+        const int64_t n = gr_arr_n(gsl_i64x{ (int64_t *) m->state.data(), 8 },
+                                   gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() }, index);
+        if (n < 0) return nullptr;
+        goose_meta::arr_text t;
+        t.offs.assign((size_t) n, 0);
+        int64_t rc = gr_arr_str_table(gsl_u8x{ (uint8_t *) m->hdr, m->len },
+                                      gsl_i64x{ (int64_t *) m->state.data(), 8 },
+                                      gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() },
+                                      index, gsl_u8x{ nullptr, 0 },
+                                      gsl_i64x{ t.offs.data(), (int64_t) t.offs.size() });
+        if (rc < 0) {
+            const int64_t need = -rc - 1;   // Goose answers -(bytes + 1) when `text` is too small
+            if (need <= 0) return nullptr;
+            rc = -1;
+            t.text.resize((size_t) need);
+            t.offs.assign((size_t) n, 0);
+            rc = gr_arr_str_table(gsl_u8x{ (uint8_t *) m->hdr, m->len },
+                                  gsl_i64x{ (int64_t *) m->state.data(), 8 },
+                                  gsl_i64x{ (int64_t *) m->kv.data(), (int64_t) m->kv.size() },
+                                  index, gsl_u8x{ (uint8_t *) t.text.data(), (int64_t) t.text.size() },
+                                  gsl_i64x{ t.offs.data(), (int64_t) t.offs.size() });
+        }
+        if (rc < 0) return nullptr;
+        it = m->arr_str.emplace(index, std::move(t)).first;
+    }
+    if (element < 0 || element >= (int64_t) it->second.offs.size()) {
+        return nullptr;
+    }
+    return it->second.text.data() + it->second.offs[(size_t) element];
+}
+
+// Read the reader's mapped header and its parse tables. Pure accessor: the
+// layout decisions stay in Goose.
+int llama_goose_reader(const struct gguf_context * ctx, const uint8_t ** hdr, int64_t * len,
+                       const int64_t ** state, const int64_t ** kv, const int64_t ** kvsl,
+                       int64_t * kv_count, int64_t * kvsl_count) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    auto it = g_goose_metas.find(ctx);
+    if (it == g_goose_metas.end() || !it->second->ok) {
+        return 0;
+    }
+    const goose_meta & m = *it->second;
+    *hdr = (const uint8_t *) m.hdr;
+    *len = m.len;
+    *state = m.state.data();
+    *kv = m.kv.data();
+    *kvsl = m.kvsl.data();
+    *kv_count = (int64_t) m.kv.size();   // the reader takes the slice length, not the record count
+    *kvsl_count = (int64_t) m.kvsl.size();
+    return 1;
+}
+
+int llama_goose_ready(const struct gguf_context * ctx) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    auto it = g_goose_metas.find(ctx);
+    return (it != g_goose_metas.end() && it->second->ok) ? 1 : 0;
+}
+
+int64_t llama_goose_find_kv(const struct gguf_context * ctx, const char * key) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    auto it = g_goose_metas.find(ctx);
+    if (it == g_goose_metas.end() || !it->second->ok) {
+        return -1;
+    }
+    goose_meta & m = *it->second;
+    if (getenv("EXP925_MUTATE_KV")) { return -1; }
+    return gr_find_kv(gsl_u8x{ (uint8_t *) m.hdr, m.len }, gsl_i64x{ m.state.data(), 8 },
+                      gsl_i64x{ m.kv.data(), (int64_t) m.kv.size() },
+                      gsl_i64x{ m.kvsl.data(), (int64_t) m.kvsl.size() },
+                      gsl_u8x{ (uint8_t *) key, (int64_t) std::strlen(key) });
+}
+
+int64_t llama_goose_tensor_index(const struct gguf_context * ctx, const char * name) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    auto it = g_goose_metas.find(ctx);
+    if (it == g_goose_metas.end() || !it->second->ok) {
+        return -1;
+    }
+    goose_meta & m = *it->second;
+    if (getenv("EXP925_MUTATE_LOOKUP")) { return -1; }
+    return gr_find_tensor(gsl_u8x{ (uint8_t *) m.hdr, m.len }, gsl_i64x{ m.state.data(), 8 },
+                          gsl_i64x{ m.tens.data(), (int64_t) m.tens.size() },
+                          gsl_i64x{ m.tensl.data(), (int64_t) m.tensl.size() },
+                          gsl_u8x{ (uint8_t *) name, (int64_t) std::strlen(name) });
+}
