+import hashlib, sys
+from pathlib import Path
+dist = Path(sys.argv[1])
+for name in ["main.goose", "main.c", "main.h", "main.o"]:
+    print(hashlib.sha256((dist / name).read_bytes()).hexdigest(), name)
