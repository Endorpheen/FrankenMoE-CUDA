+              f"(build it with: bash tools/goose-hosts/build.sh)", file=sys.stderr)
+        return None
+    return Host(binary)
+
+
+def is_generated_goose_c(path: str, head: bytes, host: Host | None = None) -> bool:
+    if host is not None:
+        return host.ask(f"GEN {_hex(path.encode())} {_hex(head)}") == "1"
