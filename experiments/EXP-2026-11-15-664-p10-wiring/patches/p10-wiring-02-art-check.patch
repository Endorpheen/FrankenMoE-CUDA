+def size_limit(mb: float, host: Host | None = None) -> int:
+    if host is not None:
+        # The slice takes integer milli-MiB, so the caller rounds the CLI value.
+        return int(host.ask(f"LIM {int(round(mb * 1000))}"))
+    return int(mb * 1024 * 1024)
+
+
+def gate(all_flag: bool, size: int, limit: int, host: Host | None = None) -> int:
+    """2 = the commit fails, 1 = warned, 0 = not a generated artifact."""
+    if host is not None:
+        return int(host.ask(f"GATE {int(all_flag)} {size} {limit}"))
+    if all_flag or size >= limit:
+        return 2
+    return 1
+
