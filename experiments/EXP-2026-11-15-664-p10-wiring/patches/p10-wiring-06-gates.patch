+#!/usr/bin/env bash
+# Produce the wiring patches as separate, reviewable files.
+#
+#   bash gates/make-patches.sh <pristine-tree> <out-dir>
+#
+# The pristine tree is a `git archive 0da127f5` export; every patch is a unified
+# diff of whole files with a/ b/ labels, so `git apply -p1` from the repository
+# root takes it. New files appear as additions from /dev/null.
+set -euo pipefail
+
+BASE=${1:?usage: make-patches.sh <pristine-tree> <out-dir>}
+OUT=${2:?usage: make-patches.sh <pristine-tree> <out-dir>}
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
+mkdir -p "$OUT"
+
+emit() {
+    local name=$1
+    shift
+    local file="$OUT/$name"
+    : > "$file"
+    for path in "$@"; do
+        if [ -f "$BASE/$path" ]; then
+            diff -u --label "a/$path" --label "b/$path" "$BASE/$path" "$ROOT/$path" >> "$file" || true
+        else
+            diff -u --label "/dev/null" --label "b/$path" /dev/null "$ROOT/$path" >> "$file" || true
+        fi
+    done
+    printf '%s: %s lines\n' "${name}" "$(wc -l < "$file")"
+}
+
+emit p10-wiring-01-hosts.patch \
+    tools/goose-hosts/README.md \
+    tools/goose-hosts/host_io.h \
+    tools/goose-hosts/client.sh \
+    tools/goose-hosts/build.sh \
+    tools/goose-hosts/art-main.c \
+    tools/goose-hosts/env-main.c \
+    tools/goose-hosts/pkg-main.c \
+    tools/goose-hosts/fx-main.c
+
+emit p10-wiring-02-art-check.patch \
+    tools/check-generated-files.py
+
+emit p10-wiring-03-build-env.patch \
+    scripts/build.sh
+
+emit p10-wiring-04-release-package.patch \
+    scripts/make-release.sh \
+    tools/package-main-runtime.sh
+
+emit p10-wiring-05-fixture-plan.patch \
+    scripts/make-tiny-moe.py
+
+emit p10-wiring-06-gates.patch \
+    experiments/EXP-2026-11-15-663-p10-wiring/REPORT.md \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/host.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/run.sh \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/w1_art.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/w2_env.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/w3_pkg.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/w3_release.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/w4_fx.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/mutate.py \
+    experiments/EXP-2026-11-15-663-p10-wiring/gates/make-patches.sh
