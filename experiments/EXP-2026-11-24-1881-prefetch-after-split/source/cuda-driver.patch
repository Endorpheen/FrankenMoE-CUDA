@@ -3876,0 +3883,25 @@
+static int pf_submit_after_split(void) {
+    prefetch_after_split_pending = false;
+    static _Thread_local uint64_t submitted;
+    const int error = pf_submit();
+    if (error == 0 && (++submitted == 1 || submitted % 10000 == 0))
+        fprintf(stderr, "Goose CUDA: prefetch waves issued after split=%" PRIu64 "\n", submitted);
+    return error;
+}
+
+static int pf_finish_deferred(bool submit) {
+    if (!prefetch_after_split_pending) return 0;
+    prefetch_after_split_pending = false;
+    if (!submit) { pf.pending = -1; return 0; }
+    if (push_context() != 1) { pf.pending = -1; return -1; }
+    int error = decode_capture_submit();
+    if (error == 0) {
+        static _Thread_local uint64_t fallback;
+        error = pf_submit();
+        if (error == 0 && (++fallback == 1 || fallback % 10000 == 0))
+            fprintf(stderr, "Goose CUDA: deferred prefetch fallback=%" PRIu64 "\n", fallback);
+    } else {
+        pf.pending = -1;
+    }
+    return finish_context() == 0 ? error : -1;
+}
