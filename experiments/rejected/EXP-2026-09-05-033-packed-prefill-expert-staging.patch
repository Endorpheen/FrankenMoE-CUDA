+static __global__ void ggml_cuda_scatter_packed_segments(
+        const char * src,
+        char * dst,
+        const ggml_backend_copy_segment * segments) {
+    const ggml_backend_copy_segment segment = segments[blockIdx.y];
+    for (size_t i = blockIdx.x * blockDim.x + threadIdx.x; i < segment.size; i += blockDim.x * gridDim.x) {
+        dst[segment.dst_offset + i] = src[segment.src_offset + i];
+    }
+}
+
+static bool ggml_backend_cuda_set_tensor_scatter_async(
+        ggml_backend_t backend,
+        ggml_tensor * tensor,
+        const void * data,
+        size_t size,
+        const ggml_backend_copy_segment * segments,
+        size_t n_segments) {
+    if (n_segments == 0) {
+        return true;
+    }
+
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (buf->buft != ggml_backend_cuda_buffer_type(cuda_ctx->device)) {
+        return false;
+    }
+
+    size_t max_segment_size = 0;
+    for (size_t i = 0; i < n_segments; ++i) {
+        GGML_ASSERT(segments[i].src_offset + segments[i].size <= size);
+        GGML_ASSERT(segments[i].dst_offset + segments[i].size <= ggml_nbytes(tensor));
+        max_segment_size = std::max(max_segment_size, segments[i].size);
+    }
+
+    ggml_cuda_pool_alloc<char> packed_dev(cuda_ctx->pool(), size);
+    ggml_cuda_pool_alloc<ggml_backend_copy_segment> segments_dev(cuda_ctx->pool(), n_segments);
+    CUDA_CHECK(cudaMemcpyAsync(packed_dev.get(), data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
+    CUDA_CHECK(cudaMemcpyAsync(segments_dev.get(), segments, n_segments * sizeof(*segments), cudaMemcpyHostToDevice, cuda_ctx->stream()));
+
+    const dim3 block(256, 1, 1);
+    const dim3 grid((max_segment_size + block.x - 1) / block.x, n_segments, 1);
+    ggml_cuda_scatter_packed_segments<<<grid, block, 0, cuda_ctx->stream()>>>(
+        packed_dev.get(), (char *) tensor->data, segments_dev.get());
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
