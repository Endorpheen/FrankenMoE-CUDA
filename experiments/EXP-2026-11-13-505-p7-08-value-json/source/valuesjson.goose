    var kn:i64=0;
    if vk(A,st,key)==V_FLOAT {
     kn=float_json(kb,0,F[key]);
    } else {
     st[1]=0;
     kn=as_string_into(A,B,F,st,key,kb,0,E);
     if st[1]!=0 { return -1; }
    }
    p=json_string(out,p,kb[0..kn]);
    p=apps(out,p,": ");
    let val=A[pool(A,st)+vvs(A,st,id)+i];
    p=json_into(val,lvl+1,indent,A,B,F,st,out,p,E);
    if st[1]!=0 { return -1; }
    if i<n-1 { p=apps(out,p,", "); }
    if indent>=0 { p=appc(out,p,10); }
    i=i+1;
   }
   if indent>0 { p=spaces_to(out,p,lvl*indent); }
  }
  return appc(out,p,'}');
 }
 return apps(out,at,"null");
}

export fn value_json(root:i64, indent:i64, A:i64[:], F:f64[:], B:const u8[:], E:u8[:], out:u8[:], st:i64[:])->i64 {
 reset(A,st);
 st[1]=0;
 st[2]=0;
 let r=json_into(root,0,indent,A,B,F,st,out,0,E);
 return r;
}
