+static void fv_quad_store_max(uint64_t shared, float maximum, int32_t lane, int32_t warp) {
+    if (lane == 0) fg175v_sm_st_f32(shared, 1024 + warp, maximum);
+    if (warp == 0 && lane >= 4) {
+        fg175v_sm_st_f32(shared, 1024 + lane, flash_vec_gg_function_17(0));
+        fg175v_sm_st_f32(shared, 1088 + lane, 0.0f);
+    }
+}
+
+static float fv_quad_scale_values(uint64_t shared, VecFlash4_g low, VecFlash4_g high,
+                                  float maximum, float total, int32_t lane, int32_t warp) {
+    const float block_max = flash_vec_gg_function_33(fg175v_sm_f32(shared, 1024 + lane), 0);
+    const float scale = fg175v_expf(maximum - block_max);
+    const uint64_t index = (uint64_t)(warp * 256 + 4 * lane);
+    flash_vec_gg_function_41(shared, index, low, scale, 0);
+    flash_vec_gg_function_41(shared, index + 128, high, scale, 0);
+    const float warp_total = flash_vec_gg_function_27(total * scale, 0);
+    if (lane == 0) fg175v_sm_st_f32(shared, 1088 + warp, warp_total);
+    return block_max;
+}
+
+static void fv_quad_store_output(uint64_t out, uint64_t meta, uint64_t shared,
+                                 float block_max, int32_t lane, int32_t warp) {
+    const float block_total = flash_vec_gg_function_27(fg175v_sm_f32(shared, 1088 + lane), 0);
+    const uint64_t tid = (uint64_t)(warp * 32 + lane);
+    for (unsigned segment = 0; segment < 2; ++segment) {
+        const uint64_t column = tid + 128 * segment;
+        float sum = 0.0f;
+        for (unsigned w = 0; w < 4; ++w)
+            sum += fg175v_sm_f32(shared, column + 256 * w);
+        fg175v_st_f32(out, 4 * column, sum);
+    }
+    if (tid == 0) {
+        fg175v_st_f32(meta, 0, block_max);
+        fg175v_st_f32(meta, 4, block_total);
+    }
+}
