+static int nk_stage_prefill_kv(struct native_kv_rows *rows, int total) {
+    const size_t plane = (size_t)total * NK_KV * sizeof(uint16_t);
+    const size_t needed = 2 * plane;
+    if (needed > nk.unpacked_kv.bytes) {
+        size_t free_bytes = 0, total_bytes = 0;
+        if (cuda.memory_info(&free_bytes, &total_bytes) != 0 ||
+            needed - nk.unpacked_kv.bytes + 256 * MIB_BYTES > free_bytes) return 0;
+        const int allocated = reserve(&nk.unpacked_kv, needed);
+        if (allocated == 2) return 0;
+        if (allocated != 0) return -1;
+        if (getenv("I2_PREFILL_STAGE_KV_LOG"))
+            fprintf(stderr, "Inkling prefill KV workspace: %zu bytes\n", needed);
+    }
+    int error = 0;
+    if (!nk.unpack_kv)
+        error = cuda.function_get(&nk.unpack_kv, nk.module, "goose_i2_prefill_unpack_kv");
+    uint32_t tasks = (uint32_t)total * (NK_KV / 2);
+    DevicePtr k = nk.unpacked_kv.address, v = k + plane;
+    void *args[] = {&rows->keys, &rows->values, &k, &v, &tasks};
+    if (!error) error = cuda.launch(nk.unpack_kv, (tasks + 255) / 256, 1, 1, 256, 1, 1, 0, NULL, args, NULL);
+    if (error) return -1;
+    rows->keys = k;
+    rows->values = v;
+    return 1;
+}
