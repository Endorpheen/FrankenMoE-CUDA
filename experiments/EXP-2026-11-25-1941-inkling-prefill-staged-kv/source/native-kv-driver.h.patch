+static int nk_stage_prefill_kv(struct native_kv_rows *rows, int total, int input_rows) {
+    const size_t plane = (size_t)total * NK_KV * sizeof(uint16_t);
+    const size_t raw_limit = (size_t)input_rows * 5504 * sizeof(float);
+    if (!nk.raw.address || !nk.projected_input.address || plane > raw_limit ||
+        plane > nk.raw.bytes || plane > nk.projected_input.bytes) return 0;
+    int error = 0;
+    if (!nk.unpack_kv)
+        error = cuda.function_get(&nk.unpack_kv, nk.module, "goose_i2_prefill_unpack_kv");
+    uint32_t tasks = (uint32_t)total * (NK_KV / 2);
+    DevicePtr k = nk.raw.address, v = nk.projected_input.address;
+    void *args[] = {&rows->keys, &rows->values, &k, &v, &tasks};
+    if (!error) error = cuda.launch(nk.unpack_kv, (tasks + 255) / 256, 1, 1, 256, 1, 1, 0, NULL, args, NULL);
+    if (error) return -1;
+    rows->keys = k;
+    rows->values = v;
+    if (getenv("I2_PREFILL_STAGE_KV_LOG"))
+        fprintf(stderr, "Inkling prefill KV reused: %zu bytes (%d rows)\n", 2 * plane, total);
+    return 1;
+}
