+fn rms_row_one(
+    x: u64,
+    d: u64,
+    shared: u64,
+    m: u64,
+    a: u64,
+    n: i32,
+    tid: i32,
+    bs: i32,
+    multiply: bool,
+    plus: bool,
+    scaled: bool,
+    eps: f32,
+    scale_out: f32,
+    add_zero: bool) {
+    var sum: f32 = 0.0;
+    let i = tid;
+
+    if i < n / 4 {
+        let v = load4(x, i);
+        let xy = fma(v.x, v.x, v.y * v.y);
+        let xyz = fma(v.z, v.z, xy);
+        sum += fma(v.w, v.w, xyz);
+    }
+    sum = block_sum(sum, shared, tid, bs);
+    let scale = rsqrt(sum / (n as f32) + eps);
+
+    if i < n / 4 {
+        let v = load4(x, i);
+        var out = RmsVec {
+            scale * v.x, scale * v.y, scale * v.z, scale * v.w
+        }
+        ;
+
+        if multiply {
+            let mv = load4(m, i);
+            out.x *= mv.x;
+            out.y *= mv.y;
+            out.z *= mv.z;
+            out.w *= mv.w;
+        }
+
+        if plus {
+            let av = load4(a, i);
+            out.x += av.x;
+            out.y += av.y;
+            out.z += av.z;
+            out.w += av.w;
+        }
+
+        if scaled {
+            out.x *= scale_out;
+            out.y *= scale_out;
+            out.z *= scale_out;
+            out.w *= scale_out;
+            if add_zero {
+                out.x += 0.0;
+                out.y += 0.0;
+                out.z += 0.0;
+                out.w += 0.0;
+            }
+        }
+        store4(d, i, out);
+    }
+}
