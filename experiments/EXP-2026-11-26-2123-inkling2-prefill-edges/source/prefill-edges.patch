+bool inkling_prelude_use(bool capture) {
+    if (!i2_arena_probe.active || start_context() != 1) return false;
+    static Module module;
+    static Function prepare;
+    const size_t split = activation_usable_bytes();
+    const DevicePtr raw = cuda.activations.address + split;
+    DevicePtr prelude = raw + i2_loop_plane;
+    DevicePtr next = raw + 4 * (size_t)i2_loop_plane;
+    DevicePtr normalized = 0;
+    DevicePtr scales = raw + 6 * (size_t)i2_loop_plane + 65536 + 65536;
+    const size_t required = 6 * (size_t)i2_loop_plane + 131072 + i2_loop_batch * sizeof(float);
+    int status = cuda.activations.bytes - split >= required ? 0 : -1;
+    if (!status && capture) {
+        if (!inkling_moe_current) status = -1;
+        if (!status && !module) status = cuda.module_load(&module, i2_lazy_prelude_image);
+        if (!status && !prepare) status = cuda.function_get(&prepare, module, "i2_lazy_prepare");
+        if (!status) status = cuda.copy_device(prelude, inkling_moe_current, i2_loop_plane);
+        int add = 0;
+        void *args[] = {&prelude, &prelude, &next, &normalized, &scales, &add};
+        if (!status) status = cuda.launch(prepare, i2_loop_batch, 1, 1, 128, 1, 1, 0, NULL, args, NULL);
+        if (!status) status = cuda.sync();
+        if (!status) inkling_prelude_scales = scales;
+    }
+    if (!status && !inkling_prelude_scales) status = -1;
+    if (!status) inkling_moe_current = prelude;
+    const int popped = finish_context();
+    return !status && !popped;
+}
+
+bool inkling_prefill_final_rows(float *current, float *prelude) {
+    enum { row_bytes = i2_loop_width * sizeof(float) };
+    if (!i2_arena_probe.active || start_context() != 1) return false;
+    const size_t row = i2_loop_batch - 1;
+    int error = 0;
+    if (current) {
+        error = !inkling_moe_current ? -1 :
+            cuda.download(current, inkling_moe_current + row * row_bytes, row_bytes);
+    }
+    if (!error && prelude) {
+        const DevicePtr raw = cuda.activations.address + activation_usable_bytes() + i2_loop_plane;
+        float scale = 0;
+        error = !inkling_prelude_scales ? -1 :
+            cuda.download(&scale, inkling_prelude_scales + row * sizeof(float), sizeof(float));
+        if (!error) error = cuda.download(prelude, raw + row * row_bytes, row_bytes);
+        if (!error) for (int i = 0; i < i2_loop_width; ++i) prelude[i] *= scale;
+    }
+    const int popped = finish_context();
+    return !error && !popped;
+}
