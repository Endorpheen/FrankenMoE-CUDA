                var out_role: const u8[:] = role;
                if role == "assistant" {
                    out_role = "model";
                }
                o = putb(dst, o, "<start_of_turn>");
                o = putb(dst, o, out_role);
                o = putb(dst, o, "\n");
                var j: i64 = sys_from;
                var pending: i64 = 0 as i64;
                while j < i {
