        var n = as_string_into(A, B, F, st, l, sb, 0, E);
        n = as_string_into(A, B, F, st, r, sb, n, E);
        let res = mk_str(A, F, B, st, sb[0..n]);
        // string.cpp append: the prompt takes the first non-empty part, so an empty
        // left operand lets the right one decide, while the all flag is the AND of
        // every operand (an empty string has an unmarked empty part).
        let ls = vk(A, st, l) == V_STRING;
        let rs = vk(A, st, r) == V_STRING;
        var llen: i64 = 0 - 1;
        var rlen: i64 = 0 - 1;

        if ls {
            llen = vstr(B, A, st, l).len;
        }

        if rs {
            rlen = vstr(B, A, st, r).len;
        }
        var f: i64 = 0;
        var a: i64 = 1;

        if llen != 0 {
            if ls && (A[st[27] + l] & 16) != 0 {
                f = 1;
            }
        } else if rs && (A[st[27] + r] & 16) != 0 {
            f = 1;
        }

        // every operand contributes its parts to the all flag, including an empty
        // string, whose single empty part is not input
        if !ls || (A[st[27] + l] & 32) == 0 {
            a = 0;
        }

        if !rs || (A[st[27] + r] & 32) == 0 {
            a = 0;
        }

        if f != 0 {
            A[st[27] + res] = A[st[27] + res] | 16;
        }

        if a != 0 {
            A[st[27] + res] = A[st[27] + res] | 32;
        }
        return res;
    }

