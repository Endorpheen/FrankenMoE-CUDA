            if role == "system" {
                o = putb(dst, o, content);
                o = putb(dst, o, "\n\n");
            } else if role == "user" {
                o = plain(dst, o, "User: ", "", "", content, "\n\n");
            } else if role == "assistant" {
                o = plain(dst, o, "Assistant: ", "", "", content, "<｜end▁of▁sentence｜>");
            }
