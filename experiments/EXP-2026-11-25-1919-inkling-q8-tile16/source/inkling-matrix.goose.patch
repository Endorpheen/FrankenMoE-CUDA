+    sum1 = reduce_lane(sum1);
+    sum2 = reduce_lane(sum2);
+    sum3 = reduce_lane(sum3);
+    sum4 = reduce_lane(sum4);
+    sum5 = reduce_lane(sum5);
+    sum6 = reduce_lane(sum6);
+    sum7 = reduce_lane(sum7);
+    sum8 = reduce_lane(sum8);
+    sum9 = reduce_lane(sum9);
+    sum10 = reduce_lane(sum10);
+    sum11 = reduce_lane(sum11);
+    sum12 = reduce_lane(sum12);
+    sum13 = reduce_lane(sum13);
+    sum14 = reduce_lane(sum14);
+    sum15 = reduce_lane(sum15);
