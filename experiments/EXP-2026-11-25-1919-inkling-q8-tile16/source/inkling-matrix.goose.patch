+        store(output0, sum0);
+        store(output1, sum1);
+        store(output2, sum2);
+        store(output3, sum3);
+        store(output4, sum4);
+        store(output5, sum5);
+        store(output6, sum6);
+        store(output7, sum7);
+        store(output8, sum8);
