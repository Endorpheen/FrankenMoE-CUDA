+        sum8 = multiply_add(value, load(input8 + at), sum8);
+        sum9 = multiply_add(value, load(input9 + at), sum9);
+        sum10 = multiply_add(value, load(input10 + at), sum10);
+        sum11 = multiply_add(value, load(input11 + at), sum11);
