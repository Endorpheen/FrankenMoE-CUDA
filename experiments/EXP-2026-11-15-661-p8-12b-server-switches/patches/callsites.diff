+# --- P8-12: merged port bridges and the Goose server switch layer ------------
+#
+# The merged server-context.cpp and server-queue.cpp carry five ports whose
+# entry points are the fg*_enabled()/fg*_* symbols below. Their bridges are the
+# accepted experiment sources, unchanged, one directory per port; they are
+# default-on and keep their own env switches (GGML_GOOSE_*).
+#
+# Both layers are static libraries attached to server-context PUBLIC, because
+# every consumer of the merged context and queue (llama-server, llama-cli) has
+# to resolve the same entry points.
+set(FG_SERVER_DIR ${CMAKE_CURRENT_SOURCE_DIR}/fg-server-ports)
+set(FG_PORT_SOURCES "")
+foreach(port 269 271 273 275 277)
+    list(APPEND FG_PORT_SOURCES ${FG_SERVER_DIR}/${port}/bridge.c)
+    set_source_files_properties(${FG_SERVER_DIR}/${port}/bridge.c PROPERTIES COMPILE_OPTIONS "-w")
+endforeach()
+add_library(fg-server-ports STATIC ${FG_PORT_SOURCES})
+
+# The Goose switch layer: the bridge is always compiled (OFF: every wrapper is
+# the constant -1, no unit symbol is referenced); the unit and its host adapter
+# exist only when at least one site flag is ON.
+set(FG_GOOSE server.c host_server.c fg-goose-server.cpp)
+set(FG_GOOSE_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/fg-goose-server/fg-goose-server.cpp)
+if(FG_GOOSE_SERVER_RUNTIME)
+    list(APPEND FG_GOOSE_SOURCES
+        ${CMAKE_CURRENT_SOURCE_DIR}/fg-goose-server/server.c
+        ${CMAKE_CURRENT_SOURCE_DIR}/fg-goose-server/host_server.c)
+    set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/fg-goose-server/server.c
+        PROPERTIES COMPILE_OPTIONS "-w;-O1")
+    set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/fg-goose-server/host_server.c
+        PROPERTIES COMPILE_OPTIONS "-w")
+endif()
+add_library(fg-goose-server-core STATIC ${FG_GOOSE_SOURCES})
+if(FG_GOOSE_SERVER_RUNTIME)
+    target_compile_definitions(fg-goose-server-core PRIVATE FG_GOOSE_SERVER_RUNTIME=1)
+endif()
+
+target_link_libraries(server-context PUBLIC fg-server-ports fg-goose-server-core)
+
+# Numeric forms: the call sites use #if, so ON/OFF are not enough.
+foreach(name STATUS TOOLS MIME CACHE CORS)
+    if(FG_GOOSE_SERVER_${name})
+        set(FG_GOOSE_SERVER_${name}_NUM 1)
+    else()
