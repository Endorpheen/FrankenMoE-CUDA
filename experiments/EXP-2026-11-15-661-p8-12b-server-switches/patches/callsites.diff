+# --- P8-12: the first five server call sites switched to Goose modules -------
+#
+# Every flag is OFF by default: OFF compiles exactly the native server bodies.
+# ON compiles the one composed server Goose unit (model-manager, tools-pure,
+# web-assets, mime-table, cors-policy plus jsonparse) once and lets the five
+# call sites ask it first. The native body stays compiled in both
+# configurations and remains the fallback when the unit returns no answer.
+#
+# The five flags exist to measure the substitution, not because the feature is
+# optional; once the call sites are accepted they become default ON, and the
+# env switch to restore a native body arrives with the removal step.
+option(FG_GOOSE_SERVER_STATUS "server: model status vocabulary from model-manager.goose" OFF)
+option(FG_GOOSE_SERVER_TOOLS  "server: built-in tool dispatch from tools-pure.goose"     OFF)
+option(FG_GOOSE_SERVER_MIME   "server: static asset content type from mime-table.goose"  OFF)
+option(FG_GOOSE_SERVER_CACHE  "server: static asset Cache-Control from web-assets.goose" OFF)
+option(FG_GOOSE_SERVER_CORS   "server: Origin localhost test from cors-policy.goose"     OFF)
+
+set(FG_GOOSE_SERVER_RUNTIME OFF)
+foreach(flag
+        FG_GOOSE_SERVER_STATUS FG_GOOSE_SERVER_TOOLS FG_GOOSE_SERVER_MIME
+        FG_GOOSE_SERVER_CACHE  FG_GOOSE_SERVER_CORS)
+    if(${flag})
+        set(FG_GOOSE_SERVER_RUNTIME ON)
+    endif()
+endforeach()
