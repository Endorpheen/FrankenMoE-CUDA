                          trim_native(get_content(cs, coffs[i], clens[i])), "<|END_OF_TURN_TOKEN|>");
            } else if role == "user" {
                o = plain(dst, o, "<|START_OF_TURN_TOKEN|><|USER_TOKEN|>", "", "",
                          trim_native(get_content(cs, coffs[i], clens[i])), "<|END_OF_TURN_TOKEN|>");
