// One line per frozen GGUF-header value. The compiler resolves every value
// against the real gguf.h; nothing here is a copy of a number.
GGH(GGUF_VERSION)
GGH(GGUF_DEFAULT_ALIGNMENT)
GGH(GGUF_TYPE_UINT8)
GGH(GGUF_TYPE_INT8)
GGH(GGUF_TYPE_UINT16)
GGH(GGUF_TYPE_INT16)
GGH(GGUF_TYPE_UINT32)
GGH(GGUF_TYPE_INT32)
GGH(GGUF_TYPE_FLOAT32)
GGH(GGUF_TYPE_BOOL)
GGH(GGUF_TYPE_STRING)
GGH(GGUF_TYPE_ARRAY)
GGH(GGUF_TYPE_UINT64)
GGH(GGUF_TYPE_INT64)
GGH(GGUF_TYPE_FLOAT64)
GGH(GGUF_TYPE_COUNT)
GGH_SZ(gguf_init_params)
GGH_OFF(gguf_init_params, no_alloc)
GGH_OFF(gguf_init_params, ctx)
