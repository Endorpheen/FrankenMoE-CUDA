                var kn: i64 = 0;

                if vk(A, st, key) == V_FLOAT {
                    kn = float_json(kb, 0, F[key]);
                } else {
                    st[1] = 0;
                    kn = as_string_into(A, B, F, st, key, kb, 0, E);

                    if st[1] != 0 {
                        return -1;
                    }
                }
                p = json_string(out, p, kb[0..kn]);
                p = app(out, p, ksep, 0, ksep.len);
                let val = A[pool(A, st) + vvs(A, st, id) + i];
                p = json_into(val, lvl + 1, indent, isep, ksep, A, B, F, st, out, p, E);

                if st[1] != 0 {
                    return -1;
                }

                if i < n - 1 {
                    p = app(out, p, isep, 0, isep.len);
                }

                if indent >= 0 {
                    p = appc(out, p, 10);
                }
                i = i + 1;
            }

            if indent > 0 {
                p = spaces_to(out, p, lvl * indent);
            }
        }
        return appc(out, p, '}');
    }
    return apps(out, at, "null");
}
// ---- mutable value builder -------------------------------------------------
// A[0] capacity, A[1] initial node count, A[2] initial pool use.
// st[0] node count, st[3] string cursor, st[4] pool cursor, st[10] capacity.

fn reset_io(A: const i64[:], st: i64[:], blen: i64) -> i64 {
    st[10] = A[0];
    st[0] = A[1];
    st[4] = A[2];
    st[3] = blen;
    st[1] = 0;
    st[2] = 0;
    bases(st);
    return 0;
}

fn vnew(A: i64[:], F: f64[:], st: i64[:], kind: i64) -> i64 {
    let id = st[0];
    st[0] = id + 1;
    A[st[16] + id] = kind;
    A[st[17] + id] = 0;
    A[st[18] + id] = 0;
    A[st[19] + id] = 0;
    A[st[20] + id] = 0;
    A[st[21] + id] = 0;
    A[st[22] + id] = 0;
    A[st[23] + id] = 0;
    A[st[24] + id] = 0;
    A[st[25] + id] = 0;
    F[id] = 0.0;
    return id;
}

fn mk_int(A: i64[:], F: f64[:], st: i64[:], v: i64) -> i64 {
    let id = vnew(A, F, st, V_INT);
    A[st[17] + id] = v;
    var df: f64 = v as f64;

    if (df as i64) != v {
        if v < 0 {
            df = 0.0 - 1.0 / 0.0;
        } else {
            df = 1.0 / 0.0;
        }
    }
    F[id] = df;
    return id;
}

fn mk_float(A: i64[:], F: f64[:], st: i64[:], v: f64) -> i64 {
    let id = vnew(A, F, st, V_FLOAT);
    F[id] = v;

    if !is_nan(v) && !is_inf(v) {
        A[st[17] + id] = v as i64;
    }
    return id;
}

fn mk_str(A: i64[:], F: f64[:], B: u8[:], st: i64[:], s: const u8[:]) -> i64 {
    let id = vnew(A, F, st, V_STRING);
    let off = st[3];
    var i: i64 = 0;

    while i < s.len {
        B[st[3] + i] = s[i];
        i = i + 1;
    }
    st[3] = st[3] + s.len;
    A[st[18] + id] = off;
    A[st[19] + id] = s.len;
    return id;
}

fn mk_bool(A: i64[:], F: f64[:], st: i64[:], v: i64) -> i64 {
    let id = vnew(A, F, st, V_BOOL);
    A[st[17] + id] = v;
    F[id] = v as f64;
    return id;
}

fn mk_none(A: i64[:], F: f64[:], st: i64[:]) -> i64 {
    return vnew(A, F, st, V_NONE);
}

fn mk_undef(A: i64[:], F: f64[:], st: i64[:]) -> i64 {
    return vnew(A, F, st, V_UNDEF);
}

fn arr_new(A: i64[:], F: f64[:], st: i64[:]) -> i64 {
    return vnew(A, F, st, V_ARRAY);
}

fn arr_push(A: i64[:], st: i64[:], id: i64, child: i64) -> i64 {
    let c = st[21] + id;

    if A[c] == 0 {
        A[st[20] + id] = st[4];
    }
    A[st[26] + st[4]] = child;
    st[4] = st[4] + 1;
    A[c] = A[c] + 1;
    return 0;
}
// ---- func_args helpers -----------------------------------------------------

fn find_kw(
    key: const u8[:],
    kwc: i64,
    kwoff: const i64[:],
    kwlen: const i64[:],
    kwroots: const i64[:],
    B: const u8[:]) -> i64 {
    var i: i64 = 0;

    while i < kwc {
        let o = kwoff[i];
        let l = kwlen[i];

        if l == key.len {
            var same: bool = true;
            var k: i64 = 0;

            while k < l {
                if B[o + k] != key[k] {
                    same = false;
                    k = l;
                } else {
                    k = k + 1;
                }
            }

            if same {
                return kwroots[i];
            }
        }
        i = i + 1;
    }
    return -1;
}

fn err_count(E: u8[:], st: i64[:], name: const u8[:], min: i64, max: i64, got: i64) -> i64 {
    var p = apps(E, 0, "Function '");
    p = app(E, p, name, 0, name.len);
    p = apps(E, p, "' expected between ");
    p = appi(E, p, min);
    p = apps(E, p, " and ");
    p = appi(E, p, max);
    p = apps(E, p, " arguments, got ");
    p = appi(E, p, got);
    st[1] = 1;
    st[2] = p;
    return -1;
}

fn err_pos(E: u8[:], st: i64[:], name: const u8[:], want: i64, got: i64) -> i64 {
    var p = apps(E, 0, "Function '");
    p = app(E, p, name, 0, name.len);
    p = apps(E, p, "' expected at least ");
    p = appi(E, p, want);
    p = apps(E, p, " arguments, got ");
    p = appi(E, p, got);
    st[1] = 1;
    st[2] = p;
    return -1;
}

fn err_type(
    E: u8[:],
    st: i64[:],
    name: const u8[:],
    mangled: const u8[:],
    v: i64,
    A: const i64[:],
    B: const u8[:],
    st2: i64[:]) -> i64 {
    var p = apps(E, 0, "Function '");
    p = app(E, p, name, 0, name.len);
    p = apps(E, p, "' expected value of type ");
    p = app(E, p, mangled, 0, mangled.len);
    p = apps(E, p, ", got ");
    p = type_name(A, B, st2, v, E[p ..]) + p;
    st[1] = 1;
    st[2] = p;
    return -1;
}

fn err_notimpl(E: u8[:], st: i64[:], msg: const u8[:]) -> i64 {
    var p = apps(E, 0, "NotImplemented: ");
    p = app(E, p, msg, 0, msg.len);
    st[1] = 1;
    st[2] = p;
    return -1;
}

fn pos_of(argc: i64, roots: const i64[:], i: i64, name: const u8[:], E: u8[:], st: i64[:]) -> i64 {
    if i < argc {
        return roots[i];
    }
    return err_pos(E, st, name, i + 1, argc);
}

fn pos_def(argc: i64, roots: const i64[:], i: i64, def: i64) -> i64 {
    if i < argc {
        return roots[i];
    }
    return def;
}

fn kw_or_pos(
    key: const u8[:],
    pos: i64,
    argc: i64,
    roots: const i64[:],
    kwc: i64,
    kwoff: const i64[:],
    kwlen: const i64[:],
    kwroots: const i64[:],
    B: const u8[:],
    A: i64[:],
    F: f64[:],
    st: i64[:]) -> i64 {
    let v = find_kw(key, kwc, kwoff, kwlen, kwroots, B);

    if v >= 0 {
        return v;
    }

    if pos < argc {
        return roots[pos];
    }
    return mk_undef(A, F, st);
}
// ---- ensure_ascii ----------------------------------------------------------

fn cp_escape(out: u8[:], at: i64, cp: i64) -> i64 {
    let d: const u8[:] = "0123456789abcdef";
    var p = at;

    if cp <= 0xFFFF {
        p = apps(out, p, "\\u");
        p = appc(out, p, d[ (cp / 4096) % 16]);
        p = appc(out, p, d[ (cp / 256) % 16]);
        p = appc(out, p, d[ (cp / 16) % 16]);
        return appc(out, p, d[cp % 16]);
    }
    let c = cp - 0x10000;
    let hi = 0xD800 + ( (c / 1024) % 1024);
    let lo = 0xDC00 + (c % 1024);
    p = apps(out, p, "\\u");
    p = appc(out, p, d[ (hi / 4096) % 16]);
    p = appc(out, p, d[ (hi / 256) % 16]);
    p = appc(out, p, d[ (hi / 16) % 16]);
    p = appc(out, p, d[hi % 16]);
    p = apps(out, p, "\\u");
    p = appc(out, p, d[ (lo / 4096) % 16]);
    p = appc(out, p, d[ (lo / 256) % 16]);
    p = appc(out, p, d[ (lo / 16) % 16]);
    return appc(out, p, d[lo % 16]);
}
// 0 ok, 1 invalid; returns codepoint and bytes

fn dec_utf8(s: const u8[:], i: i64) -> i64, i64 {
    let b0 = s[i];

    if b0 < 128 {
        return b0 as i64, 1;
    }

    if b0 < 194 {
        return 0, 0;
    }

    if b0 < 224 {
        if i + 1 >= s.len {
            return 0, 0;
        }

        if (s[i + 1] & 192) != 128 {
            return 0, 0;
        }
        return ( (b0 as i64) - 192) * 64 + ( (s[i + 1] as i64) - 128), 2;
    }

    if b0 < 240 {
        if i + 2 >= s.len {
            return 0, 0;
        }

        if (s[i + 1] & 192) != 128 || (s[i + 2] & 192) != 128 {
            return 0, 0;
        }
        return ( (b0 as i64) - 224) * 4096 + ( ( (s[i + 1] as i64) - 128) * 64) + ( (s[i + 2] as i64) - 128), 3;
    }

    if b0 < 245 {
        if i + 3 >= s.len {
            return 0, 0;
        }

        if (s[i + 1] & 192) != 128 || (s[i + 2] & 192) != 128 || (s[i + 3] & 192) != 128 {
            return 0, 0;
        }
        return ( (b0 as i64) - 240) * 262144 + ( ( (s[i + 1] as i64) - 128) * 4096) + ( ( (s[i + 2] as i64) - 128) * 64) + ( (s[i + 3] as i64) - 128), 4;
    }
    return 0, 0;
}

fn ensure_ascii_into(s: const u8[:], out: u8[:]) -> i64 {
    var p: i64 = 0;
    var i: i64 = 0;
    var in_string: bool = false;
    var escaped: bool = false;

    while i < s.len {
        let c = s[i];

        if !in_string {
            p = appc(out, p, c);

            if c == '"' {
                in_string = true;
            }
            i = i + 1;
        } else

        if escaped {
            p = appc(out, p, c);
            escaped = false;
            i = i + 1;
        } else

        if c == 92 {
            p = appc(out, p, c);
            escaped = true;
            i = i + 1;
        } else

        if c == '"' {
            p = appc(out, p, c);
            in_string = false;
            i = i + 1;
        } else

        if c < 128 {
            p = appc(out, p, c);
            i = i + 1;
        } else {
            let cp, nb = dec_utf8(s, i);

            if nb == 0 {
                p = apps(out, p, "\\ufffd");
                i = i + 1;
            } else {
                p = cp_escape(out, p, cp);
                i = i + nb;
            }
        }
    }
    return p;
}
// ---- tojson ----------------------------------------------------------------

fn h_tojson(
    argc: i64,
    roots: const i64[:],
    kwc: i64,
    kwoff: const i64[:],
    kwlen: const i64[:],
    kwroots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 1 || argc > 5 {
        return err_count(E, st, name, 1, 5, argc);
    }
    let ensure_ascii = kw_or_pos("ensure_ascii", 1, argc, roots, kwc, kwoff, kwlen, kwroots, B, A, F, st);
    let indent_v = kw_or_pos("indent", 2, argc, roots, kwc, kwoff, kwlen, kwroots, B, A, F, st);
    let sep_v = kw_or_pos("separators", 3, argc, roots, kwc, kwoff, kwlen, kwroots, B, A, F, st);
    let sort_v = kw_or_pos("sort_keys", 4, argc, roots, kwc, kwoff, kwlen, kwroots, B, A, F, st);
    var indent: i64 = -1;

    if vk(A, st, indent_v) == V_INT {
        indent = vi(A, st, indent_v);
    }

    if v_bool(A, F, st, sort_v) != 0 {
        return err_notimpl(E, st, "tojson sort_keys=true not implemented");
