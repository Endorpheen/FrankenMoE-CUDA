        let n2 = ensure_ascii_into(tmp[0..n], tmp2);
        return mk_str(A, F, B, st, tmp2[0..n2]);
    }
    return mk_str(A, F, B, st, tmp[0..n]);
}
// ---- dispatch --------------------------------------------------------------

fn h_default(
    argc: i64,
    roots: const i64[:],
    kwc: i64,
    kwoff: const i64[:],
    kwlen: const i64[:],
    kwroots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 2 || argc > 3 {
        return err_count(E, st, name, 2, 3, argc);
    }
    let v0 = roots[0];
    let cv = kw_or_pos("boolean", 2, argc, roots, kwc, kwoff, kwlen, kwroots, B, A, F, st);
    let check = v_bool(A, F, st, cv) != 0;
    var noval: bool = false;

    if check {
        if v_bool(A, F, st, v0) == 0 {
            noval = true;
        }
    } else {
        if vk(A, st, v0) == V_UNDEF || vk(A, st, v0) == V_NONE {
            noval = true;
        }
    }

    if noval {
        return roots[1];
    }
    return v0;
}

fn h_abs_int(
    argc: i64,
    roots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: const u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 1 {
        return err_count(E, st, name, 1, 999, argc);
    }

    if vk(A, st, roots[0]) != V_INT {
        return err_type(E, st, name, "St10shared_ptrIN5jinja11value_int_tEE", roots[0], A, B, st);
    }
    let v = vi(A, st, roots[0]);

    if v < 0 {
        return mk_int(A, F, st, 0 - v);
    }
    return mk_int(A, F, st, v);
}

fn h_int_int(
    argc: i64,
    roots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: const u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 1 {
        return err_count(E, st, name, 1, 999, argc);
    }

    if vk(A, st, roots[0]) != V_INT {
        return err_type(E, st, name, "St10shared_ptrIN5jinja11value_int_tEE", roots[0], A, B, st);
    }
    return mk_int(A, F, st, vi(A, st, roots[0]));
}

fn h_float_int(
    argc: i64,
    roots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: const u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 1 {
        return err_count(E, st, name, 1, 999, argc);
    }

    if vk(A, st, roots[0]) != V_INT {
        return err_type(E, st, name, "St10shared_ptrIN5jinja11value_int_tEE", roots[0], A, B, st);
    }
    return mk_float(A, F, st, F[roots[0]]);
}

fn h_abs_float(
    argc: i64,
    roots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: const u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 1 {
        return err_count(E, st, name, 1, 999, argc);
    }

    if vk(A, st, roots[0]) != V_FLOAT {
        return err_type(E, st, name, "St10shared_ptrIN5jinja13value_float_tEE", roots[0], A, B, st);
    }
    let v = F[roots[0]];

    if v < 0.0 {
        return mk_float(A, F, st, 0.0 - v);
    }
    return mk_float(A, F, st, v);
}

fn h_int_float(
    argc: i64,
    roots: const i64[:],
    name: const u8[:],
    A: i64[:],
    F: f64[:],
    B: const u8[:],
    E: u8[:],
    st: i64[:]) -> i64 {
    if argc < 1 {
        return err_count(E, st, name, 1, 999, argc);
    }

    if vk(A, st, roots[0]) != V_FLOAT {
        return err_type(E, st, name, "St10shared_ptrIN5jinja13value_float_tEE", roots[0], A, B, st);
    }
    return mk_int(A, F, st, F[roots[0]] as i64);
}

