--- a/cuda-driver.c
+++ b/cuda-driver.c
@@ -3,0 +4 @@
+#include "moe-epilogue-image.h"
@@ -300,0 +302 @@
+    Function moe_prefill_epilogue;
@@ -1525,0 +1528,10 @@
+        const char * moe_epilogue = getenv("GOOSE_MOE_PREFILL_EPILOGUE");
+        if (error == 0 && major == 8 && (!moe_epilogue || strcmp(moe_epilogue, "0") != 0) &&
+            cuda.device_attribute(&minor, compute_capability_minor, device) == 0 && minor == 9) {
+            Module image = NULL;
+            Function kernel = NULL;
+            if (cuda.module_load(&image, moe_epilogue_image) == 0 &&
+                cuda.function_get(&kernel, image, "goose_moe_shared_residual_prefill") == 0)
+                cuda.moe_prefill_epilogue = kernel;
+        }
+
@@ -5223,0 +5236,39 @@
+}
+
+uint8_t fg_cuda_moe_epilogue_enabled(void) {
+    return cuda.moe_prefill_epilogue && activations.active && activations.defer_waits;
+}
+
+int64_t fg_cuda_moe_epilogue(uint64_t routed, uint64_t shared, uint64_t gate, uint64_t residual,
+                            uint64_t output, int64_t rows, int64_t step, int64_t deadline) {
+    if (!fg_cuda_moe_epilogue_enabled() || rows < 2 || rows > 4096) return 0;
+    const int64_t bytes = rows * 8192, gate_bytes = rows * 4;
+    if (!activation_device(routed, bytes) || !activation_device(shared, bytes) ||
+        !activation_device(gate, gate_bytes) || !activation_device(residual, bytes)) return 0;
+    if (!activations.retire || !activations.reuse) return 0;
+    const int64_t slot = fg143_activation_overlap(activation_ranges(), routed, bytes, 0);
+    if (slot < 0) return 0;
+    int64_t * record = activations.ranges + (size_t) slot * ACTIVATION_WORDS;
+    if ((uint64_t) record[0] != routed || record[1] != bytes || record[4] != step + 1) return 0;
+    if (fg_cuda_activation_prepare(output, bytes, true, true, step, deadline) != 0) return -1;
+    if ((uint64_t) record[0] != routed || record[1] != bytes) return 0;
+    const DevicePtr r = activation_device(routed, bytes), s = activation_device(shared, bytes),
+                    g = activation_device(gate, gate_bytes), x = activation_device(residual, bytes);
+    if (!r || !s || !g || !x || (r | s | x) % 16 != 0) return 0;
+    if ((r <= s ? s - r < (uint64_t) bytes : r - s < (uint64_t) bytes) ||
+        (r <= x ? x - r < (uint64_t) bytes : r - x < (uint64_t) bytes) ||
+        (r <= g ? g - r < (uint64_t) bytes : r - g < (uint64_t) gate_bytes)) return 0;
+    if (start_context() != 1) return -1;
+    const uint32_t vectors = (uint32_t) rows * 512;
+    DevicePtr dst = r;
+    void * args[] = {(void *) &r, (void *) &s, (void *) &g, (void *) &x, &dst, (void *) &vectors};
+    activations.pending = true;
+    const int error = cuda.launch(cuda.moe_prefill_epilogue, (vectors + 127) / 128, 1, 1, 128, 1, 1, 0, NULL, args, NULL);
+    if (finish_context() != 0 || error != 0) return -1;
+    record[0] = (int64_t) output;
+    record[3] = 0;
+    record[4] = deadline;
+    static _Thread_local uint64_t fused;
+    if (++fused == 1 || fused % 40 == 0)
+        fprintf(stderr, "Goose CUDA: fused prefill MoE epilogues=%" PRIu64 "\n", fused);
+    return 1;
