+struct inkling_decode_graph {
+    struct ggml_context *context;
+    struct fg_standalone_graph_plan *plan;
+    struct ggml_tensor *output, *inputs[3], *messages[3], *residual;
+    struct inkling_attention_graph_call attention;
+};
+
@@ -161,0 +169,2 @@
