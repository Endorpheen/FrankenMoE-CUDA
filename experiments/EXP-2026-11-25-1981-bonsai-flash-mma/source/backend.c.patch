+    float scale = 1.0f / 16.0f;
+    return launch(m, PAD_QUERY, count * 32, 1, 1, 256, (void *[]){&query, &m->flash_query}) ||
+           launch(m, FLASH_STAGE, (unsigned)padded, 4, 1, 128, (void *[]){&key, &key_half, &keys, &padded, &row, &head}) ||
+           launch(m, FLASH_STAGE, (unsigned)padded, 4, 1, 128, (void *[]){&value, &value_half, &keys, &padded, &row, &head}) ||
+           check(cuLaunchKernel(m->kernel[FLASH_MMA], (count+7)/8, 4, 1, 128, 1, 1, 33792, NULL,
+               (void *[]){&m->flash_query, &key_half, &value_half, &m->flash_out, &m->flash_config, &scale}, NULL), "Flash MMA") ||
+           launch(m, UNPAD_ATTN, count * 24, 1, 1, 256, (void *[]){&m->flash_out, &output});
+}
