+export fn i2_q8_pair1(weights: u64, input0: u64, output0: u64, pairs: i64,
+    lane: u64) {
+    var accum0: f32 = 0.0;
+    for pair in pairs {
+        let address = weights + (pair as u64) * 68;
+        let position = (pair as u64) * 256 + lane * 4;
+        let first = load_half(address) * (load_signed_byte(address + 2 + lane) as f32);
+        let second = load_half(address + 34) * (load_signed_byte(address + 36 + lane) as f32);
+        accum0 = multiply_add(first, load(input0 + position), accum0);
+        accum0 = multiply_add(second, load(input0 + position + 128), accum0);
+    }
+    accum0 = reduce_lane(accum0);
+    if lane == 0 {
+        store(output0, accum0);
+    }
+}
