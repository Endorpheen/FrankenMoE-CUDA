+int64_t fg_i2_warm_tick(void) {
+    struct timespec ts;
+    if (!i2_warm.measure || clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) != 0) return 0;
+    return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
