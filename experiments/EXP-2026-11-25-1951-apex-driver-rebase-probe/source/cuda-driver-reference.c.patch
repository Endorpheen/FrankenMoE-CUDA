+static void i2_warm_phase(bool prefill, int position, int count) {
+    static int enabled = -1;
+    if (enabled < 0) enabled = fg_standalone_option_enabled("I2_WARM_ROUTE_REUSE");
+    if (!enabled) return;
+
+    if (prefill && position == 0) {
+        i2_warm.count = count;
+        i2_warm.step = 0;
+        i2_warm.track = true;
+        i2_warm.reuse = i2_warm.previous_count == count;
+        i2_warm.buckets = fg_standalone_option_enabled("I2_WARM_ROUTE_BUCKETS");
+        i2_warm.measure = getenv("I2_WARM_ROUTE_LOG") != NULL;
+        i2_warm.policy_ns = 0;
+        if (i2_warm.reuse && i2_warm.buckets) {
+            static pthread_once_t bucket_init = PTHREAD_ONCE_INIT;
+            pthread_once(&bucket_init, init_inkling_buckets);
+            const int64_t start = fg_i2_warm_tick();
+            for (int i = 0; i < i2_prior_cap; ++i) {
+                const uint64_t remaining = i2_warm.last[i];
+                i2_warm.rank[i] = remaining ? i2_warm_visits - __builtin_ctzll(remaining) : 0;
+            }
+            fg_i2_warm_spent(start);
+        }
+        memset(i2_warm.recorded, 0, sizeof(i2_warm.recorded));
+        return;
+    }
+    if (!i2_warm.track) return;
+    if (!prefill && i2_warm.measure)
+        fprintf(stderr, "I2 warm policy mode=%s cpu_ns=%" PRIu64 "\n",
+                i2_warm.buckets ? "bucket" : "sort", i2_warm.policy_ns);
+    if (!prefill && i2_warm.step == i2_warm_visits) {
+        memcpy(i2_warm.last, i2_warm.recorded, sizeof(i2_warm.last));
+        memcpy(i2_warm.last_sequence, i2_warm.sequence, sizeof(i2_warm.sequence));
+        i2_warm.previous_count = i2_warm.count;
+    } else {
+        i2_warm.previous_count = 0;
+    }
+    i2_warm.track = false;
+    i2_warm.reuse = false;
+}
