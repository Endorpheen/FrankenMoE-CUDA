+// Called under cuda_lock. One observation per gate/up projection.
+static void i2_warm_visit(uint64_t tensor, sl_i64 active) {
+    struct expert_cache *cache = &cuda.experts;
+    if (!i2_warm.track || active.len != i2_prior_experts ||
+        cache->groups.len != 9 || cache->layers.len != 4 * i2_prior_layers) return;
+    for (int layer = 0; layer < i2_prior_layers; ++layer) {
+        if ((uint64_t)cache->layers.data[4 * layer + 1] != tensor) continue;
+        if (i2_warm.step >= i2_warm_visits) {
+            i2_warm.track = false;
+            i2_warm.reuse = false;
+            i2_warm.previous_count = 0;
+            return;
+        }
+        const int step = i2_warm.step++;
+        i2_warm.sequence[step] = layer;
+        if (i2_warm.reuse && i2_warm.last_sequence[step] != layer) i2_warm.reuse = false;
+        if (i2_warm.reuse && i2_warm.buckets) {
+            const int64_t begin = fg_i2_warm_tick();
+            const int base = layer * i2_prior_experts;
+            const uint64_t bit = UINT64_C(1) << step;
+            for (int e = 0; e < i2_prior_experts; ++e) {
+                const uint64_t old = i2_warm.last[base + e];
+                if (old & bit) {
+                    const uint64_t remaining = old >> (step + 1);
+                    i2_warm.rank[base + e] = remaining ?
+                        i2_warm_visits - step - 1 - __builtin_ctzll(remaining) : 0;
+                }
+            }
+            fg_i2_warm_spent(begin);
+        } else if (i2_warm.reuse) {
+            const int64_t begin = fg_i2_warm_tick();
+            int64_t score[i2_prior_cap], visits[i2_prior_layers];
+            for (int i = 0; i < i2_prior_layers; ++i) visits[i] = 1;
+            for (int i = 0; i < i2_prior_cap; ++i) {
+                const uint64_t remaining = i2_warm.last[i] >> step;
