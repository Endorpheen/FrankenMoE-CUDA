+static void i2_apply_prior(int64_t *frequency, int64_t *visits) {
+    struct expert_cache * cache = &cuda.experts;
+    if (cache->groups.len == 9 && cache->layers.len == 4 * i2_prior_layers && cache->state) {
+        const int64_t *g = cache->groups.data;
+        const int64_t slots = g[5];
+        const int64_t scalar = g[8] + g[3];
+        if (g[3] == i2_prior_experts && slots >= 2 && slots <= i2_prior_cap && scalar + 1 < cache->work.len) {
+            static pthread_once_t prior_init_once = PTHREAD_ONCE_INIT;
+            pthread_once(&prior_init_once, init_inkling_prior);
+            int64_t entries[i2_prior_cap], scratch[i2_prior_cap];
+            const uint64_t keys = (uint64_t)(uintptr_t)(cache->state + g[7]);
+            const uint64_t stride = 4 * slots;
+            const uint64_t head = keys + 4 * stride;
+            (void)i2_slru_prefill_prior(keys, keys + stride, keys + 2 * stride, keys + 3 * stride, head, head + 8,
+                (sl_i64){frequency, i2_prior_cap}, (sl_i64){visits, i2_prior_layers},
+                (sl_i64){entries, slots}, (sl_i64){scratch, slots},
+                (sl_i64){cache->work.data + scalar + 1, 1}, i2_prior_experts);
+        }
+    }
+}
