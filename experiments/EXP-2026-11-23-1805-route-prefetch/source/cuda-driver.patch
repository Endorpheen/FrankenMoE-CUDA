+static int pf_layer(uint64_t up) {
+    for (int i = 0; i < pf.layers; ++i) if (pf.layer_up[i] == up) return i;
+    if (pf.layers == PF_LAYERS) return -1;
+    pf.layer_up[pf.layers] = up;
+    return pf.layers++;
