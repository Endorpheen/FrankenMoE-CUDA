+static _Thread_local struct {
+    uint64_t host;
+    DevicePtr device;
+    uint32_t sequence;
+    uint64_t reads, hits, timeouts, verified, forced;
+} inkling_route_mail;
+
+static int read_inkling_route_mail(int64_t *range, DevicePtr device) {
+    if (!inkling_route_mail.sequence || range[1] != 32 ||
+        (uint64_t)range[0] != inkling_route_mail.host || device != inkling_route_mail.device) return 0;
+    const uint32_t sequence = inkling_route_mail.sequence;
+    inkling_route_mail.sequence = 0;
+    if (decode_capture_submit() != 0) return -1;
+    ++inkling_route_mail.reads;
+    const char *diagnostic = getenv("I2_VERIFY_ROUTE_MAILBOX");
+    const bool verify = diagnostic && strcmp(diagnostic, "1") == 0;
+    const bool force = verify && inkling_route_mail.reads % 257 == 0;
+    bool ready = false;
+    if (!force) {
+        for (unsigned spin = 0; spin < 4096; ++spin) {
+            if (__atomic_load_n(cuda.inkling_mailbox_host + 8, __ATOMIC_ACQUIRE) == sequence) {
+                memcpy((void *)(uintptr_t)range[0], cuda.inkling_mailbox_host, 32);
+                ready = true;
+                break;
+            }
+#if defined(__x86_64__) || defined(__i386__)
+            __builtin_ia32_pause();
+#endif
+        }
+    }
+    if (ready && verify) {
+        uint32_t expected[8];
+        if (cuda.download(expected, device, sizeof expected) != 0 ||
+            memcmp(expected, (const void *)(uintptr_t)range[0], sizeof expected) != 0) {
+            fputs("Inkling route mailbox verification mismatch\n", stderr);
+            return -1;
+        }
+        ++inkling_route_mail.verified;
+    }
+    inkling_route_mail.hits += ready;
+    inkling_route_mail.forced += force;
+    inkling_route_mail.timeouts += !ready && !force;
+    if ((verify || getenv("I2_ROUTE_MAILBOX_LOG")) &&
+        (inkling_route_mail.reads == 1 || inkling_route_mail.reads % 1000 == 0)) {
+        fprintf(stderr, "I2 route mailbox reads=%" PRIu64 " hits=%" PRIu64
+            " timeout=%" PRIu64 " verified=%" PRIu64 " forced=%" PRIu64 "\n",
+            inkling_route_mail.reads, inkling_route_mail.hits, inkling_route_mail.timeouts,
+            inkling_route_mail.verified, inkling_route_mail.forced);
+    }
+    return ready ? 1 : 0;
+}
