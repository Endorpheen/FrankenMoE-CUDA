+static bool inkling_mailbox_ready(void) {
+    if (cuda.inkling_mailbox_attempted) return cuda.inkling_mailbox_host != NULL;
+    cuda.inkling_mailbox_attempted = true;
+    int (*host_device)(DevicePtr *, void *, unsigned) =
+        (int (*)(DevicePtr *, void *, unsigned))dlsym(cuda.library, "cuMemHostGetDevicePointer_v2");
+    if (!host_device || !cuda.host_alloc || !cuda.host_free) return false;
+    Module module = NULL;
+    int error = cuda.module_load(&module, route_mailbox_cubin);
+    if (!error) error = cuda.function_get(&cuda.inkling_mailbox, module, "goose_i2_route_mailbox");
+    void *host = NULL;
+    if (!error) error = cuda.host_alloc(&host, 64, 2);
+    if (!error) error = host_device(&cuda.inkling_mailbox_device, host, 0);
+    if (error) {
+        if (host) cuda.host_free(host);
+        return false;
+    }
+    memset(host, 0, 64);
+    cuda.inkling_mailbox_host = host;
+    return true;
+}
