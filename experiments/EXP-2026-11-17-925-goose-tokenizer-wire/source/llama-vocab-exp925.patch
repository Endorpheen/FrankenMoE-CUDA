+void llama_vocab::impl::goose_prepare() {
+    if (goose_ready) {
+        return;
+    }
+    static bool init_done = false;
+    if (!init_done) {
+        fg920_goose_init(0, nullptr);
+        init_done = true;
+    }
+    const size_t n = id_to_token.size();
+    goose_off.assign(n, 0);
+    goose_len.assign(n, 0);
+    goose_attr.assign(n, 0);
+    goose_blob.clear();
+    goose_blob.reserve(cache_token_to_piece.empty() ? 0 : 0);
+    for (size_t i = 0; i < n; ++i) {
+        const std::string & text = id_to_token[i].text;
+        goose_off[i] = (int64_t) goose_blob.size();
+        goose_len[i] = (int64_t) text.size();
+        goose_blob += text;
+        const uint8_t a = (uint8_t) id_to_token[i].attr;
+        goose_attr[i] = (int64_t) a;
+    }
+    size_t slots = 1;
+    while (slots < 2 * n) {
+        slots <<= 1;
+    }
+    goose_slots.assign(slots, 0);
+    int64_t stats[4] = {0, 0, 0, 0};
+    gsl_i64 empty{nullptr, 0};
+    const int64_t rc = bt_build(
+        gsl_u8{ (uint8_t *) goose_blob.data(), (int64_t) goose_blob.size() },
+        gsl_i64{ goose_off.data(), (int64_t) n },
+        gsl_i64{ goose_len.data(), (int64_t) n },
+        gsl_i64{ goose_slots.data(), (int64_t) goose_slots.size() },
+        empty, empty,
+        gsl_i64{ goose_mrg_slots.data(), (int64_t) goose_mrg_slots.size() },
+        gsl_i64{ stats, 4 });
+    goose_ready = (rc == 0);
