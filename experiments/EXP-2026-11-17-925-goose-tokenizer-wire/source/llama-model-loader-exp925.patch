 #include "llama-model-loader.h"
+// EXP925: the Goose GGUF reader (EXP919) answers the loader's tensor lookup.
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <map>
+#include <mutex>
+
+struct gsl_u8x  { uint8_t * data; int64_t len; };
+struct gsl_i64x { int64_t * data; int64_t len; };
+extern "C" void    fg919_goose_init(int argc, char ** argv);
+extern "C" int64_t gr_parse(gsl_u8x data, int64_t file_bytes, gsl_i64x state, gsl_i64x kv, gsl_i64x tensors,
+                            gsl_i64x kv_slots, gsl_i64x tensor_slots);
+extern "C" int64_t gr_find_tensor(gsl_u8x data, gsl_i64x state, gsl_i64x tensors, gsl_i64x slots, gsl_u8x key);
+
+struct goose_meta {
+    void * hdr = nullptr;
+    int64_t len = 0;
+    int64_t fd = -1;
+    std::vector<int64_t> state, kv, tens, kvsl, tensl;
+    bool ok = false;
+    ~goose_meta() { if (hdr && hdr != MAP_FAILED) munmap(hdr, (size_t) len); if (fd >= 0) close(fd); }
+};
+
+static std::mutex g_goose_mu;
+static std::map<const void *, std::unique_ptr<goose_meta>> g_goose_metas;
+
+static void goose_register(const struct gguf_context * ctx, const char * path) {
+    static bool inited = false;
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    if (!inited) { fg919_goose_init(0, nullptr); inited = true; }
+    auto m = std::make_unique<goose_meta>();
+    struct stat st{};
+    m->fd = open(path, O_RDONLY);
+    if (m->fd >= 0 && fstat(m->fd, &st) == 0) {
+        m->len = st.st_size < 67108864 ? (int64_t) st.st_size : 67108864;
+        m->hdr = mmap(nullptr, (size_t) m->len, PROT_READ, MAP_PRIVATE, m->fd, 0);
+        if (m->hdr != MAP_FAILED) {
+            m->state.assign(8, 0); m->kv.assign(256 * 8, 0); m->tens.assign(2048 * 12, 0);
+            m->kvsl.assign(512, 0); m->tensl.assign(8192, 0);
+            m->ok = gr_parse(gsl_u8x{ (uint8_t *) m->hdr, m->len }, st.st_size,
+                             gsl_i64x{ m->state.data(), 8 }, gsl_i64x{ m->kv.data(), (int64_t) m->kv.size() },
+                             gsl_i64x{ m->tens.data(), (int64_t) m->tens.size() },
+                             gsl_i64x{ m->kvsl.data(), (int64_t) m->kvsl.size() },
+                             gsl_i64x{ m->tensl.data(), (int64_t) m->tensl.size() }) == 0;
+        }
+    }
+    LLAMA_LOG_INFO("%s: ctx=%p ok=%d\n", __func__, (const void *) ctx, m->ok ? 1 : 0);
+    g_goose_metas[ctx] = std::move(m);
+}
+
+int64_t llama_goose_tensor_index(const struct gguf_context * ctx, const char * name) {
+    std::lock_guard<std::mutex> lock(g_goose_mu);
+    auto it = g_goose_metas.find(ctx);
+    if (it == g_goose_metas.end() || !it->second->ok) {
+        return -1;
+    }
+    goose_meta & m = *it->second;
+    if (getenv("EXP925_MUTATE_LOOKUP")) { return -1; }
+    return gr_find_tensor(gsl_u8x{ (uint8_t *) m.hdr, m.len }, gsl_i64x{ m.state.data(), 8 },
+                          gsl_i64x{ m.tens.data(), (int64_t) m.tens.size() },
+                          gsl_i64x{ m.tensl.data(), (int64_t) m.tensl.size() },
+                          gsl_u8x{ (uint8_t *) name, (int64_t) std::strlen(name) });
+}
